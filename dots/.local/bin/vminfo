#!/usr/bin/env python3
"""vminfo - Live system performance dashboard.

Shows memory, CPU, swap, pressure, and process data in a responsive,
continuously updating TUI that adapts to terminal size.

Keys:
  m      Freeze the process snapshot and enter/leave manager mode
  1-4    Switch process view (RSS / CPU / Swap / Total)
  +/-    Show more / fewer processes
  v      Cycle All / User / System processes
  f      Force-swap (evict) selected PIDs/names into swap
  u      Unswap (fault back) selected PIDs/names into RAM
  k      Send an explicit signal to selected PIDs
  r      Run ZRAM recompression
  w      Run guarded ZRAM writeback
  Space  Pause
  q      Quit

Manager keys:
  Up/Down, j/k  Move; PgUp/PgDn, Home/End jump
  Space         Tick/untick a process
  a / c         Select all matching processes / clear selection
  b             Select only the currently visible rows
  /             Search by PID, user, UID, name, or command line
  i             Inspect the cursor process
  f / u / x     Force-swap / unswap / signal checked processes
  m / Esc       Leave manager and restore the prior pause state
"""
import sys
import os
import re
import time
import select
import subprocess
import signal
import shutil
import unicodedata
import fcntl
import fnmatch
import pwd
import shlex

def keyboard_input(prompt=''):
    """Read a keyboard line, excluding terminal events and bracketed paste."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return input(prompt)
    import termios
    import tty
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    line, pending, pasting = [], b'', False
    try:
        tty.setcbreak(fd)
        termios.tcflush(fd, termios.TCIFLUSH)
        sys.stdout.write(MOUSE_INPUT_ON + prompt)
        sys.stdout.flush()
        while True:
            chunk = os.read(fd, 4096)
            if not chunk:
                raise EOFError
            keys, pending, pasting = parse_terminal_input(pending + chunk, pasting, text=True)
            for key in keys:
                if key in ('\r', '\n'):
                    sys.stdout.write('\n')
                    return ''.join(line)
                if key == '\x03':
                    raise KeyboardInterrupt
                if key == '\x04' and not line:
                    raise EOFError
                if key in ('\x7f', '\b'):
                    if line:
                        line.pop()
                        sys.stdout.write('\b \b')
                elif key == '\x15':
                    sys.stdout.write('\b \b' * len(line))
                    line.clear()
                elif len(key) == 1 and key.isprintable():
                    line.append(key)
                    sys.stdout.write(key)
                sys.stdout.flush()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        sys.stdout.write(MOUSE_INPUT_ON if _dashboard_terminal_active else MOUSE_INPUT_OFF)
        sys.stdout.flush()


_dashboard_terminal_active = False


# ── ANSI Escape Codes ──────────────────────────────────────────────────
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
ITALIC = "\033[3m"
ERASE_EOL = "\033[K"
ERASE_BELOW = "\033[J"

RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
GRAY = "\033[90m"
WHITE = "\033[37m"

BRED = "\033[91m"
BGREEN = "\033[92m"
BYELLOW = "\033[93m"
BBLUE = "\033[94m"
BMAGENTA = "\033[95m"
BCYAN = "\033[96m"
BWHITE = "\033[97m"


# ── System constants ───────────────────────────────────────────────────
_CLK_TCK = os.sysconf('SC_CLK_TCK')
_ZRAM_ACTION_LOCK = '/run/lock/vmatlas-zram-tier.lock'

# ── Layout helpers ─────────────────────────────────────────────────────

_tw_cache = (0.0, 80, 24)  # (timestamp, columns, rows)

def get_term_size():
    """Get the current (columns, rows) without retaining a stale dimension."""
    global _tw_cache
    now = time.monotonic()
    if now - _tw_cache[0] > 0.10:
        try:
            sz = os.get_terminal_size(sys.stdout.fileno())
        except Exception:
            sz = shutil.get_terminal_size(fallback=(80, 24))
        cols = max(1, int(sz.columns or os.environ.get('COLUMNS', 80)))
        rows = max(1, int(sz.lines or os.environ.get('LINES', 24)))
        _tw_cache = (now, cols, rows)
    return _tw_cache[1], _tw_cache[2]


def get_term_width():
    return get_term_size()[0]


_ANSI_RE = re.compile(
    r'\033(?:\[[0-?]*[ -/]*[@-~]|\][^\a]*(?:\a|\033\\))'
)

def _char_width(char):
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ('W', 'F') else 1

def visible_len(text):
    return sum(_char_width(char) for char in _ANSI_RE.sub('', text))

def fit_line(text, tw):
    """Keep each render row inside one terminal line, preserving ANSI state."""
    # Keep one column spare: terminals may auto-wrap a glyph written in the
    # last cell, which turns the next redraw into a shifted, stale-looking UI.
    limit = max(1, tw - 1)
    vis = 0
    out = []
    i = 0
    n = len(text)
    while i < n:
        if text[i] == '\033':
            m = _ANSI_RE.match(text, i)
            if m:
                out.append(m.group(0))
                i = m.end()
                continue
        char_width = _char_width(text[i])
        if vis + char_width > limit:
            break
        out.append(text[i])
        vis += char_width
        i += 1
    out.append(RESET)
    return ''.join(out)

def clamp_line(text, tw):
    return fit_line(text, tw)


def to_human(bytes_val):
    """Convert bytes to human-readable string."""
    val = float(bytes_val)
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if abs(val) < 1024.0:
            if val >= 100:
                return f"{val:.0f} {unit}"
            elif val >= 10:
                return f"{val:.1f} {unit}"
            return f"{val:.2f} {unit}"
        val /= 1024.0
    return f"{val:.2f} PB"


def fmt_duration(seconds):
    """Format elapsed seconds into human-readable duration."""
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m{int(seconds % 60)}s"
    if seconds < 86400:
        h = int(seconds // 3600)
        m = int((seconds % 3600) // 60)
        return f"{h}h{m}m"
    d = int(seconds // 86400)
    h = int((seconds % 86400) // 3600)
    return f"{d}d{h}h"


def make_bar(pct, width=20):
    """Create a colored progress bar that adapts to available width."""
    width = max(5, width)
    filled = int(round(pct * width / 100))
    filled = max(0, min(width, filled))

    if pct < 60:
        fill_color = BGREEN
    elif pct < 85:
        fill_color = BYELLOW
    else:
        fill_color = BRED

    return f"{fill_color}{'█' * filled}{GRAY}{'░' * (width - filled)}{RESET}"


def make_separator(label="", width=None):
    if width is None:
        width = get_term_width()
    if label:
        visual_label_len = visible_len(label) + 2
        dash_len = max(1, width - visual_label_len - 2)
        return f" {BOLD}{BCYAN}{label}{RESET} {CYAN}{'─' * dash_len}{RESET}"
    return f" {CYAN}{'─' * max(1, width - 2)}{RESET}"


def memory_breakdown_cells(mem, avail_ram):
    """Return memory fields in importance order for the responsive grid."""
    free_mem = mem.get('MemFree', 0)
    cached = mem.get('Cached', 0)
    buffers = mem.get('Buffers', 0)
    active = mem.get('Active', 0)
    inactive = mem.get('Inactive', 0)
    dirty = mem.get('Dirty', 0)
    mapped = mem.get('Mapped', 0)
    sreclaim = mem.get('SReclaimable', 0)
    sunreclaim = mem.get('SUnreclaim', 0)
    cache_total = buffers + cached + sreclaim
    anon = mem.get('Active(anon)', 0) + mem.get('Inactive(anon)', 0)
    anon_active = mem.get('Active(anon)', 0)
    anon_inactive = mem.get('Inactive(anon)', 0)
    file_active = mem.get('Active(file)', 0)
    file_inactive = mem.get('Inactive(file)', 0)
    shmem = mem.get('Shmem', 0)
    pagetables = mem.get('PageTables', 0)

    dirty_color = (BRED if dirty > 512 * 1024 * 1024
                   else BYELLOW if dirty > 256 * 1024 * 1024
                   else BWHITE)
    inactive_color = BYELLOW if anon_inactive > 1024 * 1024 * 1024 else BWHITE

    return [
        ("Available", avail_ram, BGREEN),
        ("Anon tot", anon, BWHITE),
        ("Cache tot", cache_total, BGREEN),
        ("Free", free_mem, BGREEN),
        ("Anon active", anon_active, BWHITE),
        ("File active", file_active, WHITE),
        ("Anon inact", anon_inactive, inactive_color),
        ("File inact", file_inactive, BWHITE),
        ("Active", active, BWHITE),
        ("Inactive", inactive, BWHITE),
        ("Cached", cached, WHITE),
        ("Buffers", buffers, WHITE),
        ("Slab recl", sreclaim, BGREEN),
        ("Slab pin", sunreclaim, BYELLOW),
        ("Shmem", shmem, BWHITE),
        ("PageTables", pagetables, BWHITE),
        ("Dirty", dirty, dirty_color),
        ("Mapped", mapped, BWHITE),
    ]


def memory_grid(cells, tw, indent="   "):
    """Pack memory cells into as many readable columns as the terminal allows."""
    if not cells:
        return []

    # Keep the grid dense enough to use three columns on an ordinary split
    # pane.  The previous 12+12 minimum forced an unnecessary two-column grid
    # around 80 columns, consuming rows needed by the process table.
    label_width = max(11, max(visible_len(label) for label, _, _ in cells))
    value_width = max(9, max(visible_len(to_human(value)) for _, value, _ in cells))
    cell_width = label_width + 1 + value_width
    # Keep one spare terminal cell so the final glyph cannot auto-wrap.
    available = max(1, tw - visible_len(indent) - 1)
    min_gap = 3
    columns = max(1, min(len(cells), available // (cell_width + min_gap)))
    remaining = available - columns * cell_width
    gap = 0 if columns == 1 else max(min_gap, remaining // (columns - 1))

    def mem_cell(label, value, color):
        return (f"{CYAN}{label:<{label_width}}{RESET} "
                f"{color}{to_human(value):>{value_width}}{RESET}")

    rendered = []
    for start in range(0, len(cells), columns):
        row = cells[start:start + columns]
        rendered.append(indent + (" " * gap).join(mem_cell(*cell) for cell in row))
    return rendered


# ── Data Collection ────────────────────────────────────────────────────

def get_meminfo():
    data = {}
    try:
        with open('/proc/meminfo', 'r') as f:
            for line in f:
                parts = line.strip().split()
                if not parts:
                    continue
                name = parts[0].rstrip(':')
                if len(parts) == 3 and parts[2].lower() == 'kb':
                    data[name] = int(parts[1]) * 1024
                elif len(parts) == 2:
                    data[name] = int(parts[1])
    except Exception:
        pass
    return data


def get_psi():
    psi = {
        'some': {'avg10': 0.0, 'avg60': 0.0, 'avg300': 0.0},
        'full': {'avg10': 0.0, 'avg60': 0.0, 'avg300': 0.0},
    }
    try:
        with open('/proc/pressure/memory', 'r') as f:
            for line in f:
                parts = line.strip().split()
                if not parts:
                    continue
                kind = parts[0]
                if kind in psi:
                    for part in parts[1:]:
                        if '=' in part:
                            k, v = part.split('=')
                            if k in psi[kind]:
                                psi[kind][k] = float(v)
    except Exception:
        pass
    return psi


def _read_zram_stats_unlocked():
    """Return the live zram tier state without spawning vmatlas.

    vmatlas is the full read-only source of truth.  The small subset here is
    deliberately syscall-light enough for a 2 Hz dashboard refresh.
    """
    stats = {
        'orig': 0, 'compr': 0, 'mem_used': 0, 'mem_limit': 0, 'mem_used_max': 0,
        'same': 0, 'compacted': 0, 'huge': 0, 'huge_since': 0,
        'primary': '?', 'recomp_tiers': [], 'recomp': None,
        'backing': None, 'backing_bytes': 0, 'bd_reads': 0, 'bd_writes': 0,
        'wb_boot_writes': 0,
        'wb_enabled': None, 'wb_limit_bytes': 0, 'compressed_wb': False,
        'disksize': 0,
    }
    base = '/sys/block/zram0'

    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except Exception:
            return ''

    try:
        parts = read(f'{base}/mm_stat').split()
        if len(parts) >= 8:
            stats['orig'] = int(parts[0])
            stats['compr'] = int(parts[1])
            stats['mem_used'] = int(parts[2])
            stats['mem_limit'] = int(parts[3])
            stats['mem_used_max'] = int(parts[4])
            stats['same'] = int(parts[5])
            stats['compacted'] = int(parts[6])
            stats['huge'] = int(parts[7])
            if len(parts) >= 9:
                stats['huge_since'] = int(parts[8])
        elif len(parts) >= 3:
            stats['orig'] = int(parts[0])
            stats['compr'] = int(parts[1])
            stats['mem_used'] = int(parts[2])

        ds = read(f'{base}/disksize')
        if ds.isdigit():
            stats['disksize'] = int(ds)

        if stats['mem_limit'] == 0:
            ml = read(f'{base}/mem_limit')
            if ml.isdigit() and int(ml) > 0:
                stats['mem_limit'] = int(ml)

        def selected(value):
            for item in value.split():
                if item.startswith('[') and item.endswith(']'):
                    return item[1:-1]
            return value.split()[-1] if value.split() else '?'

        stats['primary'] = selected(read(f'{base}/comp_algorithm'))

        level_state = {}
        for state_line in read('/run/vmatlas-tier/levels').splitlines():
            if '=' in state_line:
                key, value = state_line.split('=', 1)
                level_state[key] = value
        recomp_raw = read(f'{base}/recomp_algorithm')
        tiers = []
        if recomp_raw:
            for line in recomp_raw.replace('\x00', '\n').splitlines():
                line = line.strip()
                if line.startswith('#'):
                    prio_num = line.split(':')[0]
                    sel = selected(line)
                    priority = prio_num[1:]
                    spec = level_state.get(f'tier{priority}')
                    verified = spec and spec.split(':', 1)[0] == sel
                    tiers.append(f"{spec} ({prio_num}, verified)" if verified else
                                 f"{sel} ({prio_num}, level unverified)")
        stats['recomp_tiers'] = tiers
        stats['recomp'] = ' → '.join(tiers) if tiers else None

        backing = read(f'{base}/backing_dev')
        stats['backing'] = backing if backing and backing != 'none' else None
        bd = read(f'{base}/bd_stat').split()
        if bd:
            stats['backing_bytes'] = int(bd[0]) * 4096
            if len(bd) >= 2:
                stats['bd_reads'] = int(bd[1])
            if len(bd) >= 3:
                stats['bd_writes'] = int(bd[2])
                stats['wb_boot_writes'] = stats['bd_writes']
        boot_writes = read('/run/vmatlas-tier/writeback_pages')
        if boot_writes.isdigit():
            stats['wb_boot_writes'] = max(stats['wb_boot_writes'], int(boot_writes))
        enabled = read(f'{base}/writeback_limit_enable')
        stats['wb_enabled'] = enabled == '1' if enabled else None
        limit = read(f'{base}/writeback_limit')
        if limit.isdigit():
            stats['wb_limit_bytes'] = int(limit) * 4096
        cwb = read(f'{base}/compressed_writeback')
        stats['compressed_wb'] = (cwb == '1' or cwb.lower() == 'yes')
    except Exception:
        pass
    return stats


def get_zram_stats(previous=None):
    """Read ZRAM stats without allowing a tier action to freeze the TUI.

    The memory-tools wrapper holds the ZRAM action lock for the duration of a
    recompression/writeback operation.  ZRAM sysfs readers can sleep in the
    kernel while that operation is running, so take a non-blocking shared lock
    first.  If it is busy, return the last sample and let the dashboard label
    it as stale; all other telemetry continues to refresh normally.
    """
    fd = None
    try:
        fd = os.open(_ZRAM_ACTION_LOCK, os.O_RDONLY | os.O_CLOEXEC)
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except (BlockingIOError, OSError) as exc:
            if isinstance(exc, BlockingIOError) or getattr(exc, 'errno', None) in (11, 35):
                stats = dict(previous or {})
                stats['busy'] = True
                stats['sample_time'] = stats.get('sample_time')
                return stats
            raise
    except OSError:
        # If the optional coordination file is absent, preserve legacy
        # read-only behavior.  Normal memory-tools actions always create it.
        return _read_zram_stats_unlocked()

    try:
        stats = _read_zram_stats_unlocked()
        stats['busy'] = False
        stats['sample_time'] = time.monotonic()
        return stats
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def get_vm_knobs():
    """Read VM tunables and sysctl knobs."""
    keys = (
        'swappiness', 'page-cluster', 'vfs_cache_pressure',
        'dirty_background_bytes', 'dirty_background_ratio',
        'dirty_bytes', 'dirty_ratio',
        'dirty_expire_centisecs', 'dirty_writeback_centisecs',
        'dirtytime_expire_seconds',
        'min_free_kbytes', 'watermark_scale_factor', 'watermark_boost_factor',
        'compaction_proactiveness', 'extfrag_threshold', 'zone_reclaim_mode',
        'lowmem_reserve_ratio', 'overcommit_memory', 'overcommit_ratio',
        'overcommit_kbytes', 'max_map_count', 'admin_reserve_kbytes',
        'user_reserve_kbytes', 'page_lock_unfairness',
        'percpu_pagelist_high_fraction',
    )
    knobs = {}
    for key in keys:
        try:
            with open(f'/proc/sys/vm/{key}') as f:
                val = f.read().strip()
                if '\t' in val or ' ' in val:
                    knobs[key] = val
                elif val.isdigit() or (val.startswith('-') and val[1:].isdigit()):
                    knobs[key] = int(val)
                else:
                    knobs[key] = val
        except Exception:
            knobs[key] = None
    return knobs


def fmt_swap_knobs(knobs, tw=120):
    parts = []
    sw = knobs.get('swappiness')
    if sw is not None:
        parts.append(f"{DIM}swappiness{RESET} {BWHITE}{sw}{RESET}")
    cluster = knobs.get('page-cluster')
    if cluster is not None:
        parts.append(f"{DIM}cluster{RESET} {BWHITE}{cluster}{RESET}")
    vfs = knobs.get('vfs_cache_pressure')
    if vfs is not None:
        parts.append(f"{DIM}vfs_cache_pressure{RESET} {BWHITE}{vfs}{RESET}")
    if tw >= 100:
        max_map = knobs.get('max_map_count')
        if max_map is not None:
            try:
                m = int(max_map)
                mm_str = f"{m/1000000:.2f}M" if m >= 1000000 else f"{m}"
                parts.append(f"{DIM}max_map_count{RESET} {BWHITE}{mm_str}{RESET}")
            except Exception:
                parts.append(f"{DIM}max_map_count{RESET} {BWHITE}{max_map}{RESET}")
        oc = knobs.get('overcommit_memory')
        ocr = knobs.get('overcommit_ratio')
        if oc is not None:
            oc_mode = {0: 'heuristic', 1: 'always', 2: 'strict'}.get(int(oc) if str(oc).isdigit() else -1, str(oc))
            if ocr is not None and tw >= 115:
                parts.append(f"{DIM}overcommit{RESET} {BWHITE}{oc}{RESET} {DIM}({oc_mode}, {ocr}%){RESET}")
            else:
                parts.append(f"{DIM}overcommit{RESET} {BWHITE}{oc}{RESET} {DIM}({oc_mode}){RESET}")
    return f" {DIM}     {' · '.join(parts)}{RESET}"


def fmt_dirty_knobs(knobs, tw=120):
    bg_bytes = knobs.get('dirty_background_bytes')
    bg_ratio = knobs.get('dirty_background_ratio')
    d_bytes = knobs.get('dirty_bytes')
    d_ratio = knobs.get('dirty_ratio')

    if d_bytes and int(d_bytes) > 0:
        limit_str = to_human(int(d_bytes))
    elif d_ratio is not None:
        limit_str = f"{d_ratio}%"
    else:
        limit_str = "?"

    if bg_bytes and int(bg_bytes) > 0:
        bg_str = to_human(int(bg_bytes))
    elif bg_ratio is not None:
        bg_str = f"{bg_ratio}%"
    else:
        bg_str = "?"

    wb_cs = knobs.get('dirty_writeback_centisecs')
    exp_cs = knobs.get('dirty_expire_centisecs')
    dtime_s = knobs.get('dirtytime_expire_seconds')

    def fmt_cs(cs):
        if cs is None: return '?'
        s = int(cs) / 100.0
        return f"{s:.0f}s" if s >= 10 else f"{s:.1f}s"

    def fmt_sec(s):
        if s is None: return '?'
        s = int(s)
        if s >= 3600: return f"{s//3600}h"
        if s >= 60: return f"{s//60}m"
        return f"{s}s"

    parts = [f"{DIM}dirty bg/limit{RESET} {BWHITE}{bg_str}/{limit_str}{RESET}"]
    if exp_cs is not None:
        parts.append(f"{DIM}expire{RESET} {BWHITE}{fmt_cs(exp_cs)}{RESET}")
    if wb_cs is not None:
        parts.append(f"{DIM}writeback{RESET} {BWHITE}{fmt_cs(wb_cs)}{RESET}")
    if dtime_s is not None and tw >= 100:
        parts.append(f"{DIM}dirtytime{RESET} {BWHITE}{fmt_sec(dtime_s)}{RESET}")

    return f"   {' · '.join(parts)}"


def zone_knob_parts(knobs, tw=120):
    parts = []
    mf = knobs.get('min_free_kbytes')
    if mf is not None:
        try:
            m = int(mf) * 1024
            parts.append(f"{DIM}min_free{RESET} {BWHITE}{to_human(m)}{RESET}")
        except Exception:
            parts.append(f"{DIM}min_free{RESET} {BWHITE}{mf} KB{RESET}")

    ws = knobs.get('watermark_scale_factor')
    if ws is not None:
        try:
            pct = int(ws) / 100.0
            parts.append(f"{DIM}wmark_scale{RESET} {BWHITE}{ws}{RESET} {DIM}({pct:.2f}%){RESET}")
        except Exception:
            parts.append(f"{DIM}wmark_scale{RESET} {BWHITE}{ws}{RESET}")

    wb = knobs.get('watermark_boost_factor')
    if wb is not None:
        try:
            pct = int(wb) / 100.0
            if pct > 0:
                parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET} {DIM}({pct:.0f}%){RESET}")
            else:
                parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET}")
        except Exception:
            parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET}")

    cp = knobs.get('compaction_proactiveness')
    if cp is not None:
        parts.append(f"{DIM}compaction{RESET} {BWHITE}{cp}{RESET}")

    ef = knobs.get('extfrag_threshold')
    if ef is not None and tw >= 110:
        parts.append(f"{DIM}extfrag{RESET} {BWHITE}{ef}{RESET}")

    zr = knobs.get('zone_reclaim_mode')
    if zr is not None and tw >= 120:
        parts.append(f"{DIM}zone_reclaim{RESET} {BWHITE}{zr}{RESET}")

    if tw >= 145:
        lm = knobs.get('lowmem_reserve_ratio')
        if lm:
            lm_clean = '/'.join(lm.split()[:3])
            parts.append(f"{DIM}lowmem_reserve{RESET} {BWHITE}{lm_clean}{RESET}")

    return parts


def fmt_zone_knobs(knobs, tw=120):
    return f"   {' · '.join(zone_knob_parts(knobs, tw))}"


def get_watermark_snapshot():
    """Read zone and reclaim counters from local /proc."""
    zones = []
    node = None
    zone = None
    fields = {}
    try:
        with open('/proc/zoneinfo') as f:
            for raw in f:
                line = raw.strip()
                match = re.match(r'Node\s+(\d+),\s+zone\s+(\S+)', line)
                if match:
                    if zone and fields.get('managed', 0) > 0:
                        zones.append({'node': node, 'name': zone, **fields})
                    node, zone = int(match.group(1)), match.group(2)
                    fields = {}
                    continue
                match = re.match(r'pages free\s+(\d+)$', line)
                if match and zone:
                    fields['free'] = int(match.group(1))
                    continue
                match = re.match(r'(min|low|high|boost|promo|spanned|present|managed|cma)\s+(\d+)$', line)
                if match and zone:
                    fields[match.group(1)] = int(match.group(2))
                    continue
                match = re.match(r'protection:\s*\((.*?)\)', line)
                if match and zone:
                    fields['protection'] = match.group(1)
                    continue
                match = re.match(r'(nr_zspages|nr_zone_write_pending)\s+(\d+)$', line)
                if match and zone:
                    fields[match.group(1)] = int(match.group(2))
                    continue
        if zone and fields.get('managed', 0) > 0:
            zones.append({'node': node, 'name': zone, **fields})
    except Exception:
        pass

    counters = {}
    wanted = {
        'pgscan_kswapd', 'pgscan_kswapd_normal', 'pgscan_direct',
        'pgsteal_kswapd', 'pgsteal_direct', 'kswapd_low_wmark_hit_quickly',
        'allocstall', 'allocstall_normal', 'allocstall_movable',
    }
    try:
        with open('/proc/vmstat') as f:
            for line in f:
                key, _, value = line.partition(' ')
                if key in wanted and value.strip().isdigit():
                    counters[key] = int(value.strip())
    except Exception:
        pass
    return zones, counters


def watermark_bar(zone, width=20):
    """Terminal counterpart to the free-meter with min/low markers."""
    high = max(zone.get('high', 0), 1)
    scale = max(high, zone.get('free', 0), 1)
    free_at = min(width, int(round(zone.get('free', 0) * width / scale)))
    min_at = min(width - 1, int(round(zone.get('min', 0) * width / scale)))
    low_at = min(width - 1, int(round(zone.get('low', 0) * width / scale)))
    color = BRED if zone.get('free', 0) <= zone.get('min', 0) else (
        BYELLOW if zone.get('free', 0) <= zone.get('low', 0) else BGREEN
    )
    out = []
    for index in range(width):
        if index == min_at:
            out.append(f"{BRED}│{RESET}")
        elif index == low_at:
            out.append(f"{BYELLOW}│{RESET}")
        elif index < free_at:
            out.append(f"{color}█{RESET}")
        else:
            out.append(f"{GRAY}░{RESET}")
    return ''.join(out)


def kswapd_verdict(zones, deltas):
    fields = []
    for key, label in (('pgscan_kswapd', 'scan'), ('pgsteal_kswapd', 'steal'),
                       ('pgscan_direct', 'direct'), ('kswapd_low_wmark_hit_quickly', 'low-hit')):
        value = deltas.get(key, deltas.get(key + '_normal'))
        if value is not None:
            color = BYELLOW if value > 0 else DIM
            fields.append(f"{DIM}{label}{RESET} {color}{value:.0f}/s{RESET}")
    return ' ' + '  '.join(fields) if fields else ''


def get_loadavg():
    """Read load average and running/total tasks."""
    try:
        with open('/proc/loadavg', 'r') as f:
            parts = f.read().strip().split()
            running, total = parts[3].split('/')
            return {
                'l1': float(parts[0]),
                'l5': float(parts[1]),
                'l15': float(parts[2]),
                'running': int(running),
                'total': int(total),
            }
    except Exception:
        return {'l1': 0, 'l5': 0, 'l15': 0, 'running': 0, 'total': 0}


def get_cpu_times():
    """Read aggregate CPU times from /proc/stat."""
    try:
        with open('/proc/stat', 'r') as f:
            line = f.readline().strip()
        parts = line.split()
        # user, nice, system, idle, iowait, irq, softirq, steal
        vals = [int(x) for x in parts[1:9]]
        return vals
    except Exception:
        return None


def calc_cpu_pct(prev, cur):
    """Calculate CPU usage percentage from two snapshots."""
    if prev is None or cur is None:
        return None
    prev_idle = prev[3] + prev[4]  # idle + iowait
    cur_idle = cur[3] + cur[4]
    prev_total = sum(prev)
    cur_total = sum(cur)
    dtotal = cur_total - prev_total
    didle = cur_idle - prev_idle
    if dtotal == 0:
        return 0.0
    return ((dtotal - didle) / dtotal) * 100.0


def get_temps():
    """Read CPU and GPU temps from /sys or lm-sensors."""
    temps = {}
    # CPU: k10temp / coretemp
    for base in ['/sys/class/hwmon']:
        try:
            for hwmon in os.listdir(base):
                name_path = os.path.join(base, hwmon, 'name')
                if not os.path.exists(name_path):
                    continue
                with open(name_path) as f:
                    name = f.read().strip()
                if name in ('k10temp', 'coretemp'):
                    # Read Tctl / temp1
                    for tfile in ('temp1_input', 'temp2_input'):
                        tp = os.path.join(base, hwmon, tfile)
                        if os.path.exists(tp):
                            with open(tp) as f:
                                temps['cpu'] = int(f.read().strip()) / 1000.0
                            break
                elif name == 'amdgpu':
                    # GPU edge temp
                    tp = os.path.join(base, hwmon, 'temp1_input')
                    if os.path.exists(tp):
                        with open(tp) as f:
                            temps['gpu'] = int(f.read().strip()) / 1000.0
        except Exception:
            pass
    return temps


def get_uptime():
    """System uptime in seconds."""
    try:
        with open('/proc/uptime') as f:
            return float(f.read().strip().split()[0])
    except Exception:
        return 0


def get_nproc():
    try:
        return os.cpu_count() or 1
    except Exception:
        return 1


# ── Process collection ─────────────────────────────────────────────────

def _read_proc_field(pid, field_path):
    """Read a single value from /proc/PID/..."""
    try:
        with open(f'/proc/{pid}/{field_path}') as f:
            return f.read().strip()
    except Exception:
        return None


def process_start_ticks(stat_text):
    # The comm field may itself contain spaces and closing parentheses.
    return int(stat_text.rsplit(')', 1)[1].split()[19])


def read_process_identity(pid):
    """Read start time and owner without accepting a PID recycled mid-read."""
    try:
        start = process_start_ticks(_read_proc_field(pid, 'stat'))
        status = _read_proc_field(pid, 'status')
        uid = int(next(line.split()[1] for line in status.splitlines()
                       if line.startswith('Uid:')))
        if start != process_start_ticks(_read_proc_field(pid, 'stat')):
            return None
        return {'start': start, 'uid': uid}
    except (AttributeError, IndexError, StopIteration, TypeError, ValueError):
        return None


def snapshot_identity(proc):
    if proc.get('start') is None or proc.get('uid') is None:
        return None
    return {'start': proc['start'], 'uid': proc['uid']}


def display_user(uid):
    try:
        return pwd.getpwuid(uid).pw_name
    except (KeyError, TypeError):
        return str(uid) if uid is not None else '?'


def _display_comm(pid, comm):
    """Give Firefox's otherwise ambiguous content processes useful labels."""
    firefox_comms = {
        'firefox', 'Isolated Web Content', 'Isolated Service Worker',
        'Privileged Content', 'WebExtensions', 'RDD Process',
        'Socket Process', 'Utility Process', 'forkserver',
    }
    # /proc/PID/comm is limited to 15 bytes, hence Firefox's content name is
    # commonly the truncated "Isolated Web Co" rather than its full title.
    firefox_like = comm in firefox_comms or comm.startswith(
        ('Isolated ', 'Privileged ')
    )
    if not firefox_like:
        return comm

    cmdline = _read_proc_field(pid, 'cmdline')
    if not cmdline or '/firefox/' not in cmdline:
        return comm

    if '-contentproc' not in cmdline:
        return 'firefox'

    # Firefox appends e.g. "203 tab" to its content-process command line.
    # Preserve that identity in the table without parsing fragile full args.
    child_match = re.search(r'(?:^|\s)(\d+)\s+(tab|rdd|socket|utility)\s*\0*$', cmdline)
    if child_match:
        child_id, role = child_match.groups()
        return f"ff:{role}#{child_id}"
    return 'ff:content'


def get_enriched_processes(limit=10):
    """Collect rich per-process data by reading ps numeric fields and /proc.

    Returns list of dicts with keys:
      pid, comm, rss, vsz, swap, pcpu, pmem, state, nice, threads,
      oom_score, elapsed (seconds), total_mem (rss+swap)
    """
    try:
        # Do not request ``comm`` here: Firefox names such as "Isolated Web
        # Content" contain spaces.  Splitting that output used to make every
        # content process look malformed and silently dropped it from vminfo.
        out = subprocess.check_output(
            ['ps', 'axo', 'pid,rss,vsz,pcpu,pmem,stat,nice,nlwp,etimes',
             '--sort=-rss', '--no-headers'],
            text=True, stderr=subprocess.DEVNULL,
        )
    except Exception:
        return []

    processes = []
    seen_pids = set()
    for line in out.strip().split('\n'):
        parts = line.split()
        if len(parts) < 9:
            continue
        pid = parts[0]
        if pid in seen_pids:
            continue
        seen_pids.add(pid)

        try:
            rss = int(parts[1]) * 1024
            vsz = int(parts[2]) * 1024
            pcpu = float(parts[3])
            pmem = float(parts[4])
            state = parts[5]
            nice = parts[6]
            threads = int(parts[7])
            elapsed = int(parts[8])
        except (ValueError, IndexError):
            continue

        stat_before = _read_proc_field(pid, 'stat')
        raw_comm = _read_proc_field(pid, 'comm') or '?'
        comm = _display_comm(pid, raw_comm)
        cmdline = (_read_proc_field(pid, 'cmdline') or '').replace('\0', ' ').strip()

        # Use inexpensive status counters to separate anonymous resident RAM,
        # file-backed mappings, and swapped pages. This avoids a full smaps
        # walk for every process on each refresh.
        swap = 0
        rss_anon = 0
        rss_file = 0
        rss_shmem = 0
        oom = 0
        uid = None
        try:
            status_text = _read_proc_field(pid, 'status')
            if status_text:
                for sline in status_text.split('\n'):
                    if sline.startswith('Uid:'):
                        uid = int(sline.split()[1])
                    elif sline.startswith('VmSwap:'):
                        swap = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssAnon:'):
                        rss_anon = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssFile:'):
                        rss_file = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssShmem:'):
                        rss_shmem = int(sline.split()[1]) * 1024
        except Exception:
            uid = None

        # OOM score
        try:
            oom_str = _read_proc_field(pid, 'oom_score')
            if oom_str:
                oom = int(oom_str)
        except Exception:
            pass

        # Cumulative CPU time (utime + stime from /proc/pid/stat)
        cputime_s = 0.0
        start = None
        try:
            stat_raw = _read_proc_field(pid, 'stat')
            if stat_raw:
                current_start = process_start_ticks(stat_raw)
                if current_start != process_start_ticks(stat_before):
                    continue
                start = current_start
                # Split on ')' to skip comm field (may contain spaces)
                after_comm = stat_raw.rsplit(')', 1)[1].split()
                # utime is field 14, stime is field 15 (1-indexed from start)
                # After splitting past comm: index 11=utime, 12=stime
                utime = int(after_comm[11])
                stime = int(after_comm[12])
                cputime_s = (utime + stime) / _CLK_TCK
        except Exception:
            pass

        processes.append({
            'pid': pid,
            'comm': comm,
            'raw_comm': raw_comm,
            'cmdline': cmdline,
            'rss': rss,
            'vsz': vsz,
            'swap': swap,
            'rss_anon': rss_anon,
            'rss_file': rss_file,
            'rss_shmem': rss_shmem,
            'pcpu': pcpu,
            'pmem': pmem,
            'state': state,
            'nice': nice,
            'threads': threads,
            'oom_score': oom,
            'elapsed': elapsed,
            'total_mem': rss + swap,
            'cputime_s': cputime_s,
            'uid': uid,
            'user': display_user(uid),
            'start': start,
            'owned': uid == os.getuid(),
        })

    return processes


# Process state descriptions
STATE_MAP = {
    'R': ('RUN', BGREEN),
    'S': ('SLP', GRAY),
    'D': ('D/W', BRED),
    'Z': ('ZMB', BRED),
    'T': ('STP', BYELLOW),
    't': ('TRC', BYELLOW),
    'I': ('IDL', GRAY),
}

def fmt_state(raw):
    """Format process state character with color and label."""
    base = raw[0] if raw else '?'
    label, color = STATE_MAP.get(base, (base, WHITE))
    return f"{color}{label}{RESET}"


# ── Delta Tracker ──────────────────────────────────────────────────────

class DeltaTracker:
    def __init__(self, alpha=0.3):
        self.alpha = alpha
        self._prev = {}
        self._ema = {}
        self._prev_time = time.time()

    def tick(self, values):
        now = time.time()
        dt = now - self._prev_time
        if dt < 0.05:
            return {k: self._ema.get(k) for k in values}

        deltas = {}
        for key, current in values.items():
            if key in self._prev:
                raw_rate = (current - self._prev[key]) / dt
                if key in self._ema:
                    self._ema[key] = (self.alpha * raw_rate
                                      + (1 - self.alpha) * self._ema[key])
                else:
                    self._ema[key] = raw_rate
                deltas[key] = self._ema[key]
            else:
                deltas[key] = None
            self._prev[key] = current

        self._prev_time = now
        return deltas


# ── View modes ─────────────────────────────────────────────────────────

VIEW_MODES = [
    {'key': '1', 'sort': 'rss',       'label': 'Resident RAM', 'color': BCYAN},
    {'key': '2', 'sort': 'pcpu',      'label': 'CPU',     'color': BRED},
    {'key': '3', 'sort': 'swap',      'label': 'Swap',    'color': BMAGENTA},
    {'key': '4', 'sort': 'total_mem', 'label': 'RAM + Swap',   'color': BYELLOW},
]


# ── Dashboard Rendering ───────────────────────────────────────────────

def footer_rows(width, count, filter_label='Filter', android=False, lite=False):
    controls = [('q', 'quit', DIM), ('1-2' if lite else '1-4', 'view', DIM),
                ('v', filter_label, DIM), ('+/-', count, DIM)]
    if not lite:
        controls += [('f', 'swap', BMAGENTA), ('u', 'unswap', BGREEN),
                     ('k', 'sig', BRED), ('r', 'recomp', BMAGENTA), ('w', 'wb', BCYAN)]
    controls += [('Space', 'pause', DIM)]
    if not lite:
        controls += [('m', 'select', BYELLOW)]
    return control_rows(controls, width)


def control_rows(controls, width):
    rows, current = [], ' '
    for key, label, color in controls:
        item = f'{color}[{key}]{RESET} {label}'
        if current != ' ' and visible_len(current + ' ' + item) > width - 1:
            rows.append(current)
            current = ' ' + item
        else:
            current += ('' if current == ' ' else ' ') + item
    rows.append(current)
    return rows


def manager_footer_rows(manager, width, count, filter_label):
    query = f" · search={manager.query!r}" if manager.query else ''
    rows = [f" {BYELLOW}{len(manager.selected)} selected{RESET}{query}"]
    rows += control_rows([
        ('↑↓/jk', 'move', BYELLOW), ('PgUp/PgDn', 'page', DIM),
        ('Home/End', 'jump', DIM), ('Space', 'tick', BYELLOW),
        ('a', 'all matches', DIM), ('b', 'visible', BYELLOW),
        ('c', 'clear', DIM), ('/', 'search', DIM),
        ('i', 'inspect', BCYAN), ('1-4', 'view', DIM), ('v', filter_label, DIM),
        ('+/-', count, DIM), ('f', 'swap', BMAGENTA), ('u', 'unswap', BGREEN),
        ('x', 'signal', BRED), ('m/Esc', 'exit', DIM),
    ], width)
    if manager.notice:
        rows.append(f" {BYELLOW}{manager.notice}{RESET}")
    return rows


def compact_fields(label, fields, width):
    """Wrap whole label/value fields, reserving one terminal column."""
    prefix = f" {BOLD}{label:<5}{RESET} "
    current = prefix
    rows = []
    for key, value in fields:
        item = f"{DIM}{key}{RESET} {BWHITE}{value}{RESET}" if key else str(value)
        candidate = current + ("  " if current != prefix else "") + item
        if current != prefix and visible_len(candidate) > width - 1:
            rows.append(current)
            current = prefix + item
        else:
            current = candidate
    if current != prefix:
        rows.append(current)
    return rows


def vm_fields(knobs):
    """Known tunables only; zero is a value, missing is not zero."""
    knobs = {k.replace('-', '_'): v for k, v in knobs.items()}
    fields = []
    for key, label in (
        ('swappiness', 'swappiness'), ('page_cluster', 'cluster'),
        ('min_free_kbytes', 'min-free'), ('extra_free_kbytes', 'extra-free'),
        ('watermark_scale_factor', 'scale'), ('watermark_boost_factor', 'boost'),
        ('compaction_proactiveness', 'compact'),
        ('vfs_cache_pressure', 'vfs'), ('max_map_count', 'maps'),
        ('overcommit_memory', 'overcommit'), ('overcommit_ratio', 'oc-ratio'),
        ('extfrag_threshold', 'extfrag'), ('zone_reclaim_mode', 'zone-reclaim'),
        ('lowmem_reserve_ratio', 'reserve'),
    ):
        value = knobs.get(key)
        if value is None:
            continue
        if key.endswith('_kbytes'):
            value = to_human(int(value) * 1024)
        elif key == 'lowmem_reserve_ratio':
            value = '/'.join(str(value).split())
        elif key == 'overcommit_ratio':
            value = f'{value}%'
        fields.append((label, value))
    return fields


def dirty_fields(knobs):
    knobs = {k.replace('-', '_'): v for k, v in knobs.items()}
    fields = []
    for key, label in (('dirty_background', 'bg'), ('dirty', 'limit')):
        size, ratio = knobs.get(key + '_bytes'), knobs.get(key + '_ratio')
        if size:
            fields.append((label, to_human(size)))
        elif ratio is not None:
            fields.append((label, f'{ratio}%'))
        elif size is not None:
            fields.append((label, '-'))
    for key, label, divisor in (
        ('dirty_expire_centisecs', 'expire', 100),
        ('dirty_writeback_centisecs', 'write', 100),
        ('dirtytime_expire_seconds', 'age', 1),
    ):
        if knobs.get(key) is not None:
            fields.append((label, f'{knobs[key] / divisor:g}s'))
    return fields


def draw_dashboard(mem, psi, zr, view_idx, paused, deltas, processes,
                   proc_limit, cpu_pct, temps, loadavg, uptime_s,
                   zones=None, vmstat_deltas=None, proc_filter=0, manager=None):
    """Render the complete dashboard, adapting to terminal width AND height."""
    lines = []
    tw, th = get_term_size()

    def emit(text):
        # The dashboard redraws from cursor-home.  Clear the rest of every row
        # so a shorter next sample cannot leave text or separator fragments
        # from the preceding frame on screen.
        lines.append(f"{fit_line(text, tw)}{ERASE_EOL}")

    def emit_packed(prefix, items, separator=" · ", continuation=None):
        """Wrap ordered telemetry items instead of silently clipping the tail."""
        if not items:
            return
        continuation = prefix if continuation is None else continuation
        limit = max(1, tw - 1)
        current = prefix
        for item in items:
            candidate = (current + separator + item
                         if current != prefix else current + item)
            if current != prefix and visible_len(candidate) > limit:
                emit(current)
                current = continuation + item
            else:
                current = candidate
        if current != prefix:
            emit(current)

    is_tiny = tw < 65
    is_narrow = 65 <= tw < 90
    # Reserve room for the labels and telemetry, then let the graph grow with
    # the terminal instead of freezing it at the old 20/25-cell width.
    bar_w = max(8, min(120, tw - 85))
    view = VIEW_MODES[view_idx]
    zones = zones or []
    vmstat_deltas = vmstat_deltas or {}
    vm_knobs = get_vm_knobs()
    memory_cells = memory_breakdown_cells(mem, mem.get('MemAvailable', 0))
    memory_grid_lines = memory_grid(memory_cells, tw)
    manager_active = manager is not None and manager.active
    ordered = (manager.ordered(view_idx, proc_filter) if manager_active else
               ordered_processes(processes, view_idx, proc_filter))
    filter_label = ('All', 'User', 'Sys')[proc_filter]
    if manager_active:
        manager.cursor = min(max(0, manager.cursor), max(0, len(ordered) - 1))

    has_zram = zr.get('orig', 0) > 0
    zram_busy = bool(zr.get('busy'))
    display_zones = sorted(zones, key=lambda z: z.get('managed', 0), reverse=True)[:3]

    # Section visibility decisions based on terminal size
    show_sublines = not is_tiny and th >= 28
    show_breakdown = not is_tiny and th >= 32
    show_zones = not is_tiny and th >= 40 and tw >= 75 and bool(display_zones)

    # ── Header ──────────────────────────────────────────────────────
    status = (f"{BYELLOW}MANAGER{RESET}" if manager_active else
              f"{BRED}PAUSED{RESET}" if paused else f"{BGREEN}LIVE{RESET}")
    if is_tiny:
        emit(f" {BOLD}{BCYAN}vminfo{RESET} {status}")
    else:
        uptxt = fmt_duration(uptime_s) if uptime_s else ""
        emit(f" {BOLD}{BCYAN}vminfo{RESET}  {status}  {DIM}up {uptxt}{RESET}")
    emit(f" {CYAN}{'━' * max(1, tw - 2)}{RESET}")

    # ── CPU, load, and temperatures ──────────────────────────────────
    ncpu = get_nproc()
    cpu_str = f"{cpu_pct:.0f}%" if cpu_pct is not None else "…"
    load_color = BGREEN
    if loadavg['l1'] > ncpu * 0.85:
        load_color = BRED
    elif loadavg['l1'] > ncpu * 0.5:
        load_color = BYELLOW

    cpu_bar_pct = min(cpu_pct or 0, 100)
    if is_tiny:
        emit(f" {BOLD}CPU  {RESET}  {make_bar(cpu_bar_pct, bar_w)} {BWHITE}{cpu_str}{RESET}")
        emit(f"        {DIM}load{RESET} {load_color}{loadavg['l1']:.1f}{RESET} {DIM}{loadavg['l5']:.1f} {loadavg['l15']:.1f} ({ncpu}c){RESET}")
    else:
        temp_parts = []
        if 'cpu' in temps:
            t = temps['cpu']
            tc = BRED if t > 80 else (BYELLOW if t > 65 else BGREEN)
            temp_parts.append(f"{DIM}cpu{RESET} {tc}{t:.0f}°C{RESET}")
        if 'gpu' in temps:
            t = temps['gpu']
            tc = BRED if t > 85 else (BYELLOW if t > 70 else BGREEN)
            temp_parts.append(f"{DIM}gpu{RESET} {tc}{t:.0f}°C{RESET}")
        temp_str = f"  {'  '.join(temp_parts)}" if temp_parts else ""

        emit(f" {BOLD}CPU  {RESET}   {make_bar(cpu_bar_pct, bar_w)}  "
             f"{BWHITE}{cpu_str:>5}{RESET}  "
             f"{DIM}load{RESET} {load_color}{loadavg['l1']:.2f}{RESET}"
             f"/{loadavg['l5']:.2f}/{loadavg['l15']:.2f}"
             f" {DIM}({ncpu}c, {loadavg['running']}/{loadavg['total']}){RESET}"
             f"{temp_str}")

    # ── RAM ─────────────────────────────────────────────────────────
    total_ram = mem.get('MemTotal', 1)
    avail_ram = mem.get('MemAvailable', 0)
    used_ram = total_ram - avail_ram
    ram_pct = (used_ram / total_ram) * 100 if total_ram else 0

    avail_ratio = avail_ram / total_ram if total_ram > 0 else 0
    if avail_ratio > 0.30:
        ram_color = BGREEN
    elif avail_ratio > 0.12:
        ram_color = BYELLOW
    else:
        ram_color = BRED

    ram_delta_str = f"{GRAY}0 B/s{RESET}"
    d = deltas.get('avail_ram')
    if d is not None:
        if d > 512 * 1024:
            ram_delta_str = f"{BGREEN}↗ +{to_human(d)}/s{RESET}"
        elif d < -512 * 1024:
            ram_delta_str = f"{BRED}↘ {to_human(abs(d))}/s{RESET}"

    if is_tiny:
        emit(f" {BOLD}RAM  {RESET}  {make_bar(ram_pct, bar_w)} {ram_color}{ram_pct:.0f}%{RESET}")
        emit(f"        {DIM}{to_human(used_ram)}/{to_human(total_ram)}{RESET}")
    else:
        emit(f" {BOLD}RAM  {RESET}   {make_bar(ram_pct, bar_w)}  "
             f"{ram_color}{ram_pct:5.1f}%{RESET}  "
             f"{DIM}{to_human(used_ram)} / {to_human(total_ram)}{RESET}  "
             f"{ram_delta_str}")

    # ── Swap ────────────────────────────────────────────────────────
    total_swap = mem.get('SwapTotal', 0)
    free_swap = mem.get('SwapFree', 0)
    used_swap = total_swap - free_swap
    swap_pct = (used_swap / total_swap) * 100 if total_swap > 0 else 0

    if swap_pct < 50:
        swap_color = BGREEN
    elif swap_pct < 85:
        swap_color = BYELLOW
    else:
        swap_color = BRED

    swap_delta_str = f"{GRAY}0 B/s{RESET}"
    d = deltas.get('used_swap')
    if d is not None:
        if d > 512 * 1024:
            swap_delta_str = f"{BRED}↗ +{to_human(d)}/s{RESET}"
        elif d < -512 * 1024:
            swap_delta_str = f"{BGREEN}↘ {to_human(abs(d))}/s{RESET}"

    swap_bar = make_bar(swap_pct, bar_w) if total_swap > 0 else f"{GRAY}{'░' * bar_w}{RESET}"
    if is_tiny:
        emit(f" {BOLD}Swap {RESET}   {swap_bar} {swap_color}{swap_pct:.0f}%{RESET}")
        emit(f"        {DIM}{to_human(used_swap)}/{to_human(total_swap)}{RESET}")
    else:
        emit(f" {BOLD}Swap {RESET}   {swap_bar}  "
             f"{swap_color}{swap_pct:5.1f}%{RESET}  "
             f"{DIM}{to_human(used_swap)} / {to_human(total_swap)}{RESET}  "
             f"{swap_delta_str}")

    # ZRAM and writeback use separate compact numeric rows.
    if has_zram:
        raw_ratio = zr['orig'] / zr['compr'] if zr['compr'] else 0
        phys_ratio = zr['orig'] / zr['mem_used'] if zr['mem_used'] else 0
        color = BGREEN if phys_ratio >= 2.5 else BYELLOW if phys_ratio >= 1.5 else BRED
        fields = [('', f"{color}{phys_ratio:.2f}x phys{RESET}"),
                  ('raw', f'{raw_ratio:.2f}x'), ('orig', to_human(zr['orig'])),
                  ('compr', to_human(zr['compr'])), ('RAM', to_human(zr['mem_used']))]
        for row in compact_fields('ZRAM', fields, tw):
            emit(row)
        codec = zr.get('primary') or '-'
        tiers = [str(t).split(' ', 1)[0] for t in zr.get('recomp_tiers', [])]
        if tiers:
            codec += '>' + '>'.join(tiers)
        for row in compact_fields('Codec', [('', codec)], tw):
            emit(row)
        if zr.get('backing'):
            limit = (to_human(zr.get('wb_limit_bytes', 0)) if zr.get('wb_enabled')
                     else 'off' if zr.get('wb_enabled') is False else '-')
            fields = [('', os.path.basename(zr['backing'])),
                      ('used', to_human(zr['backing_bytes'])),
                      ('read', to_human(zr.get('bd_reads', 0) * 4096)),
                      ('write', to_human(zr.get('wb_boot_writes', 0) * 4096)),
                      ('limit', limit)]
            for row in compact_fields('WB', fields, tw):
                emit(row)
    if zram_busy:
        emit(f" {BYELLOW}ZRAM  busy / cached sample{RESET}")

    # ── PSI ─────────────────────────────────────────────────────────
    s10 = psi['some']['avg10']
    s60 = psi['some']['avg60']
    s300 = psi['some']['avg300']
    f10 = psi['full']['avg10']

    color = BRED if s10 > 5 or f10 > 2 else BYELLOW if s10 > 0 else BGREEN
    fields = [('10/60/300', f"{color}{s10:.2f}/{s60:.2f}/{s300:.2f}%{RESET}"),
              ('full10', f'{f10:.2f}%')]
    for row in compact_fields('PSI', fields, tw):
        emit(row)

    # ── Memory Breakdown ────────────────────────────────────────────
    if show_breakdown:
        emit("")
        emit(make_separator("Memory", tw))
        for row in memory_grid_lines:
            emit(row)


    # ── Zones & watermarks ───────────────────────────────────────────
    if show_zones and display_zones:
        emit(make_separator("Zones", tw))
        reclaim = kswapd_verdict(display_zones, vmstat_deltas)
        if reclaim:
            emit(reclaim)
        if tw >= 135:
            zw = 25
        elif tw >= 110:
            zw = 16
        else:
            zw = 10

        for zone in display_zones:
            free = zone.get('free', 0)
            minimum = zone.get('min', 0)
            low = zone.get('low', 0)
            high = zone.get('high', 0)
            managed = zone.get('managed', 0)
            promo = zone.get('promo', 0)
            boost = zone.get('boost', 0)

            if free <= minimum:
                state = f"{BRED}< min{RESET}"
            elif free <= low:
                state = f"{BYELLOW}< low{RESET}"
            else:
                state = f"{BGREEN}> low{RESET}"

            pages_to_bytes = 4096
            zparts = [
                state,
                f"F {to_human(free * pages_to_bytes)}",
                f"min {to_human(minimum * pages_to_bytes)}",
                f"low {to_human(low * pages_to_bytes)}",
                f"high {to_human(high * pages_to_bytes)}"
            ]
            if boost > 0:
                zparts.append(f"boost {to_human(boost * pages_to_bytes)}")
            if tw >= 115 and managed > 0:
                zparts.append(f"managed {to_human(managed * pages_to_bytes)}")
            if tw >= 145 and promo > 0:
                zparts.append(f"promo {to_human(promo * pages_to_bytes)}")

            z_prefix = (f" {CYAN}N{zone.get('node', '?')} "
                        f"{zone.get('name', '?'):<7}{RESET} "
                        f"{watermark_bar(zone, zw)} ")
            emit_packed(z_prefix, zparts, separator=" · ", continuation="      ")

    if show_sublines:
        for row in compact_fields('VM', vm_fields(vm_knobs), tw):
            emit(row)
        for row in compact_fields('Dirty', dirty_fields(vm_knobs), tw):
            emit(row)

    # The upper dashboard now wraps telemetry according to the live width.
    # Measure the rendered lines directly so process rows fill only genuinely
    # unused height instead of relying on stale fixed-line estimates.
    count_hint = f"{min(proc_limit, len(ordered))}/{len(ordered)}"
    if manager_active:
        count_hint = f"{len(ordered)}-{len(ordered)}/{len(ordered)}"
    footer_height = len(manager_footer_rows(manager, tw, count_hint, filter_label)
                        if manager_active else footer_rows(tw, count_hint, filter_label))
    table_chrome = 5 + footer_height
    if manager_active and len(lines) + table_chrome + min(5, len(ordered)) > th:
        # Keep navigation, checkmarks, and actions visible in short split panes.
        lines = lines[:2]
        emit_packed(' ', [f"CPU {cpu_pct or 0:.0f}%",
                         f"RAM avail {to_human(avail_ram)}/{to_human(total_ram)}",
                         f"Swap {to_human(used_swap)}/{to_human(total_swap)}",
                         f"PSI {s10:.2f}% / full {f10:.2f}%"])
    max_procs_by_height = max(1, th - len(lines) - table_chrome)
    effective_limit = min(proc_limit, max_procs_by_height)
    window_start = 0
    if manager_active:
        manager.page_size = effective_limit
        manager.offset = min(manager.offset, manager.cursor)
        if manager.cursor >= manager.offset + effective_limit:
            manager.offset = manager.cursor - effective_limit + 1
        manager.offset = min(max(0, manager.offset), max(0, len(ordered) - effective_limit))
        window_start = manager.offset

    # ── Process Table ───────────────────────────────────────────────
    emit("")
    tabs = []
    for i, vm in enumerate(VIEW_MODES):
        if i == view_idx:
            tabs.append(f"{BOLD}{vm['color']}[{vm['key']}] {vm['label']}{RESET}")
        else:
            tabs.append(f"{DIM}[{vm['key']}]{RESET}")
    emit(f" {' '.join(tabs)}")
    emit(f" {CYAN}{'─' * max(1, tw - 2)}{RESET}")

    sort_key = view['sort']
    display_procs = ordered[window_start:window_start + effective_limit]
    if manager is not None:
        manager.visible_rows = [dict(proc) for proc in display_procs]
    total_procs = len(ordered)
    prefix_width = 6 if manager_active else 3
    header_prefix = ' ' * prefix_width
    table_width = tw - (prefix_width - 3)

    def row_prefix(proc, index):
        if not manager_active:
            return '   '
        current = window_start + index == manager.cursor
        checked = str(proc['pid']) in manager.selected
        arrow, box = ('›' if current else ' '), ('x' if checked else ' ')
        color = BYELLOW if current else BGREEN if checked else DIM
        return f" {color}{arrow}[{box}]{RESET} "

    def command_cell(command, width):
        """Truncate/pad the process name without wasting responsive columns."""
        command = str(command)
        if len(command) <= width:
            return f"{command:<{width}}"
        if width <= 1:
            return command[:width]
        return f"{command[:width - 1]}…"

    if table_width < 55:
        # At genuinely tiny widths, retain a useful PID/command/value view.
        command_width = max(6, tw - prefix_width - 8 - 10 - 1)
        sort_label = 'TOTAL' if sort_key == 'total_mem' else sort_key.upper()
        emit(f"{header_prefix}{DIM}{'PID':<8}{'CMD':<{command_width}}{sort_label:>10}{RESET}")
        for index, p in enumerate(display_procs):
            if sort_key == 'pcpu': val = f"{p['pcpu']:.1f}%"
            elif sort_key == 'swap': val = to_human(p['swap'])
            elif sort_key == 'total_mem': val = to_human(p['total_mem'])
            else: val = to_human(p['rss'])
            emit(f"{row_prefix(p, index)}{CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{val:>10}{RESET}")
    elif table_width < 65:
        # Preserve the operator-critical process state, OOM score, and age
        # before optional CPU/thread columns in a cramped pane.
        fixed_width = 7 + 8 + 8 + 4 + 4 + 7  # PID, RSS, SWAP, ST, OOM, AGE
        command_width = max(8, tw - prefix_width - fixed_width - 1)
        emit(f"{header_prefix}{DIM}{'PID':<7}{'COMMAND':<{command_width}}"
             f"{'RSS':>8}{'SWAP':>8}{'ST':>4}{'OOM':>4}{'UP':>7}{RESET}")
        for index, p in enumerate(display_procs):
            oom = p['oom_score']
            oom_c = BRED if oom > 800 else (BYELLOW if oom > 400 else GRAY)
            swap_c = BMAGENTA if p['swap'] > 0 else DIM
            emit(f"{row_prefix(p, index)}{CYAN}{p['pid']:<7}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>8}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>8}{RESET}"
                 f" {fmt_state(p['state'])}"
                 f"{oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>7}{RESET}")
    elif table_width < 90:
        # In the normal split-pane range, keep ST/OOM/AGE and drop MEM%/THR;
        # those are less actionable than knowing whether a process is stopped,
        # OOM-prioritized, and how long it has been alive.
        fixed_width = 8 + 10 + 10 + 7 + 4 + 5 + 8
        command_width = max(8, tw - prefix_width - fixed_width - 1)
        emit(f"{header_prefix}{DIM}{'PID':<8}{'COMMAND':<{command_width}}"
             f"{'RSS':>10}{'SWAP':>10}{'CPU%':>7}{'ST':>4}{'OOM':>5}{'UPTIME':>8}{RESET}")
        for index, p in enumerate(display_procs):
            oom = p['oom_score']
            oom_c = BRED if oom > 800 else (BYELLOW if oom > 400 else GRAY)
            swap_c = BMAGENTA if p['swap'] > 0 else DIM
            emit(f"{row_prefix(p, index)}{CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>10}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>10}{RESET}"
                 f"{BWHITE}{p['pcpu']:>6.1f}{RESET}%"
                 f" {fmt_state(p['state'])}"
                 f" {oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>8}{RESET}")
    else:
        fixed_width = 8 + 10 + 10 + 7 + 7 + 5 + 5 + 5 + 8
        command_width = max(8, tw - prefix_width - fixed_width - 1)
        emit(f"{header_prefix}{DIM}{'PID':<8}{'COMMAND':<{command_width}}"
             f"{'RSS':>10}{'SWAP':>10}{'CPU%':>7}{'MEM%':>7}"
             f"{'THR':>5}{'ST':>5}{'OOM':>5}{'UPTIME':>8}{RESET}")
        for index, p in enumerate(display_procs):
            oom = p['oom_score']
            if oom > 800:
                oom_c = BRED
            elif oom > 400:
                oom_c = BYELLOW
            else:
                oom_c = GRAY

            swap_c = BMAGENTA if p['swap'] > 0 else DIM

            emit(f"{row_prefix(p, index)}{CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>10}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>10}{RESET}"
                 f"{BWHITE}{p['pcpu']:>6.1f}{RESET}%"
                 f"{DIM}{p['pmem']:>6.1f}{RESET}%"
                 f"{DIM}{p['threads']:>5}{RESET}"
                 f" {fmt_state(p['state'])}"
                 f"  {oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>8}{RESET}")

    if not display_procs:
        emit(f"   {GRAY}(no processes found){RESET}")

    # ── Footer ──────────────────────────────────────────────────────
    emit("")
    shown = len(display_procs)
    count_info = (f"{window_start + 1}-{window_start + shown}/{total_procs}"
                  if manager_active and shown else
                  f"{shown}" if shown == total_procs else f"{shown}/{total_procs}")
    footer = (manager_footer_rows(manager, tw, count_info, filter_label)
              if manager_active else footer_rows(tw, count_info, filter_label))
    for row in footer:
        emit(row)

    return "\n".join(lines)


# ── Terminal Raw Mode ─────────────────────────────────────────────────

MOUSE_INPUT_ON = ('\033[?9;1002;1003;1004;1005;1015;1016;1007l'
                  '\033[=0u\033[>4;0m\033[?1000;1006;2004h')
MOUSE_INPUT_OFF = '\033[?9;1000;1002;1003;1004;1005;1006;1015;1016;2004l'
PASTE_START = b'\033[200~'
PASTE_END = b'\033[201~'


def _partial_suffix(data, marker):
    """Keep only a trailing fragment that may complete marker next read."""
    for size in range(min(len(data), len(marker) - 1), 0, -1):
        if data.endswith(marker[:size]):
            return data[-size:]
    return b''


def parse_terminal_input(data, in_paste=False, text=False):
    """Decode navigation and keys; consume mouse/paste packets atomically."""
    keys = []
    pos = 0

    while pos < len(data):
        if in_paste:
            end = data.find(PASTE_END, pos)
            if end < 0:
                return keys, _partial_suffix(data[pos:], PASTE_END), True
            pos = end + len(PASTE_END)
            in_paste = False
            continue

        byte = data[pos]
        if byte != 0x1b:
            # Dashboard commands are ASCII. Ignore other UTF-8 bytes rather
            # than treating part of a multibyte character as a command.
            if byte < 0x80:
                keys.append(chr(byte))
            elif text:
                width = (2 if 0xc2 <= byte <= 0xdf else
                         3 if 0xe0 <= byte <= 0xef else
                         4 if 0xf0 <= byte <= 0xf4 else 1)
                if pos + width > len(data):
                    break
                try:
                    keys.append(data[pos:pos + width].decode('utf-8'))
                except UnicodeDecodeError:
                    pass
                pos += width
                continue
            pos += 1
            continue

        if data.startswith(PASTE_START, pos):
            pos += len(PASTE_START)
            in_paste = True
            continue

        if pos + 1 >= len(data):
            break

        introducer = data[pos + 1]
        if introducer == ord('[') and data[pos:pos + 3] == b'\033[M':
            # X10/VT200 reports have three binary bytes after CSI M. A
            # coordinate can equal an action key; never decode it separately.
            if pos + 6 > len(data):
                break
            pos += 6
        elif introducer == ord('['):
            # CSI: arrows, focus reports, SGR mouse, and extended keys all end
            # with a final byte in the 0x40..0x7e range.
            end = pos + 2
            while end < len(data) and not 0x40 <= data[end] <= 0x7e:
                end += 1
            if end >= len(data):
                break
            sequence = data[pos:end + 1]
            csi_keys = {
                b'\033[A': 'UP', b'\033[B': 'DOWN',
                b'\033[C': 'RIGHT', b'\033[D': 'LEFT',
                b'\033[H': 'HOME', b'\033[F': 'END',
                b'\033[1~': 'HOME', b'\033[4~': 'END',
                b'\033[7~': 'HOME', b'\033[8~': 'END',
                b'\033[5~': 'PAGEUP', b'\033[6~': 'PAGEDOWN',
            }
            if sequence in csi_keys:
                keys.append(csi_keys[sequence])
            elif re.fullmatch(rb'\x1b\[<(64|65);\d+;\d+M', sequence):
                keys.append('WHEEL_UP' if sequence.startswith(b'\033[<64;')
                            else 'WHEEL_DOWN')
            pos = end + 1
        elif introducer == ord('O'):
            # SS3 cursor/function-key form, e.g. ESC O A.
            if pos + 2 >= len(data):
                break
            ss3_keys = {
                ord('A'): 'UP', ord('B'): 'DOWN',
                ord('C'): 'RIGHT', ord('D'): 'LEFT',
                ord('H'): 'HOME', ord('F'): 'END',
            }
            if data[pos + 2] in ss3_keys:
                keys.append(ss3_keys[data[pos + 2]])
            pos += 3
        elif introducer in (ord(']'), ord('P'), ord('_'), ord('^')):
            # OSC replies end in BEL or ST (ESC backslash).
            end = pos + 2
            while end < len(data):
                if data[end] == 0x07:
                    end += 1
                    break
                if data[end:end + 2] == b'\033\\':
                    end += 2
                    break
                end += 1
            else:
                break
            pos = end
        else:
            # Discard an unrecognized ESC prefix but leave the following byte
            # available, preserving commands such as Alt+q as q.
            pos += 1

    return keys, data[pos:], in_paste


class DashboardRenderer:
    """Write changed rows only; an unchanged or paused frame emits no bytes."""
    def __init__(self):
        self.previous = None
        self.size = None
        self.generation = None

    def encode(self, output, size, generation=0):
        width, height = size
        rows = output.split('\n')[:height]
        full = (self.previous is None or self.size != size or
                self.generation != generation)
        previous = [] if full else self.previous
        parts = ['\033[H\033[2J'] if full else []
        for index, row in enumerate(rows):
            if index >= len(previous) or row != previous[index]:
                parts.append(f'\033[{index + 1};1H\033[0m{row}\033[K')
        if len(rows) < len(previous) and len(rows) < height:
            parts.append(f'\033[{len(rows) + 1};1H\033[0m\033[J')
        self.previous, self.size, self.generation = rows, size, generation
        return ''.join(parts)

    def write(self, output, generation=0):
        change = self.encode(output, get_term_size(), generation)
        if change:
            sys.stdout.write(change)
            sys.stdout.flush()


class RawTerminal:
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.old_settings = None
        self.input_buffer = b''
        self.in_paste = False
        self.screen_generation = 0
        self.input_buffer_since = None

    def __enter__(self):
        global _dashboard_terminal_active
        _dashboard_terminal_active = True
        if sys.stdin.isatty():
            import termios
            import tty
            self.old_settings = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write(f'\033[?25l{MOUSE_INPUT_ON}')
            sys.stdout.flush()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        global _dashboard_terminal_active
        _dashboard_terminal_active = False
        if self.old_settings is not None:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
            sys.stdout.write(f'{MOUSE_INPUT_OFF}\033[?25h\033[?1049l')
            sys.stdout.flush()

    def get_chars(self):
        if not sys.stdin.isatty():
            return []

        chunks = []
        while True:
            readable, _, _ = select.select([self.fd], [], [], 0.0)
            if not readable:
                break
            chunk = os.read(self.fd, 4096)
            if not chunk:
                break
            chunks.append(chunk)

        if not chunks:
            if (self.input_buffer == b'\033' and
                    self.input_buffer_since is not None and
                    time.monotonic() - self.input_buffer_since >= 0.08):
                # Keep the prefix to consume a delayed terminal packet safely.
                self.input_buffer_since = None
                return ['ESC']
            return []

        data = self.input_buffer + b''.join(chunks)
        keys, self.input_buffer, self.in_paste = parse_terminal_input(
            data, self.in_paste)
        self.input_buffer_since = time.monotonic() if self.input_buffer else None
        return keys

    def suspend(self):
        if self.old_settings is not None:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
            sys.stdout.write(f'{MOUSE_INPUT_ON}\033[?25h\033[?1049l')
            sys.stdout.flush()

    def resume(self):
        self.screen_generation += 1
        if self.old_settings is not None:
            import tty
            tty.setcbreak(self.fd)
            sys.stdout.write(
                f'\033[?1049h\033[2J\033[H\033[?25l{MOUSE_INPUT_ON}')
            sys.stdout.flush()


# ── Actions: drive forceswap / unswap from the live table ─────────────

def sort_processes(processes, view_idx):
    key = VIEW_MODES[view_idx]['sort']
    return sorted(processes, key=lambda p: p.get(key, 0), reverse=True)


def ordered_processes(processes, view_idx, proc_filter=0, query=''):
    rows = filtered_processes(processes, proc_filter)
    query = query.strip().casefold()
    if query:
        rows = [p for p in rows if any(query in str(p.get(field, '')).casefold()
                for field in ('pid', 'comm', 'raw_comm', 'cmdline', 'user', 'uid'))]
    return sort_processes(rows, view_idx)


def parse_action_size(value):
    match = re.fullmatch(r'(\d+(?:\.\d+)?)\s*([kmgt])(?:i?b)?', value.strip(), re.I)
    if not match:
        raise ValueError('size needs a unit, for example 512M or 2G')
    return int(float(match[1]) * 1024 ** ('kmgt'.index(match[2].casefold()) + 1))


def parse_action_specification(choice):
    try:
        tokens = shlex.split(choice)
    except ValueError as error:
        return None, str(error)
    selectors, excludes = [], []
    maximum, minimum, index = None, 0, 0
    while index < len(tokens):
        token = tokens[index]
        option, equals, value = token.partition('=')
        if option == '--all' and not equals:
            selectors.append('all')
        elif option in {'--except', '--exclude', '--except-bigger-than',
                        '--exclude-above', '--max-rss', '--max-swap', '--min-rss'}:
            if not equals:
                index += 1
                if index >= len(tokens):
                    return None, f'{option} needs a value'
                value = tokens[index]
            if not value:
                return None, f'{option} needs a value'
            if option in {'--except', '--exclude'}:
                excludes.extend(part.strip() for part in value.split(',') if part.strip())
            else:
                try:
                    size = parse_action_size(value)
                except ValueError as error:
                    return None, str(error)
                if option == '--min-rss':
                    minimum = size
                else:
                    maximum = size
        elif token.startswith('-'):
            return None, f'unknown option {token}'
        else:
            selectors.extend(part.strip() for part in token.split(',') if part.strip())
        index += 1
    if not selectors:
        return None, 'select PIDs, exact names, globs, or all'
    is_all = any(part.casefold() == 'all' for part in selectors)
    if is_all and len(selectors) != 1:
        return None, 'all must be used alone; filters may follow it'
    return {'selectors': selectors, 'excludes': excludes, 'maximum': maximum,
            'minimum': minimum, 'all': is_all}, ''


def action_selector_matches(proc, selector):
    if selector.isdigit():
        return int(proc['pid']) == int(selector)
    pattern = selector.casefold()
    names = {str(proc.get(field, '')).casefold() for field in ('comm', 'raw_comm')}
    if any(ch in pattern for ch in '*?['):
        return any(fnmatch.fnmatchcase(name, pattern) for name in names)
    return pattern in names


def resolve_process_selection(choice, processes, view_idx, action):
    spec, error = parse_action_specification(choice)
    if error:
        return [], [], [], error
    ordered = sort_processes(processes, view_idx)
    candidates, unknown = [], []
    if spec['all']:
        candidates = ordered
    else:
        for selector in spec['selectors']:
            matches = [p for p in ordered if action_selector_matches(p, selector)]
            if not matches:
                unknown.append(selector)
            candidates.extend(matches)
    selected, skipped, seen = [], [], set()
    metric = 'swap' if action == 'unswap' else 'rss'
    for proc in candidates:
        pid = str(proc['pid'])
        if pid in seen:
            continue
        seen.add(pid)
        excluded = next((s for s in spec['excludes'] if action_selector_matches(proc, s)), None)
        if excluded is not None:
            skipped.append((proc, f'excluded by {excluded!r}'))
        elif spec['all'] and proc.get('rss', 0) < spec['minimum']:
            skipped.append((proc, 'below --min-rss'))
        elif spec['maximum'] is not None and proc.get(metric, 0) > spec['maximum']:
            skipped.append((proc, f'{metric} exceeds size filter'))
        elif action != 'signal' and proc.get(metric, 0) <= 0:
            skipped.append((proc, 'no swap to recover' if action == 'unswap' else 'no resident memory'))
        else:
            selected.append(proc)
    return selected, unknown, skipped, ''


def resolve_selection(raw, shown):
    selected, _, _, _ = resolve_process_selection(raw, shown, 0, 'signal')
    return [int(proc['pid']) for proc in selected]


def prompt_process_selection(processes, view_idx, proc_limit, action, preselected=None):
    if preselected is None:
        print("PIDs, exact names, globs, or all in this filtered snapshot. Empty cancels.")
        print("Filters: --except names/PIDs/globs --except-bigger-than 2G --min-rss 32M")
        for p in sort_processes(processes, view_idx)[:proc_limit]:
            print(f"  {p['pid']:>8}  {p['comm']}  rss {to_human(p['rss'])}  swap {to_human(p['swap'])}")
        choice = keyboard_input(f'\n{action} which? ').strip()
    else:
        choice = ','.join(str(p['pid']) for p in preselected)
    if not choice:
        print('Cancelled.')
        return []
    selected, unknown, skipped, error = resolve_process_selection(choice, processes, view_idx, action)
    if error:
        print(f'[-] {error}')
    for token in unknown:
        print(f'[-] No snapshot match: {token}')
    for proc, reason in skipped:
        print(f"[*] Skipping {proc['pid']} {proc['comm']}: {reason}")
    if not selected:
        print('[-] No actionable process selected.')
    return selected


def action_identities(processes, expected_identities=None):
    identities = {}
    for proc in processes:
        pid = str(proc['pid'])
        expected = (expected_identities.get(pid) if expected_identities is not None
                    else snapshot_identity(proc))
        current = read_process_identity(pid)
        if int(pid) <= 1 or int(pid) == os.getpid():
            print(f'[-] Refusing PID {pid}.')
        elif expected is None or current is None or expected != current:
            print(f'[-] Skipping PID {pid}: exited, reused, changed owner, or unavailable.')
        else:
            identities[pid] = current
    return identities


def resolved_arguments(identities):
    args = []
    for pid, identity in identities.items():
        args += ['--_resolved', f"{pid}:{identity['start']}:{identity['uid']}"]
    return args


def print_process_selection(selected):
    print(f"[*] {len(selected)} selected · RSS {to_human(sum(p['rss'] for p in selected))}"
          f" · swap {to_human(sum(p['swap'] for p in selected))}")
    for p in selected:
        print(f"  {p['pid']:>8}  {p['comm']}  UID {p.get('uid', '?')}")


def return_to_dashboard(term):
    try:
        keyboard_input(f"\n{DIM}[Enter] return to vminfo{RESET} ")
    except (EOFError, KeyboardInterrupt):
        pass
    finally:
        term.resume()


def run_swap_action(op, processes, view_idx, proc_limit, term,
                    preselected=None, expected_identities=None):
    """Hand confirmed PID/start/UID selections to the existing memory helper."""
    exe = os.path.join(os.path.dirname(os.path.abspath(__file__)), op)
    term.suspend()
    try:
        verb = "Force-swap (evict)" if op == 'forceswap' else "Unswap (fault back)"
        print(f"\n{BOLD}{BCYAN}== {verb} =={RESET}")
        selected = prompt_process_selection(processes, view_idx, proc_limit, op, preselected)
        if not selected:
            return
        print_process_selection(selected)
        print('[!] Applications can stall while their pages move between RAM and swap.')
        if keyboard_input('Confirm [y/N]: ').strip().casefold() not in {'y', 'yes'}:
            print('Cancelled.')
            return
        identities = action_identities(selected, expected_identities)
        if not identities:
            print('[-] No selected process passed identity checks.')
            return
        command = ['sudo', '--', exe, '--yes']
        if any(identity['uid'] != os.getuid() for identity in identities.values()):
            command.append('--system-wide')
        command += resolved_arguments(identities)
        print(f"[>] {op} · {len(identities)} verified PID(s)", flush=True)
        result = subprocess.run(command)
        if result.returncode:
            print(f'[-] {op} exited {result.returncode}.')
    except (EOFError, KeyboardInterrupt):
        print('Cancelled.')
    except OSError as error:
        print(f'[-] Failed to run {op}: {error}')
    finally:
        return_to_dashboard(term)


def normalize_signal(value):
    value = value.strip().upper() or 'TERM'
    if value.startswith('SIG'):
        value = value[3:]
    try:
        signum = int(value) if value.isdigit() else getattr(signal, f'SIG{value}')
        if signum == 0 or signum in signal.valid_signals():
            return signum
    except AttributeError:
        pass
    raise ValueError(f'unknown signal: {value}')


def signal_name(signum):
    try:
        return signal.Signals(signum).name
    except ValueError:
        return f'SIG{int(signum)}'


def signal_snapshot_pids(signum, identities):
    """Bind signals to pidfds; a recycled numeric PID is never a fallback."""
    failed = False
    for pid, expected in identities.items():
        descriptor = None
        try:
            if int(pid) <= 1 or int(pid) == os.getpid():
                raise ValueError(f'refusing PID {pid}')
            descriptor = os.pidfd_open(int(pid), 0)
            if read_process_identity(pid) != expected:
                raise ValueError('process exited, PID reused, or owner changed')
            signal.pidfd_send_signal(descriptor, signum)
            print(f'[+] {signal_name(signum)} sent to PID {pid}.')
        except (AttributeError, OSError, ValueError) as error:
            failed = True
            print(f'[-] PID {pid}: {error}')
        finally:
            if descriptor is not None:
                os.close(descriptor)
    return 1 if failed else 0


def run_guarded_signal_cli(argv):
    import argparse
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument('--_signal', type=int, required=True)
    parser.add_argument('--_resolved', action='append', required=True)
    args = parser.parse_args(argv)
    try:
        signum = normalize_signal(str(args._signal))
        identities = {}
        for token in args._resolved:
            if not re.fullmatch(r'\d+:\d+:\d+', token):
                raise ValueError('invalid resolved PID/start/UID')
            pid, start, uid = token.split(':')
            identities[pid] = {'start': int(start), 'uid': int(uid)}
        return signal_snapshot_pids(signum, identities)
    except ValueError as error:
        print(f'[-] {error}')
        return 2


def run_signal_action(processes, view_idx, proc_limit, term,
                      preselected=None, expected_identities=None):
    term.suspend()
    try:
        print(f"\n{BOLD}{BRED}== Signal selected processes =={RESET}")
        selected = prompt_process_selection(processes, view_idx, proc_limit, 'signal', preselected)
        if not selected:
            return
        sig = normalize_signal(keyboard_input('signal [TERM]: '))
        print_process_selection(selected)
        print(f'[!] Sending {signal_name(sig)} to {len(selected)} selected PID(s).')
        if keyboard_input("Confirm [y/N]: ").strip().casefold() not in {"y", "yes"}:
            print("Cancelled.")
            return
        identities = action_identities(selected, expected_identities)
        if not identities:
            print('[-] No selected process passed identity checks.')
            return
        result = subprocess.run(['sudo', '--', sys.executable, os.path.realpath(__file__),
                                 '--_signal', str(int(sig))] + resolved_arguments(identities),
                                text=True, capture_output=True)
        if result.stdout.strip():
            print(result.stdout.strip())
        if result.returncode:
            print(result.stderr.strip() or f'[-] Signal action exited {result.returncode}.')
    except (EOFError, KeyboardInterrupt):
        print("Cancelled.")
    except (OSError, ValueError) as error:
        print(f'[-] {error}')
    finally:
        return_to_dashboard(term)


def run_zram_action(kind, term):
    """Run a concise, explicit ZRAM action through the installed helper."""
    term.suspend()
    try:
        print(f"\n{BOLD}{BMAGENTA}== ZRAM {kind} =={RESET}")
        if kind == "recompress":
            mode = (keyboard_input("mode [tier1/tier2/tier3/all]: ").strip().casefold()
                    or "tier1")
            if mode not in {"tier1", "tier2", "tier3", "idle", "huge", "huge-idle", "all"}:
                print("[-] Unknown recompression mode.")
                return
            command = ["sudo", "/usr/local/bin/memory-tool-apply", "recompress", mode]
        else:
            mode = (keyboard_input("mode [idle/huge/huge-idle]: ").strip().casefold()
                    or "idle")
            if mode not in {"idle", "huge", "huge-idle", "cold", "incompressible"}:
                print("[-] Unknown writeback mode.")
                return
            command = ["sudo", "/usr/local/bin/memory-tool-apply", "writeback", mode]
        print(f"[>] {' '.join(command)}")
        if keyboard_input("Confirm [y/N]: ").strip().casefold() not in {"y", "yes"}:
            print("Cancelled.")
            return
        result = subprocess.run(command, text=True, capture_output=True)
        output = (result.stdout + result.stderr).strip()
        if output:
            print(output)
        if result.returncode == 0:
            print("[+] ZRAM action finished.")
        else:
            print(f"[-] ZRAM action exited {result.returncode}.")
    except (EOFError, KeyboardInterrupt):
        print("Cancelled.")
    finally:
        try:
            keyboard_input(f"\n{DIM}[Enter] return to vminfo{RESET} ")
        except (EOFError, KeyboardInterrupt):
            pass
        term.resume()


def preferred_proc_limit():
    """Use the available vertical space instead of an arbitrary width gate."""
    _, height = get_term_size()
    return max(10, min(30, height - 30))


def filtered_processes(processes, mode):
    """Match avminfo's quick process filter: all, user-owned, or system."""
    if mode == 1:
        return [p for p in processes if p.get('owned')]
    if mode == 2:
        return [p for p in processes if not p.get('owned')]
    return processes


def prompt_manager_search(term, current=''):
    term.suspend()
    try:
        return keyboard_input(f'Find PID, user, UID, name, or command [{current}]: ').strip()
    except (EOFError, KeyboardInterrupt):
        return current
    finally:
        term.resume()


def run_process_inspector(proc, term, expected_identity=None):
    term.suspend()
    try:
        pid = str(proc['pid'])
        expected = expected_identity or snapshot_identity(proc)
        print(f"\n{BOLD}{BCYAN}== Process inspector: {pid} {proc['comm']} =={RESET}")
        if expected is None or read_process_identity(pid) != expected:
            print('[-] Process exited, PID reused, or owner changed since the snapshot.')
            return
        details = []
        status = _read_proc_field(pid, 'status') or ''
        wanted = {'Name', 'Pid', 'PPid', 'Uid', 'Gid', 'State', 'Threads',
                  'VmPeak', 'VmSize', 'VmHWM', 'VmRSS', 'RssAnon', 'RssFile',
                  'RssShmem', 'VmSwap', 'voluntary_ctxt_switches', 'nonvoluntary_ctxt_switches'}
        details += [line for line in status.splitlines() if line.partition(':')[0] in wanted]
        for field in ('oom_score', 'oom_score_adj', 'wchan', 'cgroup', 'cmdline'):
            value = _read_proc_field(pid, field)
            details.append(f"{field}: {value.replace(chr(0), ' ') if value is not None else '(unavailable)'}")
        for field in ('exe', 'cwd'):
            try:
                value = os.readlink(f'/proc/{pid}/{field}')
            except OSError:
                value = '(unavailable)'
            details.append(f'{field}: {value}')
        if read_process_identity(pid) != expected:
            print('[-] Process changed during inspection; details discarded.')
        else:
            print('\n'.join(details))
    finally:
        return_to_dashboard(term)


class ProcessManager:
    """A frozen process list and selection transaction, independent of paging."""
    def __init__(self):
        self.active = False
        self.processes = []
        self.visible_rows = []
        self.cursor = self.offset = 0
        self.page_size = 1
        self.selected = set()
        self.identities = {}
        self.query = self.notice = ''
        self.was_paused = False

    def enter(self, processes, paused):
        self.active = True
        self.was_paused = paused
        self.processes = [dict(proc) for proc in processes]
        self.cursor = self.offset = 0
        self.selected.clear()
        self.identities.clear()
        self.query = ''
        self.notice = f'Frozen {len(self.processes)} processes. Tick rows with Space.'

    def ordered(self, view_idx, proc_filter):
        return ordered_processes(self.processes, view_idx, proc_filter, self.query)

    def select(self, proc):
        pid = str(proc['pid'])
        expected = snapshot_identity(proc)
        if expected is None or read_process_identity(pid) != expected:
            return False
        self.identities[pid] = expected
        self.selected.add(pid)
        return True

    def handle_key(self, ch, term, view_idx, proc_filter, proc_limit):
        ordered = self.ordered(view_idx, proc_filter)
        maximum = max(0, len(ordered) - 1)
        self.cursor = min(self.cursor, maximum)
        if ch in ('UP', 'WHEEL_UP', 'k'):
            self.cursor = max(0, self.cursor - 1)
        elif ch in ('DOWN', 'WHEEL_DOWN', 'j'):
            self.cursor = min(maximum, self.cursor + 1)
        elif ch in ('PAGEUP', 'LEFT'):
            self.cursor = max(0, self.cursor - self.page_size)
        elif ch in ('PAGEDOWN', 'RIGHT'):
            self.cursor = min(maximum, self.cursor + self.page_size)
        elif ch in ('HOME', 'g'):
            self.cursor = 0
        elif ch in ('END', 'G'):
            self.cursor = maximum
        elif ch == ' ' and ordered:
            proc = ordered[self.cursor]
            pid = str(proc['pid'])
            if pid in self.selected:
                self.selected.remove(pid)
                self.identities.pop(pid, None)
                self.notice = ''
            elif self.select(proc):
                self.notice = ''
            else:
                self.notice = f'PID {pid} changed or exited; start a new snapshot.'
        elif ch in ('a', 'A'):
            count = sum(self.select(proc) for proc in ordered)
            self.notice = f'Selected {count} matching rows.'
            if count != len(ordered):
                self.notice += f' {len(ordered) - count} unavailable.'
        elif ch in ('b', 'B'):
            self.selected.clear()
            self.identities.clear()
            count = sum(self.select(proc) for proc in self.visible_rows)
            self.notice = f'Selected {count} visible rows.'
            if count != len(self.visible_rows):
                self.notice += f' {len(self.visible_rows) - count} unavailable.'
        elif ch in ('c', 'C'):
            self.selected.clear()
            self.identities.clear()
            self.notice = 'Selection cleared.'
        elif ch == '/':
            self.query = prompt_manager_search(term, self.query)
            self.cursor = self.offset = 0
            self.notice = ''
        elif ch in ('1', '2', '3', '4'):
            view_idx = int(ch) - 1
            self.cursor = self.offset = 0
        elif ch in ('v', 'V'):
            proc_filter = (proc_filter + 1) % 3
            self.cursor = self.offset = 0
        elif ch in ('+', '='):
            proc_limit = min(50, proc_limit + 5)
        elif ch in ('-', '_'):
            proc_limit = max(3, proc_limit - 5)
        elif ch in ('i', 'I') and ordered:
            inspected = ordered[self.cursor]
            run_process_inspector(inspected, term, snapshot_identity(inspected))
        elif ch in ('f', 'F', 'u', 'U', 'x', 'X'):
            checked = [proc for proc in sort_processes(self.processes, view_idx)
                       if str(proc['pid']) in self.selected]
            if not checked:
                self.notice = 'Nothing selected; tick rows with Space first.'
            else:
                if ch.casefold() == 'x':
                    run_signal_action(self.processes, view_idx, proc_limit, term,
                                      preselected=checked, expected_identities=self.identities)
                else:
                    op = 'forceswap' if ch.casefold() == 'f' else 'unswap'
                    run_swap_action(op, self.processes, view_idx, proc_limit, term,
                                    preselected=checked, expected_identities=self.identities)
                # A completed or cancelled action ends this selection transaction.
                self.processes = get_enriched_processes()
                self.selected.clear()
                self.identities.clear()
                self.cursor = self.offset = 0
                self.notice = 'Snapshot refreshed; selection cleared.'
        elif ch in ('m', 'M', 'ESC'):
            self.active = False
            self.selected.clear()
            self.identities.clear()
            self.notice = ''
        return view_idx, proc_filter, proc_limit


def print_usage():
    print('''vminfo - Desktop memory and process dashboard

Usage: vminfo [--static] [--low-data | --fast]
Default: 5-second samples, changed rows only; --fast: 0.5-second samples.

Dashboard:
  m             Freeze the process snapshot and enter manager mode
  1-4           Sort by RSS / CPU / Swap / RSS + Swap
  v             Cycle All / User / System processes
  +/-           Show more / fewer process rows
  f / u / k     Choose processes to force-swap / unswap / signal
  r / w         ZRAM recompression / writeback
  Space         Pause / resume
  q             Quit

Manager:
  Up/Down, j/k  Move through the complete frozen list; mouse wheel also moves
  PgUp/PgDn     Move one visible page (Left/Right also work)
  Home/End,g/G  First / last matching process
  Space         Tick / untick the cursor process
  a / c         Select all matching processes / clear selection
  b             Replace selection with only the rows currently shown
  /             Search by PID, user, UID, name, or command line; blank clears
  i             Inspect the cursor process
  f / u / x     Force-swap / unswap / signal checked processes
  1-4, v, +/-   Change sort, process filter, or visible row count
  m / Esc       Leave manager, restoring the prior pause state

Selection survives searches, filters, and sorting. Actions include every
checked row, including rows hidden by a later filter. PID start time and UID
are rechecked before actions. Signals use pidfds to guard against PID reuse.

Typed selections accept PIDs, exact names, globs, or all in the filtered
snapshot, plus --except, --except-bigger-than, and --min-rss. For example:
  all --except eden,codex,python* --except-bigger-than 2G
  'Isolated Web Co'   or   ff:tab*   or   1234,5678

Actions show their targets and require confirmation. The existing forceswap
and unswap helpers retain their warnings, pressure checks, and readback.''')


# ── Main ──────────────────────────────────────────────────────────────

def main():
    if sys.argv[1:2] == ['--_signal']:
        raise SystemExit(run_guarded_signal_cli(sys.argv[1:]))
    low_data = '--fast' not in sys.argv
    if '--help' in sys.argv or '-h' in sys.argv:
        print_usage()
        return
    # Static / non-interactive mode
    if not sys.stdout.isatty() or '--static' in sys.argv or '-s' in sys.argv:
        mem = get_meminfo()
        psi = get_psi()
        zr = get_zram_stats()
        procs = get_enriched_processes(10)
        cpu_pct = 0.0
        temps = get_temps()
        la = get_loadavg()
        up = get_uptime()
        zones, _ = get_watermark_snapshot()
        print(draw_dashboard(mem, psi, zr, 0, False, {}, procs, 10,
                             cpu_pct, temps, la, up, zones, {}))
        return

    # Interactive live mode
    view_idx = 0
    paused = False
    proc_filter = 0
    manager = ProcessManager()
    proc_limit = preferred_proc_limit()
    auto_proc_limit = True
    tracker = DeltaTracker(alpha=0.3)

    # Initialise data BEFORE the loop
    mem = get_meminfo()
    psi = get_psi()
    zr = get_zram_stats()
    deltas = {}
    processes = get_enriched_processes(50)
    zones, vmstat = get_watermark_snapshot()
    vmstat_deltas = {}
    prev_cpu = get_cpu_times()
    cpu_pct = 0.0
    temps = get_temps()
    loadavg = get_loadavg()
    uptime_s = get_uptime()

    # Handle SIGWINCH for immediate resize response
    resized = [False]
    def on_resize(signum, frame):
        resized[0] = True
    try:
        signal.signal(signal.SIGWINCH, on_resize)
    except Exception:
        pass

    # Use alternate screen buffer to keep shell clean
    sys.stdout.write("\033[?1049h")  # enter alt screen
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()

    tick_count = 0
    sample_interval = 5.0 if low_data else 0.5
    next_sample_at = 0.0
    renderer = DashboardRenderer()

    with RawTerminal() as term:
        try:
            while True:
                # Handle input
                quit_requested = False
                for ch in term.get_chars():
                    if ch in ('q', 'Q'):
                        quit_requested = True
                        break
                    if manager.active:
                        if ch in ('+', '=', '-', '_'):
                            auto_proc_limit = False
                        view_idx, proc_filter, proc_limit = manager.handle_key(
                            ch, term, view_idx, proc_filter, proc_limit)
                        processes = manager.processes
                        if not manager.active:
                            paused = manager.was_paused
                            next_sample_at = 0.0
                        continue
                    if ch in ('m', 'M'):
                        manager.enter(processes, paused)
                        paused = True
                    elif ch == '1':
                        view_idx = 0
                    elif ch == '2':
                        view_idx = 1
                    elif ch == '3':
                        view_idx = 2
                    elif ch == '4':
                        view_idx = 3
                    elif ch in ('+', '='):
                        auto_proc_limit = False
                        proc_limit = min(30, proc_limit + 5)
                    elif ch in ('-', '_'):
                        auto_proc_limit = False
                        proc_limit = max(3, proc_limit - 5)
                    elif ch in ('f', 'F'):
                        run_swap_action('forceswap', filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('u', 'U'):
                        run_swap_action('unswap', filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('v', 'V'):
                        proc_filter = (proc_filter + 1) % 3
                    elif ch in ('k', 'K'):
                        run_signal_action(filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('r', 'R'):
                        run_zram_action('recompress', term)
                    elif ch in ('w', 'W'):
                        run_zram_action('writeback', term)
                    elif ch == ' ':
                        paused = not paused

                if quit_requested:
                    break

                if not paused and time.monotonic() >= next_sample_at:
                    next_sample_at = time.monotonic() + sample_interval
                    if auto_proc_limit:
                        proc_limit = preferred_proc_limit()
                    mem = get_meminfo()
                    psi = get_psi()
                    zr = get_zram_stats(zr)
                    loadavg = get_loadavg()
                    uptime_s = get_uptime()
                    zones, vmstat = get_watermark_snapshot()

                    # CPU %
                    cur_cpu = get_cpu_times()
                    cpu_pct = calc_cpu_pct(prev_cpu, cur_cpu) or 0.0
                    prev_cpu = cur_cpu

                    # Temps less frequently (every ~5s)
                    if tick_count % 10 == 0:
                        temps = get_temps()

                    # Processes (slightly less often to reduce load)
                    if tick_count % 2 == 0 or resized[0]:
                        processes = get_enriched_processes(50)

                    avail = mem.get('MemAvailable', 0)
                    total_swap = mem.get('SwapTotal', 0)
                    free_swap = mem.get('SwapFree', 0)
                    delta_values = {
                        'avail_ram': avail,
                        'used_swap': total_swap - free_swap,
                    }
                    delta_values.update(vmstat)
                    deltas = tracker.tick(delta_values)
                    vmstat_deltas = deltas

                    tick_count += 1

                resized[0] = False

                # Redraw
                output = draw_dashboard(mem, psi, zr, view_idx, paused, deltas,
                                        processes, proc_limit, cpu_pct, temps,
                                        loadavg, uptime_s, zones, vmstat_deltas,
                                        proc_filter=proc_filter, manager=manager)
                renderer.write(output, term.screen_generation)

                select.select([term.fd], [], [], 0.2)
        except KeyboardInterrupt:
            pass


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    # Restore terminal on exit
    if sys.stdout.isatty():
        sys.stdout.write('\033[?1049l\033[?25h')
        sys.stdout.flush()
