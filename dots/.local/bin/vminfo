#!/usr/bin/env python3
"""vminfo - Live system performance dashboard.

Shows memory, CPU, swap, pressure, and process data in a responsive,
continuously updating TUI that adapts to terminal size.

Keys:
  1-4    Switch process view (RSS / CPU / Swap / Total)
  +/-    Show more / fewer processes
  f      Force-swap (evict) selected PIDs/names into swap
  u      Unswap (fault back) selected PIDs/names into RAM
  k      Send an explicit signal to selected PIDs
  r      Run ZRAM recompression
  w      Run guarded ZRAM writeback
  Space  Pause
  q      Quit
"""
import sys
import os
import re
import time
import select
import subprocess
import signal
import shutil
import unicodedata
import fcntl

# ── ANSI Escape Codes ──────────────────────────────────────────────────
RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
ITALIC = "\033[3m"
ERASE_EOL = "\033[K"
ERASE_BELOW = "\033[J"

RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
BLUE = "\033[34m"
MAGENTA = "\033[35m"
CYAN = "\033[36m"
GRAY = "\033[90m"
WHITE = "\033[37m"

BRED = "\033[91m"
BGREEN = "\033[92m"
BYELLOW = "\033[93m"
BBLUE = "\033[94m"
BMAGENTA = "\033[95m"
BCYAN = "\033[96m"
BWHITE = "\033[97m"


# ── System constants ───────────────────────────────────────────────────
_CLK_TCK = os.sysconf('SC_CLK_TCK')
_ZRAM_ACTION_LOCK = '/run/lock/vmatlas-zram-tier.lock'

# ── Layout helpers ─────────────────────────────────────────────────────

_tw_cache = (0.0, 80, 24)  # (timestamp, columns, rows)

def get_term_size():
    """Get the current (columns, rows) without retaining a stale dimension."""
    global _tw_cache
    now = time.monotonic()
    if now - _tw_cache[0] > 0.10:
        try:
            sz = os.get_terminal_size(sys.stdout.fileno())
        except Exception:
            sz = shutil.get_terminal_size(fallback=(80, 24))
        cols = max(1, int(sz.columns or os.environ.get('COLUMNS', 80)))
        rows = max(1, int(sz.lines or os.environ.get('LINES', 24)))
        _tw_cache = (now, cols, rows)
    return _tw_cache[1], _tw_cache[2]


def get_term_width():
    return get_term_size()[0]


_ANSI_RE = re.compile(
    r'\033(?:\[[0-?]*[ -/]*[@-~]|\][^\a]*(?:\a|\033\\))'
)

def _char_width(char):
    if unicodedata.combining(char):
        return 0
    return 2 if unicodedata.east_asian_width(char) in ('W', 'F') else 1

def visible_len(text):
    return sum(_char_width(char) for char in _ANSI_RE.sub('', text))

def fit_line(text, tw):
    """Keep each render row inside one terminal line, preserving ANSI state."""
    # Keep one column spare: terminals may auto-wrap a glyph written in the
    # last cell, which turns the next redraw into a shifted, stale-looking UI.
    limit = max(1, tw - 1)
    vis = 0
    out = []
    i = 0
    n = len(text)
    while i < n:
        if text[i] == '\033':
            m = _ANSI_RE.match(text, i)
            if m:
                out.append(m.group(0))
                i = m.end()
                continue
        char_width = _char_width(text[i])
        if vis + char_width > limit:
            break
        out.append(text[i])
        vis += char_width
        i += 1
    out.append(RESET)
    return ''.join(out)

def clamp_line(text, tw):
    return fit_line(text, tw)


def to_human(bytes_val):
    """Convert bytes to human-readable string."""
    val = float(bytes_val)
    for unit in ['B', 'KB', 'MB', 'GB', 'TB']:
        if abs(val) < 1024.0:
            if val >= 100:
                return f"{val:.0f} {unit}"
            elif val >= 10:
                return f"{val:.1f} {unit}"
            return f"{val:.2f} {unit}"
        val /= 1024.0
    return f"{val:.2f} PB"


def fmt_duration(seconds):
    """Format elapsed seconds into human-readable duration."""
    if seconds < 60:
        return f"{int(seconds)}s"
    if seconds < 3600:
        return f"{int(seconds // 60)}m{int(seconds % 60)}s"
    if seconds < 86400:
        h = int(seconds // 3600)
        m = int((seconds % 3600) // 60)
        return f"{h}h{m}m"
    d = int(seconds // 86400)
    h = int((seconds % 86400) // 3600)
    return f"{d}d{h}h"


def make_bar(pct, width=20):
    """Create a colored progress bar that adapts to available width."""
    width = max(5, width)
    filled = int(round(pct * width / 100))
    filled = max(0, min(width, filled))

    if pct < 60:
        fill_color = BGREEN
    elif pct < 85:
        fill_color = BYELLOW
    else:
        fill_color = BRED

    return f"{fill_color}{'█' * filled}{GRAY}{'░' * (width - filled)}{RESET}"


def make_separator(label="", width=None):
    if width is None:
        width = get_term_width()
    if label:
        visual_label_len = visible_len(label) + 2
        dash_len = max(1, width - visual_label_len - 2)
        return f" {BOLD}{BCYAN}{label}{RESET} {CYAN}{'─' * dash_len}{RESET}"
    return f" {CYAN}{'─' * max(1, width - 2)}{RESET}"


def memory_breakdown_cells(mem, avail_ram):
    """Return memory fields in importance order for the responsive grid."""
    free_mem = mem.get('MemFree', 0)
    cached = mem.get('Cached', 0)
    buffers = mem.get('Buffers', 0)
    active = mem.get('Active', 0)
    inactive = mem.get('Inactive', 0)
    dirty = mem.get('Dirty', 0)
    mapped = mem.get('Mapped', 0)
    sreclaim = mem.get('SReclaimable', 0)
    sunreclaim = mem.get('SUnreclaim', 0)
    cache_total = buffers + cached + sreclaim
    anon = mem.get('Active(anon)', 0) + mem.get('Inactive(anon)', 0)
    anon_active = mem.get('Active(anon)', 0)
    anon_inactive = mem.get('Inactive(anon)', 0)
    file_active = mem.get('Active(file)', 0)
    file_inactive = mem.get('Inactive(file)', 0)
    shmem = mem.get('Shmem', 0)
    pagetables = mem.get('PageTables', 0)

    dirty_color = (BRED if dirty > 512 * 1024 * 1024
                   else BYELLOW if dirty > 256 * 1024 * 1024
                   else BWHITE)
    inactive_color = BYELLOW if anon_inactive > 1024 * 1024 * 1024 else BWHITE

    return [
        ("Available", avail_ram, BGREEN),
        ("Anon tot", anon, BWHITE),
        ("Cache tot", cache_total, BGREEN),
        ("Free", free_mem, BGREEN),
        ("Anon active", anon_active, BWHITE),
        ("File active", file_active, WHITE),
        ("Anon inact", anon_inactive, inactive_color),
        ("File inact", file_inactive, BWHITE),
        ("Active", active, BWHITE),
        ("Inactive", inactive, BWHITE),
        ("Cached", cached, WHITE),
        ("Buffers", buffers, WHITE),
        ("Slab recl", sreclaim, BGREEN),
        ("Slab pin", sunreclaim, BYELLOW),
        ("Shmem", shmem, BWHITE),
        ("PageTables", pagetables, BWHITE),
        ("Dirty", dirty, dirty_color),
        ("Mapped", mapped, BWHITE),
    ]


def memory_grid(cells, tw, indent="   "):
    """Pack memory cells into as many readable columns as the terminal allows."""
    if not cells:
        return []

    # Keep the grid dense enough to use three columns on an ordinary split
    # pane.  The previous 12+12 minimum forced an unnecessary two-column grid
    # around 80 columns, consuming rows needed by the process table.
    label_width = max(11, max(visible_len(label) for label, _, _ in cells))
    value_width = max(9, max(visible_len(to_human(value)) for _, value, _ in cells))
    cell_width = label_width + 1 + value_width
    # Keep one spare terminal cell so the final glyph cannot auto-wrap.
    available = max(1, tw - visible_len(indent) - 1)
    min_gap = 3
    columns = max(1, min(len(cells), available // (cell_width + min_gap)))
    remaining = available - columns * cell_width
    gap = 0 if columns == 1 else max(min_gap, remaining // (columns - 1))

    def mem_cell(label, value, color):
        return (f"{CYAN}{label:<{label_width}}{RESET} "
                f"{color}{to_human(value):>{value_width}}{RESET}")

    rendered = []
    for start in range(0, len(cells), columns):
        row = cells[start:start + columns]
        rendered.append(indent + (" " * gap).join(mem_cell(*cell) for cell in row))
    return rendered


# ── Data Collection ────────────────────────────────────────────────────

def get_meminfo():
    data = {}
    try:
        with open('/proc/meminfo', 'r') as f:
            for line in f:
                parts = line.strip().split()
                if not parts:
                    continue
                name = parts[0].rstrip(':')
                if len(parts) == 3 and parts[2].lower() == 'kb':
                    data[name] = int(parts[1]) * 1024
                elif len(parts) == 2:
                    data[name] = int(parts[1])
    except Exception:
        pass
    return data


def get_psi():
    psi = {
        'some': {'avg10': 0.0, 'avg60': 0.0, 'avg300': 0.0},
        'full': {'avg10': 0.0, 'avg60': 0.0, 'avg300': 0.0},
    }
    try:
        with open('/proc/pressure/memory', 'r') as f:
            for line in f:
                parts = line.strip().split()
                if not parts:
                    continue
                kind = parts[0]
                if kind in psi:
                    for part in parts[1:]:
                        if '=' in part:
                            k, v = part.split('=')
                            if k in psi[kind]:
                                psi[kind][k] = float(v)
    except Exception:
        pass
    return psi


def _read_zram_stats_unlocked():
    """Return the live zram tier state without spawning vmatlas.

    vmatlas is the full read-only source of truth.  The small subset here is
    deliberately syscall-light enough for a 2 Hz dashboard refresh.
    """
    stats = {
        'orig': 0, 'compr': 0, 'mem_used': 0, 'mem_limit': 0, 'mem_used_max': 0,
        'same': 0, 'compacted': 0, 'huge': 0, 'huge_since': 0,
        'primary': '?', 'recomp_tiers': [], 'recomp': None,
        'backing': None, 'backing_bytes': 0, 'bd_reads': 0, 'bd_writes': 0,
        'wb_boot_writes': 0,
        'wb_enabled': None, 'wb_limit_bytes': 0, 'compressed_wb': False,
        'disksize': 0,
    }
    base = '/sys/block/zram0'

    def read(path):
        try:
            with open(path) as f:
                return f.read().strip()
        except Exception:
            return ''

    try:
        parts = read(f'{base}/mm_stat').split()
        if len(parts) >= 8:
            stats['orig'] = int(parts[0])
            stats['compr'] = int(parts[1])
            stats['mem_used'] = int(parts[2])
            stats['mem_limit'] = int(parts[3])
            stats['mem_used_max'] = int(parts[4])
            stats['same'] = int(parts[5])
            stats['compacted'] = int(parts[6])
            stats['huge'] = int(parts[7])
            if len(parts) >= 9:
                stats['huge_since'] = int(parts[8])
        elif len(parts) >= 3:
            stats['orig'] = int(parts[0])
            stats['compr'] = int(parts[1])
            stats['mem_used'] = int(parts[2])

        ds = read(f'{base}/disksize')
        if ds.isdigit():
            stats['disksize'] = int(ds)

        if stats['mem_limit'] == 0:
            ml = read(f'{base}/mem_limit')
            if ml.isdigit() and int(ml) > 0:
                stats['mem_limit'] = int(ml)

        def selected(value):
            for item in value.split():
                if item.startswith('[') and item.endswith(']'):
                    return item[1:-1]
            return value.split()[-1] if value.split() else '?'

        stats['primary'] = selected(read(f'{base}/comp_algorithm'))

        level_state = {}
        for state_line in read('/run/vmatlas-tier/levels').splitlines():
            if '=' in state_line:
                key, value = state_line.split('=', 1)
                level_state[key] = value
        recomp_raw = read(f'{base}/recomp_algorithm')
        tiers = []
        if recomp_raw:
            for line in recomp_raw.replace('\x00', '\n').splitlines():
                line = line.strip()
                if line.startswith('#'):
                    prio_num = line.split(':')[0]
                    sel = selected(line)
                    priority = prio_num[1:]
                    spec = level_state.get(f'tier{priority}')
                    verified = spec and spec.split(':', 1)[0] == sel
                    tiers.append(f"{spec} ({prio_num}, verified)" if verified else
                                 f"{sel} ({prio_num}, level unverified)")
        stats['recomp_tiers'] = tiers
        stats['recomp'] = ' → '.join(tiers) if tiers else None

        backing = read(f'{base}/backing_dev')
        stats['backing'] = backing if backing and backing != 'none' else None
        bd = read(f'{base}/bd_stat').split()
        if bd:
            stats['backing_bytes'] = int(bd[0]) * 4096
            if len(bd) >= 2:
                stats['bd_reads'] = int(bd[1])
            if len(bd) >= 3:
                stats['bd_writes'] = int(bd[2])
                stats['wb_boot_writes'] = stats['bd_writes']
        boot_writes = read('/run/vmatlas-tier/writeback_pages')
        if boot_writes.isdigit():
            stats['wb_boot_writes'] = max(stats['wb_boot_writes'], int(boot_writes))
        enabled = read(f'{base}/writeback_limit_enable')
        stats['wb_enabled'] = enabled == '1' if enabled else None
        limit = read(f'{base}/writeback_limit')
        if limit.isdigit():
            stats['wb_limit_bytes'] = int(limit) * 4096
        cwb = read(f'{base}/compressed_writeback')
        stats['compressed_wb'] = (cwb == '1' or cwb.lower() == 'yes')
    except Exception:
        pass
    return stats


def get_zram_stats(previous=None):
    """Read ZRAM stats without allowing a tier action to freeze the TUI.

    The memory-tools wrapper holds the ZRAM action lock for the duration of a
    recompression/writeback operation.  ZRAM sysfs readers can sleep in the
    kernel while that operation is running, so take a non-blocking shared lock
    first.  If it is busy, return the last sample and let the dashboard label
    it as stale; all other telemetry continues to refresh normally.
    """
    fd = None
    try:
        fd = os.open(_ZRAM_ACTION_LOCK, os.O_RDONLY | os.O_CLOEXEC)
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except (BlockingIOError, OSError) as exc:
            if isinstance(exc, BlockingIOError) or getattr(exc, 'errno', None) in (11, 35):
                stats = dict(previous or {})
                stats['busy'] = True
                stats['sample_time'] = stats.get('sample_time')
                return stats
            raise
    except OSError:
        # If the optional coordination file is absent, preserve legacy
        # read-only behavior.  Normal memory-tools actions always create it.
        return _read_zram_stats_unlocked()

    try:
        stats = _read_zram_stats_unlocked()
        stats['busy'] = False
        stats['sample_time'] = time.monotonic()
        return stats
    finally:
        try:
            fcntl.flock(fd, fcntl.LOCK_UN)
        finally:
            os.close(fd)


def get_vm_knobs():
    """Read VM tunables and sysctl knobs."""
    keys = (
        'swappiness', 'page-cluster', 'vfs_cache_pressure',
        'dirty_background_bytes', 'dirty_background_ratio',
        'dirty_bytes', 'dirty_ratio',
        'dirty_expire_centisecs', 'dirty_writeback_centisecs',
        'dirtytime_expire_seconds',
        'min_free_kbytes', 'watermark_scale_factor', 'watermark_boost_factor',
        'compaction_proactiveness', 'extfrag_threshold', 'zone_reclaim_mode',
        'lowmem_reserve_ratio', 'overcommit_memory', 'overcommit_ratio',
        'overcommit_kbytes', 'max_map_count', 'admin_reserve_kbytes',
        'user_reserve_kbytes', 'page_lock_unfairness',
        'percpu_pagelist_high_fraction',
    )
    knobs = {}
    for key in keys:
        try:
            with open(f'/proc/sys/vm/{key}') as f:
                val = f.read().strip()
                if '\t' in val or ' ' in val:
                    knobs[key] = val
                elif val.isdigit() or (val.startswith('-') and val[1:].isdigit()):
                    knobs[key] = int(val)
                else:
                    knobs[key] = val
        except Exception:
            knobs[key] = None
    return knobs


def fmt_swap_knobs(knobs, tw=120):
    parts = []
    sw = knobs.get('swappiness')
    if sw is not None:
        parts.append(f"{DIM}swappiness{RESET} {BWHITE}{sw}{RESET}")
    cluster = knobs.get('page-cluster')
    if cluster is not None:
        parts.append(f"{DIM}cluster{RESET} {BWHITE}{cluster}{RESET}")
    vfs = knobs.get('vfs_cache_pressure')
    if vfs is not None:
        parts.append(f"{DIM}vfs_cache_pressure{RESET} {BWHITE}{vfs}{RESET}")
    if tw >= 100:
        max_map = knobs.get('max_map_count')
        if max_map is not None:
            try:
                m = int(max_map)
                mm_str = f"{m/1000000:.2f}M" if m >= 1000000 else f"{m}"
                parts.append(f"{DIM}max_map_count{RESET} {BWHITE}{mm_str}{RESET}")
            except Exception:
                parts.append(f"{DIM}max_map_count{RESET} {BWHITE}{max_map}{RESET}")
        oc = knobs.get('overcommit_memory')
        ocr = knobs.get('overcommit_ratio')
        if oc is not None:
            oc_mode = {0: 'heuristic', 1: 'always', 2: 'strict'}.get(int(oc) if str(oc).isdigit() else -1, str(oc))
            if ocr is not None and tw >= 115:
                parts.append(f"{DIM}overcommit{RESET} {BWHITE}{oc}{RESET} {DIM}({oc_mode}, {ocr}%){RESET}")
            else:
                parts.append(f"{DIM}overcommit{RESET} {BWHITE}{oc}{RESET} {DIM}({oc_mode}){RESET}")
    return f" {DIM}     {' · '.join(parts)}{RESET}"


def fmt_dirty_knobs(knobs, tw=120):
    bg_bytes = knobs.get('dirty_background_bytes')
    bg_ratio = knobs.get('dirty_background_ratio')
    d_bytes = knobs.get('dirty_bytes')
    d_ratio = knobs.get('dirty_ratio')

    if d_bytes and int(d_bytes) > 0:
        limit_str = to_human(int(d_bytes))
    elif d_ratio is not None:
        limit_str = f"{d_ratio}%"
    else:
        limit_str = "?"

    if bg_bytes and int(bg_bytes) > 0:
        bg_str = to_human(int(bg_bytes))
    elif bg_ratio is not None:
        bg_str = f"{bg_ratio}%"
    else:
        bg_str = "?"

    wb_cs = knobs.get('dirty_writeback_centisecs')
    exp_cs = knobs.get('dirty_expire_centisecs')
    dtime_s = knobs.get('dirtytime_expire_seconds')

    def fmt_cs(cs):
        if cs is None: return '?'
        s = int(cs) / 100.0
        return f"{s:.0f}s" if s >= 10 else f"{s:.1f}s"

    def fmt_sec(s):
        if s is None: return '?'
        s = int(s)
        if s >= 3600: return f"{s//3600}h"
        if s >= 60: return f"{s//60}m"
        return f"{s}s"

    parts = [f"{DIM}dirty bg/limit{RESET} {BWHITE}{bg_str}/{limit_str}{RESET}"]
    if exp_cs is not None:
        parts.append(f"{DIM}expire{RESET} {BWHITE}{fmt_cs(exp_cs)}{RESET}")
    if wb_cs is not None:
        parts.append(f"{DIM}writeback{RESET} {BWHITE}{fmt_cs(wb_cs)}{RESET}")
    if dtime_s is not None and tw >= 100:
        parts.append(f"{DIM}dirtytime{RESET} {BWHITE}{fmt_sec(dtime_s)}{RESET}")

    return f"   {' · '.join(parts)}"


def zone_knob_parts(knobs, tw=120):
    parts = []
    mf = knobs.get('min_free_kbytes')
    if mf is not None:
        try:
            m = int(mf) * 1024
            parts.append(f"{DIM}min_free{RESET} {BWHITE}{to_human(m)}{RESET}")
        except Exception:
            parts.append(f"{DIM}min_free{RESET} {BWHITE}{mf} KB{RESET}")

    ws = knobs.get('watermark_scale_factor')
    if ws is not None:
        try:
            pct = int(ws) / 100.0
            parts.append(f"{DIM}wmark_scale{RESET} {BWHITE}{ws}{RESET} {DIM}({pct:.2f}%){RESET}")
        except Exception:
            parts.append(f"{DIM}wmark_scale{RESET} {BWHITE}{ws}{RESET}")

    wb = knobs.get('watermark_boost_factor')
    if wb is not None:
        try:
            pct = int(wb) / 100.0
            if pct > 0:
                parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET} {DIM}({pct:.0f}%){RESET}")
            else:
                parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET}")
        except Exception:
            parts.append(f"{DIM}boost_factor{RESET} {BWHITE}{wb}{RESET}")

    cp = knobs.get('compaction_proactiveness')
    if cp is not None:
        parts.append(f"{DIM}compaction{RESET} {BWHITE}{cp}{RESET}")

    ef = knobs.get('extfrag_threshold')
    if ef is not None and tw >= 110:
        parts.append(f"{DIM}extfrag{RESET} {BWHITE}{ef}{RESET}")

    zr = knobs.get('zone_reclaim_mode')
    if zr is not None and tw >= 120:
        parts.append(f"{DIM}zone_reclaim{RESET} {BWHITE}{zr}{RESET}")

    if tw >= 145:
        lm = knobs.get('lowmem_reserve_ratio')
        if lm:
            lm_clean = '/'.join(lm.split()[:3])
            parts.append(f"{DIM}lowmem_reserve{RESET} {BWHITE}{lm_clean}{RESET}")

    return parts


def fmt_zone_knobs(knobs, tw=120):
    return f"   {' · '.join(zone_knob_parts(knobs, tw))}"


def get_watermark_snapshot():
    """Read zone and reclaim counters from local /proc."""
    zones = []
    node = None
    zone = None
    fields = {}
    try:
        with open('/proc/zoneinfo') as f:
            for raw in f:
                line = raw.strip()
                match = re.match(r'Node\s+(\d+),\s+zone\s+(\S+)', line)
                if match:
                    if zone and fields.get('managed', 0) > 0:
                        zones.append({'node': node, 'name': zone, **fields})
                    node, zone = int(match.group(1)), match.group(2)
                    fields = {}
                    continue
                match = re.match(r'pages free\s+(\d+)$', line)
                if match and zone:
                    fields['free'] = int(match.group(1))
                    continue
                match = re.match(r'(min|low|high|boost|promo|spanned|present|managed|cma)\s+(\d+)$', line)
                if match and zone:
                    fields[match.group(1)] = int(match.group(2))
                    continue
                match = re.match(r'protection:\s*\((.*?)\)', line)
                if match and zone:
                    fields['protection'] = match.group(1)
                    continue
                match = re.match(r'(nr_zspages|nr_zone_write_pending)\s+(\d+)$', line)
                if match and zone:
                    fields[match.group(1)] = int(match.group(2))
                    continue
        if zone and fields.get('managed', 0) > 0:
            zones.append({'node': node, 'name': zone, **fields})
    except Exception:
        pass

    counters = {}
    wanted = {
        'pgscan_kswapd', 'pgscan_kswapd_normal', 'pgscan_direct',
        'pgsteal_kswapd', 'pgsteal_direct', 'kswapd_low_wmark_hit_quickly',
        'allocstall', 'allocstall_normal', 'allocstall_movable',
    }
    try:
        with open('/proc/vmstat') as f:
            for line in f:
                key, _, value = line.partition(' ')
                if key in wanted and value.strip().isdigit():
                    counters[key] = int(value.strip())
    except Exception:
        pass
    return zones, counters


def watermark_bar(zone, width=20):
    """Terminal counterpart to the free-meter with min/low markers."""
    high = max(zone.get('high', 0), 1)
    scale = max(high, zone.get('free', 0), 1)
    free_at = min(width, int(round(zone.get('free', 0) * width / scale)))
    min_at = min(width - 1, int(round(zone.get('min', 0) * width / scale)))
    low_at = min(width - 1, int(round(zone.get('low', 0) * width / scale)))
    color = BRED if zone.get('free', 0) <= zone.get('min', 0) else (
        BYELLOW if zone.get('free', 0) <= zone.get('low', 0) else BGREEN
    )
    out = []
    for index in range(width):
        if index == min_at:
            out.append(f"{BRED}│{RESET}")
        elif index == low_at:
            out.append(f"{BYELLOW}│{RESET}")
        elif index < free_at:
            out.append(f"{color}█{RESET}")
        else:
            out.append(f"{GRAY}░{RESET}")
    return ''.join(out)


def kswapd_verdict(zones, vmstat_deltas):
    """Classify current zone-watermark and reclaim pressure."""
    min_breached = any(z.get('free', 0) <= z.get('min', -1) for z in zones)
    low_breached = any(z.get('free', 0) <= z.get('low', -1) for z in zones)
    scan = vmstat_deltas.get('pgscan_kswapd')
    if scan is None:
        scan = vmstat_deltas.get('pgscan_kswapd_normal')
    steal = vmstat_deltas.get('pgsteal_kswapd')
    low_hit = vmstat_deltas.get('kswapd_low_wmark_hit_quickly')
    direct = vmstat_deltas.get('pgscan_direct')

    if min_breached:
        return f" {BRED}free below min — kswapd thrashing, kills likely{RESET}"
    if low_breached and (scan or 0) > 0:
        steal_info = f", {steal:.0f} steal/s" if (steal or 0) > 0 else ""
        return f" {BYELLOW}below low watermark — kswapd reclaiming ({scan:.0f} scan/s{steal_info}){RESET}"
    if (direct or 0) > 0:
        return f" {BYELLOW}direct reclaim active ({direct:.0f} scan/s){RESET}"
    if (low_hit or 0) > 0:
        return f" {BYELLOW}low watermark hit repeatedly — kswapd waking often ({low_hit:.0f}/s){RESET}"
    return f" {BGREEN}free above low watermark — kswapd idle{RESET}"


def get_loadavg():
    """Read load average and running/total tasks."""
    try:
        with open('/proc/loadavg', 'r') as f:
            parts = f.read().strip().split()
            running, total = parts[3].split('/')
            return {
                'l1': float(parts[0]),
                'l5': float(parts[1]),
                'l15': float(parts[2]),
                'running': int(running),
                'total': int(total),
            }
    except Exception:
        return {'l1': 0, 'l5': 0, 'l15': 0, 'running': 0, 'total': 0}


def get_cpu_times():
    """Read aggregate CPU times from /proc/stat."""
    try:
        with open('/proc/stat', 'r') as f:
            line = f.readline().strip()
        parts = line.split()
        # user, nice, system, idle, iowait, irq, softirq, steal
        vals = [int(x) for x in parts[1:9]]
        return vals
    except Exception:
        return None


def calc_cpu_pct(prev, cur):
    """Calculate CPU usage percentage from two snapshots."""
    if prev is None or cur is None:
        return None
    prev_idle = prev[3] + prev[4]  # idle + iowait
    cur_idle = cur[3] + cur[4]
    prev_total = sum(prev)
    cur_total = sum(cur)
    dtotal = cur_total - prev_total
    didle = cur_idle - prev_idle
    if dtotal == 0:
        return 0.0
    return ((dtotal - didle) / dtotal) * 100.0


def get_temps():
    """Read CPU and GPU temps from /sys or lm-sensors."""
    temps = {}
    # CPU: k10temp / coretemp
    for base in ['/sys/class/hwmon']:
        try:
            for hwmon in os.listdir(base):
                name_path = os.path.join(base, hwmon, 'name')
                if not os.path.exists(name_path):
                    continue
                with open(name_path) as f:
                    name = f.read().strip()
                if name in ('k10temp', 'coretemp'):
                    # Read Tctl / temp1
                    for tfile in ('temp1_input', 'temp2_input'):
                        tp = os.path.join(base, hwmon, tfile)
                        if os.path.exists(tp):
                            with open(tp) as f:
                                temps['cpu'] = int(f.read().strip()) / 1000.0
                            break
                elif name == 'amdgpu':
                    # GPU edge temp
                    tp = os.path.join(base, hwmon, 'temp1_input')
                    if os.path.exists(tp):
                        with open(tp) as f:
                            temps['gpu'] = int(f.read().strip()) / 1000.0
        except Exception:
            pass
    return temps


def get_uptime():
    """System uptime in seconds."""
    try:
        with open('/proc/uptime') as f:
            return float(f.read().strip().split()[0])
    except Exception:
        return 0


def get_nproc():
    try:
        return os.cpu_count() or 1
    except Exception:
        return 1


# ── Process collection ─────────────────────────────────────────────────

def _read_proc_field(pid, field_path):
    """Read a single value from /proc/PID/..."""
    try:
        with open(f'/proc/{pid}/{field_path}') as f:
            return f.read().strip()
    except Exception:
        return None


def _display_comm(pid, comm):
    """Give Firefox's otherwise ambiguous content processes useful labels."""
    firefox_comms = {
        'firefox', 'Isolated Web Content', 'Isolated Service Worker',
        'Privileged Content', 'WebExtensions', 'RDD Process',
        'Socket Process', 'Utility Process', 'forkserver',
    }
    # /proc/PID/comm is limited to 15 bytes, hence Firefox's content name is
    # commonly the truncated "Isolated Web Co" rather than its full title.
    firefox_like = comm in firefox_comms or comm.startswith(
        ('Isolated ', 'Privileged ')
    )
    if not firefox_like:
        return comm

    cmdline = _read_proc_field(pid, 'cmdline')
    if not cmdline or '/firefox/' not in cmdline:
        return comm

    if '-contentproc' not in cmdline:
        return 'firefox'

    # Firefox appends e.g. "203 tab" to its content-process command line.
    # Preserve that identity in the table without parsing fragile full args.
    child_match = re.search(r'(?:^|\s)(\d+)\s+(tab|rdd|socket|utility)\s*\0*$', cmdline)
    if child_match:
        child_id, role = child_match.groups()
        return f"ff:{role}#{child_id}"
    return 'ff:content'


def get_enriched_processes(limit=10):
    """Collect rich per-process data by reading ps numeric fields and /proc.

    Returns list of dicts with keys:
      pid, comm, rss, vsz, swap, pcpu, pmem, state, nice, threads,
      oom_score, elapsed (seconds), total_mem (rss+swap)
    """
    try:
        # Do not request ``comm`` here: Firefox names such as "Isolated Web
        # Content" contain spaces.  Splitting that output used to make every
        # content process look malformed and silently dropped it from vminfo.
        out = subprocess.check_output(
            ['ps', 'axo', 'pid,rss,vsz,pcpu,pmem,stat,nice,nlwp,etimes',
             '--sort=-rss', '--no-headers'],
            text=True, stderr=subprocess.DEVNULL,
        )
    except Exception:
        return []

    processes = []
    seen_pids = set()
    for line in out.strip().split('\n'):
        parts = line.split()
        if len(parts) < 9:
            continue
        pid = parts[0]
        if pid in seen_pids:
            continue
        seen_pids.add(pid)

        try:
            rss = int(parts[1]) * 1024
            vsz = int(parts[2]) * 1024
            pcpu = float(parts[3])
            pmem = float(parts[4])
            state = parts[5]
            nice = parts[6]
            threads = int(parts[7])
            elapsed = int(parts[8])
        except (ValueError, IndexError):
            continue

        comm = _read_proc_field(pid, 'comm') or '?'
        comm = _display_comm(pid, comm)

        # Use inexpensive status counters to separate anonymous resident RAM,
        # file-backed mappings, and swapped pages. This avoids a full smaps
        # walk for every process on each refresh.
        swap = 0
        rss_anon = 0
        rss_file = 0
        rss_shmem = 0
        oom = 0
        uid = None
        try:
            status_text = _read_proc_field(pid, 'status')
            if status_text:
                for sline in status_text.split('\n'):
                    if sline.startswith('Uid:'):
                        uid = int(sline.split()[1])
                    elif sline.startswith('VmSwap:'):
                        swap = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssAnon:'):
                        rss_anon = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssFile:'):
                        rss_file = int(sline.split()[1]) * 1024
                    elif sline.startswith('RssShmem:'):
                        rss_shmem = int(sline.split()[1]) * 1024
        except Exception:
            uid = None

        # OOM score
        try:
            oom_str = _read_proc_field(pid, 'oom_score')
            if oom_str:
                oom = int(oom_str)
        except Exception:
            pass

        # Cumulative CPU time (utime + stime from /proc/pid/stat)
        cputime_s = 0.0
        try:
            stat_raw = _read_proc_field(pid, 'stat')
            if stat_raw:
                # Split on ')' to skip comm field (may contain spaces)
                after_comm = stat_raw.split(')', 1)[1].split()
                # utime is field 14, stime is field 15 (1-indexed from start)
                # After splitting past comm: index 11=utime, 12=stime
                utime = int(after_comm[11])
                stime = int(after_comm[12])
                cputime_s = (utime + stime) / _CLK_TCK
        except Exception:
            pass

        processes.append({
            'pid': pid,
            'comm': comm,
            'rss': rss,
            'vsz': vsz,
            'swap': swap,
            'rss_anon': rss_anon,
            'rss_file': rss_file,
            'rss_shmem': rss_shmem,
            'pcpu': pcpu,
            'pmem': pmem,
            'state': state,
            'nice': nice,
            'threads': threads,
            'oom_score': oom,
            'elapsed': elapsed,
            'total_mem': rss + swap,
            'cputime_s': cputime_s,
            'uid': uid,
            'owned': uid == os.getuid(),
        })

    return processes


# Process state descriptions
STATE_MAP = {
    'R': ('RUN', BGREEN),
    'S': ('SLP', GRAY),
    'D': ('D/W', BRED),
    'Z': ('ZMB', BRED),
    'T': ('STP', BYELLOW),
    't': ('TRC', BYELLOW),
    'I': ('IDL', GRAY),
}

def fmt_state(raw):
    """Format process state character with color and label."""
    base = raw[0] if raw else '?'
    label, color = STATE_MAP.get(base, (base, WHITE))
    return f"{color}{label}{RESET}"


# ── Delta Tracker ──────────────────────────────────────────────────────

class DeltaTracker:
    def __init__(self, alpha=0.3):
        self.alpha = alpha
        self._prev = {}
        self._ema = {}
        self._prev_time = time.time()

    def tick(self, values):
        now = time.time()
        dt = now - self._prev_time
        if dt < 0.05:
            return {k: self._ema.get(k) for k in values}

        deltas = {}
        for key, current in values.items():
            if key in self._prev:
                raw_rate = (current - self._prev[key]) / dt
                if key in self._ema:
                    self._ema[key] = (self.alpha * raw_rate
                                      + (1 - self.alpha) * self._ema[key])
                else:
                    self._ema[key] = raw_rate
                deltas[key] = self._ema[key]
            else:
                deltas[key] = None
            self._prev[key] = current

        self._prev_time = now
        return deltas


# ── View modes ─────────────────────────────────────────────────────────

VIEW_MODES = [
    {'key': '1', 'sort': 'rss',       'label': 'Resident RAM', 'icon': '💾', 'color': BCYAN},
    {'key': '2', 'sort': 'pcpu',      'label': 'CPU Hogs',     'icon': '🔥', 'color': BRED},
    {'key': '3', 'sort': 'swap',      'label': 'Swap Hogs',    'icon': '🔄', 'color': BMAGENTA},
    {'key': '4', 'sort': 'total_mem', 'label': 'RAM + Swap',   'icon': '📊', 'color': BYELLOW},
]


# ── Dashboard Rendering ───────────────────────────────────────────────

def draw_dashboard(mem, psi, zr, view_idx, paused, deltas, processes,
                   proc_limit, cpu_pct, temps, loadavg, uptime_s,
                   zones=None, vmstat_deltas=None):
    """Render the complete dashboard, adapting to terminal width AND height."""
    lines = []
    tw, th = get_term_size()

    def emit(text):
        # The dashboard redraws from cursor-home.  Clear the rest of every row
        # so a shorter next sample cannot leave text or separator fragments
        # from the preceding frame on screen.
        lines.append(f"{fit_line(text, tw)}{ERASE_EOL}")

    def emit_packed(prefix, items, separator=" · ", continuation=None):
        """Wrap ordered telemetry items instead of silently clipping the tail."""
        if not items:
            return
        continuation = prefix if continuation is None else continuation
        limit = max(1, tw - 1)
        current = prefix
        for item in items:
            candidate = (current + separator + item
                         if current != prefix else current + item)
            if current != prefix and visible_len(candidate) > limit:
                emit(current)
                current = continuation + item
            else:
                current = candidate
        if current != prefix:
            emit(current)

    is_tiny = tw < 65
    is_narrow = 65 <= tw < 90
    # Reserve room for the labels and telemetry, then let the graph grow with
    # the terminal instead of freezing it at the old 20/25-cell width.
    bar_w = max(8, min(120, tw - 85))
    view = VIEW_MODES[view_idx]
    zones = zones or []
    vmstat_deltas = vmstat_deltas or {}
    vm_knobs = get_vm_knobs()
    memory_cells = memory_breakdown_cells(mem, mem.get('MemAvailable', 0))
    memory_grid_lines = memory_grid(memory_cells, tw)

    has_zram = zr.get('orig', 0) > 0
    zram_busy = bool(zr.get('busy'))
    display_zones = sorted(zones, key=lambda z: z.get('managed', 0), reverse=True)[:3]

    # Section visibility decisions based on terminal size
    show_sublines = not is_tiny and th >= 28
    show_top_hogs = not is_tiny and th >= 30
    show_breakdown = not is_tiny and th >= 32
    show_dirty_knobs = show_breakdown and th >= 35
    show_zones = not is_tiny and th >= 40 and tw >= 75 and bool(display_zones)
    show_zone_knobs = show_zones and th >= 44

    # ── Header ──────────────────────────────────────────────────────
    status = (f"{BRED}⏸  PAUSED{RESET}" if paused else f"{BGREEN}●  LIVE{RESET}")
    if is_tiny:
        emit(f" {BOLD}{BCYAN}⚡vminfo{RESET} {status}")
    else:
        uptxt = fmt_duration(uptime_s) if uptime_s else ""
        emit(f" {BOLD}{BCYAN}⚡ vminfo{RESET}  {status}  {DIM}up {uptxt}{RESET}")
    emit(f" {CYAN}{'━' * max(1, tw - 2)}{RESET}")

    # ── CPU, load, and temperatures ──────────────────────────────────
    ncpu = get_nproc()
    cpu_str = f"{cpu_pct:.0f}%" if cpu_pct is not None else "…"
    load_color = BGREEN
    if loadavg['l1'] > ncpu * 0.85:
        load_color = BRED
    elif loadavg['l1'] > ncpu * 0.5:
        load_color = BYELLOW

    cpu_bar_pct = min(cpu_pct or 0, 100)
    if is_tiny:
        emit(f" {BOLD}🖥  CPU{RESET}  {make_bar(cpu_bar_pct, bar_w)} {BWHITE}{cpu_str}{RESET}")
        emit(f"        {DIM}load{RESET} {load_color}{loadavg['l1']:.1f}{RESET} {DIM}{loadavg['l5']:.1f} {loadavg['l15']:.1f} ({ncpu}c){RESET}")
    else:
        temp_parts = []
        if 'cpu' in temps:
            t = temps['cpu']
            tc = BRED if t > 80 else (BYELLOW if t > 65 else BGREEN)
            temp_parts.append(f"{DIM}cpu{RESET} {tc}{t:.0f}°C{RESET}")
        if 'gpu' in temps:
            t = temps['gpu']
            tc = BRED if t > 85 else (BYELLOW if t > 70 else BGREEN)
            temp_parts.append(f"{DIM}gpu{RESET} {tc}{t:.0f}°C{RESET}")
        temp_str = f"  {'  '.join(temp_parts)}" if temp_parts else ""

        emit(f" {BOLD}🖥  CPU{RESET}   {make_bar(cpu_bar_pct, bar_w)}  "
             f"{BWHITE}{cpu_str:>5}{RESET}  "
             f"{DIM}load{RESET} {load_color}{loadavg['l1']:.2f}{RESET}"
             f"/{loadavg['l5']:.2f}/{loadavg['l15']:.2f}"
             f" {DIM}({ncpu}c, {loadavg['running']}/{loadavg['total']}){RESET}"
             f"{temp_str}")

    # ── RAM ─────────────────────────────────────────────────────────
    total_ram = mem.get('MemTotal', 1)
    avail_ram = mem.get('MemAvailable', 0)
    used_ram = total_ram - avail_ram
    ram_pct = (used_ram / total_ram) * 100 if total_ram else 0

    avail_ratio = avail_ram / total_ram if total_ram > 0 else 0
    if avail_ratio > 0.30:
        ram_tag = f"{BGREEN}▲ Healthy{RESET}"
    elif avail_ratio > 0.12:
        ram_tag = f"{BYELLOW}▶ Warning{RESET}"
    else:
        ram_tag = f"{BRED}▼ Critical{RESET}"

    ram_delta_str = f"{GRAY}→ stable{RESET}"
    d = deltas.get('avail_ram')
    if d is not None:
        if d > 512 * 1024:
            ram_delta_str = f"{BGREEN}↗ +{to_human(d)}/s{RESET}"
        elif d < -512 * 1024:
            ram_delta_str = f"{BRED}↘ {to_human(abs(d))}/s{RESET}"

    if is_tiny:
        emit(f" {BOLD}💾 RAM{RESET}  {make_bar(ram_pct, bar_w)} {BWHITE}{ram_pct:.0f}%{RESET}")
        emit(f"        {DIM}{to_human(used_ram)}/{to_human(total_ram)}{RESET} {ram_tag}")
    else:
        emit(f" {BOLD}💾 RAM{RESET}   {make_bar(ram_pct, bar_w)}  "
             f"{BWHITE}{ram_pct:5.1f}%{RESET}  "
             f"{DIM}{to_human(used_ram)} / {to_human(total_ram)}{RESET}  "
             f"{ram_tag}  {ram_delta_str}")

    # ── Swap ────────────────────────────────────────────────────────
    total_swap = mem.get('SwapTotal', 0)
    free_swap = mem.get('SwapFree', 0)
    used_swap = total_swap - free_swap
    swap_pct = (used_swap / total_swap) * 100 if total_swap > 0 else 0

    if swap_pct < 50:
        swap_tag = f"{BGREEN}▲ Good{RESET}"
    elif swap_pct < 85:
        swap_tag = f"{BYELLOW}▶ Caution{RESET}"
    else:
        swap_tag = f"{BRED}▼ Low{RESET}"

    swap_delta_str = f"{GRAY}→ stable{RESET}"
    d = deltas.get('used_swap')
    if d is not None:
        if d > 512 * 1024:
            swap_delta_str = f"{BRED}↗ +{to_human(d)}/s{RESET}"
        elif d < -512 * 1024:
            swap_delta_str = f"{BGREEN}↘ {to_human(abs(d))}/s{RESET}"

    swap_bar = make_bar(swap_pct, bar_w) if total_swap > 0 else f"{GRAY}{'░' * bar_w}{RESET}"
    if is_tiny:
        emit(f" {BOLD}🔄 Swp{RESET}  {swap_bar} {BWHITE}{swap_pct:.0f}%{RESET}")
        emit(f"        {DIM}{to_human(used_swap)}/{to_human(total_swap)}{RESET} {swap_tag}")
    else:
        emit(f" {BOLD}🔄 Swap{RESET}  {swap_bar}  "
             f"{BWHITE}{swap_pct:5.1f}%{RESET}  "
             f"{DIM}{to_human(used_swap)} / {to_human(total_swap)}{RESET}  "
             f"{swap_tag}  {swap_delta_str}")
        if show_sublines:
            emit(fmt_swap_knobs(vm_knobs, tw))

    # ── ZRAM ────────────────────────────────────────────────────────
    if has_zram:
        raw_ratio = zr['orig'] / zr['compr'] if zr['compr'] > 0 else 1.0
        phys_ratio = zr['orig'] / zr['mem_used'] if zr['mem_used'] > 0 else 1.0
        if phys_ratio >= 2.5:
            zr_tag = f"{BGREEN}▲ Efficient{RESET}"
        elif phys_ratio >= 1.5:
            zr_tag = f"{BYELLOW}▶ Moderate{RESET}"
        else:
            zr_tag = f"{BRED}▼ Inefficient{RESET}"

        zram_items = [
            f"{BWHITE}{phys_ratio:.2f}x phys{RESET} {DIM}({raw_ratio:.2f}x raw){RESET}",
            f"{DIM}{to_human(zr['orig'])} → {to_human(zr['mem_used'])}{RESET}",
            zr_tag,
        ]
        primary = zr.get('primary') or '?'
        recomp = zr.get('recomp_tiers') or []
        if recomp:
            # Keep the target identity, not the verbose verification prose.
            target = str(recomp[0]).split(' ', 1)[0]
            zram_items.append(f"{DIM}{primary}→{target}{RESET}")
        elif primary != '?':
            zram_items.append(f"{DIM}{primary}{RESET}")
        if zr.get('backing'):
            wb_name = os.path.basename(zr['backing'])
            wb_state = (f"budget {to_human(zr['wb_limit_bytes'])}"
                        if zr.get('wb_limit_bytes') else
                        "locked" if zr.get('wb_enabled') else "unlimited")
            wb_on_dev = to_human(zr['backing_bytes']) if zr.get('backing_bytes') else '0 B'
            zram_items.append(f"{DIM}wb {wb_name} {wb_on_dev} {wb_state}{RESET}")
        if zram_busy:
            zram_items.append(f"{BYELLOW}⏳ action running; last sample{RESET}")
        emit_packed(
            f" {BOLD}🗜  ZRAM{RESET}  ",
            zram_items,
            separator="  ",
            continuation="      ",
        )
    elif zram_busy:
        emit(f" {BOLD}🗜  ZRAM{RESET}  {BYELLOW}⏳ action running; counters will resume when it finishes{RESET}")

    # ── PSI ─────────────────────────────────────────────────────────
    s10 = psi['some']['avg10']
    s60 = psi['some']['avg60']
    s300 = psi['some']['avg300']
    f10 = psi['full']['avg10']

    if s10 > 5.0 or f10 > 2.0:
        psi_tag = f"{BRED}▼ Stalling!{RESET}"
    elif s10 > 0.0:
        psi_tag = f"{BYELLOW}▶ Mild{RESET}"
    else:
        psi_tag = f"{BGREEN}▲ Smooth{RESET}"

    if is_tiny:
        emit(f" {BOLD}⏱  PSI{RESET}  {BWHITE}{s10:.1f}{RESET}/{s60:.1f}/{s300:.1f}%  {psi_tag}")
    else:
        emit(f" {BOLD}⏱  PSI{RESET}   "
             f"avg10/60/300: {BWHITE}{s10:.2f}{RESET}/{s60:.2f}/{s300:.2f}%"
             f"  {psi_tag}")

    # ── Top Hogs (compact one-liner) ─────────────────────────────────
    if show_top_hogs and processes:
        top_mem = max(processes, key=lambda p: p.get('total_mem', 0))
        top_cpu = max(processes, key=lambda p: p.get('pcpu', 0))
        top_burn = max(processes, key=lambda p: p.get('cputime_s', 0))
        top_swp = max(processes, key=lambda p: p.get('swap', 0))

        parts = []
        # Always show heaviest memory consumer
        parts.append(f"{BWHITE}{top_mem['comm'][:14]}{RESET} {BCYAN}{to_human(top_mem['total_mem'])}{RESET} {DIM}mem{RESET}")

        # CPU% — skip if same process as mem leader
        if top_cpu['pid'] != top_mem['pid'] and top_cpu.get('pcpu', 0) > 1.0:
            parts.append(f"{BWHITE}{top_cpu['comm'][:14]}{RESET} {BRED}{top_cpu['pcpu']:.0f}%{RESET} {DIM}cpu{RESET}")
        elif top_cpu.get('pcpu', 0) > 1.0:
            parts.append(f"{BRED}{top_cpu['pcpu']:.0f}%{RESET} {DIM}cpu{RESET}")

        # Cumulative CPU burn — skip if same as mem or cpu leader
        seen_pids = {top_mem['pid'], top_cpu['pid']}
        if top_burn['pid'] not in seen_pids and top_burn.get('cputime_s', 0) > 60:
            parts.append(f"{BWHITE}{top_burn['comm'][:14]}{RESET} {BYELLOW}{fmt_duration(top_burn['cputime_s'])}{RESET} {DIM}burn{RESET}")
        elif top_burn.get('cputime_s', 0) > 60:
            parts.append(f"{BYELLOW}{fmt_duration(top_burn['cputime_s'])}{RESET} {DIM}burn{RESET}")

        # Swap — only if there's meaningful swap and different process
        seen_pids.add(top_burn['pid'])
        if top_swp.get('swap', 0) > 0:
            if top_swp['pid'] not in seen_pids:
                parts.append(f"{BWHITE}{top_swp['comm'][:14]}{RESET} {BMAGENTA}{to_human(top_swp['swap'])}{RESET} {DIM}swp{RESET}")
            else:
                parts.append(f"{BMAGENTA}{to_human(top_swp['swap'])}{RESET} {DIM}swp{RESET}")

        emit(f" {DIM}🏋 top:{RESET}  {f' {DIM}·{RESET} '.join(parts)}")

    # ── Memory Breakdown ────────────────────────────────────────────
    if show_breakdown:
        emit("")
        emit(make_separator("📊 Memory Breakdown", tw))
        for row in memory_grid_lines:
            emit(row)

        if show_dirty_knobs:
            emit(fmt_dirty_knobs(vm_knobs, tw))

    # ── Zones & watermarks ───────────────────────────────────────────
    if show_zones and display_zones:
        emit(make_separator("🛟 Zones & watermarks", tw))
        emit(kswapd_verdict(display_zones, vmstat_deltas))
        if tw >= 135:
            zw = 25
        elif tw >= 110:
            zw = 16
        else:
            zw = 10

        for zone in display_zones:
            free = zone.get('free', 0)
            minimum = zone.get('min', 0)
            low = zone.get('low', 0)
            high = zone.get('high', 0)
            managed = zone.get('managed', 0)
            promo = zone.get('promo', 0)
            boost = zone.get('boost', 0)

            if free <= minimum:
                state = f"{BRED}min breached{RESET}"
            elif free <= low:
                state = f"{BYELLOW}below low (kswapd awake){RESET}"
            else:
                state = f"{BGREEN}comfortable{RESET}"

            pages_to_bytes = 4096
            zparts = [
                state,
                f"F {to_human(free * pages_to_bytes)}",
                f"min {to_human(minimum * pages_to_bytes)}",
                f"low {to_human(low * pages_to_bytes)}",
                f"high {to_human(high * pages_to_bytes)}"
            ]
            if boost > 0:
                zparts.append(f"boost {to_human(boost * pages_to_bytes)}")
            if tw >= 115 and managed > 0:
                zparts.append(f"managed {to_human(managed * pages_to_bytes)}")
            if tw >= 145 and promo > 0:
                zparts.append(f"promo {to_human(promo * pages_to_bytes)}")

            z_prefix = (f" {CYAN}N{zone.get('node', '?')} "
                        f"{zone.get('name', '?'):<7}{RESET} "
                        f"{watermark_bar(zone, zw)} ")
            emit_packed(z_prefix, zparts, separator=" · ", continuation="      ")

        if show_zone_knobs:
            emit_packed("   ", zone_knob_parts(vm_knobs, tw),
                        separator=" · ", continuation="   ")

    # The upper dashboard now wraps telemetry according to the live width.
    # Measure the rendered lines directly so process rows fill only genuinely
    # unused height instead of relying on stale fixed-line estimates.
    table_chrome = 6  # blank, tabs, rule, header, blank, footer
    max_procs_by_height = max(1, th - len(lines) - table_chrome)
    effective_limit = min(proc_limit, max_procs_by_height)

    # ── Process Table ───────────────────────────────────────────────
    emit("")
    tabs = []
    for i, vm in enumerate(VIEW_MODES):
        if i == view_idx:
            tabs.append(f"{BOLD}{vm['color']}[{vm['key']}]{vm['icon']} {vm['label']}{RESET}")
        else:
            tabs.append(f"{DIM}[{vm['key']}]{RESET}")
    emit(f" {' '.join(tabs)}")
    emit(f" {CYAN}{'─' * max(1, tw - 2)}{RESET}")

    # Sort processes
    sort_key = view['sort']
    if sort_key == 'pcpu':
        sorted_procs = sorted(processes, key=lambda p: p.get('pcpu', 0), reverse=True)
    elif sort_key == 'swap':
        sorted_procs = sorted(processes, key=lambda p: p.get('swap', 0), reverse=True)
    elif sort_key == 'total_mem':
        sorted_procs = sorted(processes, key=lambda p: p.get('total_mem', 0), reverse=True)
    else:
        sorted_procs = sorted(processes, key=lambda p: p.get('rss', 0), reverse=True)

    display_procs = sorted_procs[:effective_limit]
    total_procs = len(sorted_procs)

    def command_cell(command, width):
        """Truncate/pad the process name without wasting responsive columns."""
        command = str(command)
        if len(command) <= width:
            return f"{command:<{width}}"
        if width <= 1:
            return command[:width]
        return f"{command[:width - 1]}…"

    if tw < 55:
        # At genuinely tiny widths, retain a useful PID/command/value view.
        command_width = max(6, tw - 3 - 8 - 10 - 1)
        sort_label = 'TOTAL' if sort_key == 'total_mem' else sort_key.upper()
        emit(f"   {DIM}{'PID':<8}{'CMD':<{command_width}}{sort_label:>10}{RESET}")
        for p in display_procs:
            if sort_key == 'pcpu': val = f"{p['pcpu']:.1f}%"
            elif sort_key == 'swap': val = to_human(p['swap'])
            elif sort_key == 'total_mem': val = to_human(p['total_mem'])
            else: val = to_human(p['rss'])
            emit(f"   {CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{val:>10}{RESET}")
    elif tw < 65:
        # Preserve the operator-critical process state, OOM score, and age
        # before optional CPU/thread columns in a cramped pane.
        fixed_width = 7 + 8 + 8 + 4 + 4 + 7  # PID, RSS, SWAP, ST, OOM, AGE
        command_width = max(8, tw - 3 - fixed_width - 1)
        emit(f"   {DIM}{'PID':<7}{'COMMAND':<{command_width}}"
             f"{'RSS':>8}{'SWAP':>8}{'ST':>4}{'OOM':>4}{'UP':>7}{RESET}")
        for p in display_procs:
            oom = p['oom_score']
            oom_c = BRED if oom > 800 else (BYELLOW if oom > 400 else GRAY)
            swap_c = BMAGENTA if p['swap'] > 0 else DIM
            emit(f"   {CYAN}{p['pid']:<7}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>8}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>8}{RESET}"
                 f" {fmt_state(p['state'])}"
                 f"{oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>7}{RESET}")
    elif tw < 90:
        # In the normal split-pane range, keep ST/OOM/AGE and drop MEM%/THR;
        # those are less actionable than knowing whether a process is stopped,
        # OOM-prioritized, and how long it has been alive.
        fixed_width = 8 + 10 + 10 + 7 + 4 + 5 + 8
        command_width = max(8, tw - 3 - fixed_width - 1)
        emit(f"   {DIM}{'PID':<8}{'COMMAND':<{command_width}}"
             f"{'RSS':>10}{'SWAP':>10}{'CPU%':>7}{'ST':>4}{'OOM':>5}{'UPTIME':>8}{RESET}")
        for p in display_procs:
            oom = p['oom_score']
            oom_c = BRED if oom > 800 else (BYELLOW if oom > 400 else GRAY)
            swap_c = BMAGENTA if p['swap'] > 0 else DIM
            emit(f"   {CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>10}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>10}{RESET}"
                 f"{BWHITE}{p['pcpu']:>6.1f}{RESET}%"
                 f" {fmt_state(p['state'])}"
                 f" {oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>8}{RESET}")
    else:
        fixed_width = 8 + 10 + 10 + 7 + 7 + 5 + 5 + 5 + 8
        command_width = max(8, tw - 3 - fixed_width - 1)
        emit(f"   {DIM}{'PID':<8}{'COMMAND':<{command_width}}"
             f"{'RSS':>10}{'SWAP':>10}{'CPU%':>7}{'MEM%':>7}"
             f"{'THR':>5}{'ST':>5}{'OOM':>5}{'UPTIME':>8}{RESET}")
        for p in display_procs:
            oom = p['oom_score']
            if oom > 800:
                oom_c = BRED
            elif oom > 400:
                oom_c = BYELLOW
            else:
                oom_c = GRAY

            swap_c = BMAGENTA if p['swap'] > 0 else DIM

            emit(f"   {CYAN}{p['pid']:<8}{RESET}"
                 f"{command_cell(p['comm'], command_width)}"
                 f"{BWHITE}{to_human(p['rss']):>10}{RESET}"
                 f"{swap_c}{to_human(p['swap']):>10}{RESET}"
                 f"{BWHITE}{p['pcpu']:>6.1f}{RESET}%"
                 f"{DIM}{p['pmem']:>6.1f}{RESET}%"
                 f"{DIM}{p['threads']:>5}{RESET}"
                 f" {fmt_state(p['state'])}"
                 f"  {oom_c}{oom:>4}{RESET}"
                 f"{DIM}{fmt_duration(p['elapsed']):>8}{RESET}")

    if not display_procs:
        emit(f"   {GRAY}(no processes found){RESET}")

    # ── Footer ──────────────────────────────────────────────────────
    emit("")
    shown = len(display_procs)
    count_info = f"{shown}" if shown == total_procs else f"{shown}/{total_procs}"
    if is_tiny:
        if tw < 55:
            emit(f" {DIM}q{RESET}Quit {DIM}1-4{RESET}View {DIM}v{RESET}Filter {DIM}+/-{RESET}{count_info} {BMAGENTA}f{RESET}/{BGREEN}u{RESET} {BRED}k{RESET} {BMAGENTA}r{RESET}/{BCYAN}w{RESET} {DIM}⎵{RESET}Pause")
        else:
            emit(f" {DIM}[q]{RESET} Quit {DIM}[1-4]{RESET} View {DIM}[v]{RESET} Filter {DIM}[+/-]{RESET} {count_info} {BMAGENTA}[f]{RESET} swap {BGREEN}[u]{RESET} unsw {BRED}[k]{RESET} sig {BMAGENTA}[r]{RESET} recomp {BCYAN}[w]{RESET} wb {DIM}[⎵]{RESET} pause")
    elif tw < 90:
        emit(f" {DIM}[q]{RESET} Quit  {DIM}[1-4]{RESET} View  {DIM}[v]{RESET} Filter  {DIM}[+/-]{RESET} {count_info}  {BMAGENTA}[f]{RESET} swap  {BGREEN}[u]{RESET} unsw  {BRED}[k]{RESET} sig  {BMAGENTA}[r]{RESET} recomp  {BCYAN}[w]{RESET} wb  {DIM}[⎵]{RESET} pause")
    else:
        emit(f" {DIM}[q]{RESET} Quit  {DIM}[1-4]{RESET} View  {DIM}[v]{RESET} Filter  {DIM}[+/-]{RESET} Showing {count_info}  {BMAGENTA}[f]{RESET} swap  {BGREEN}[u]{RESET} unsw  {BRED}[k]{RESET} sig  {BMAGENTA}[r]{RESET} recomp  {BCYAN}[w]{RESET} wb  {DIM}[Space]{RESET} pause")

    return "\n".join(lines)


# ── Terminal Raw Mode ─────────────────────────────────────────────────

MOUSE_INPUT_ON = '\033[?1000h\033[?1006h\033[?2004h'
MOUSE_INPUT_OFF = '\033[?2004l\033[?1006l\033[?1000l'
PASTE_START = b'\033[200~'
PASTE_END = b'\033[201~'


def _partial_suffix(data, marker):
    """Keep only a trailing fragment that may complete marker next read."""
    for size in range(min(len(data), len(marker) - 1), 0, -1):
        if data.endswith(marker[:size]):
            return data[-size:]
    return b''


def parse_terminal_input(data, in_paste=False):
    """Return command keys while consuming terminal control/mouse events.

    Kitty sends scroll actions as cursor-key escape sequences on the alternate
    screen. Mouse tracking sends SGR mouse events instead. Consume either form
    as a complete event so neither can leave bytes queued ahead of real
    keyboard commands. Bracketed paste is ignored as well, preventing a
    middle-click paste from accidentally invoking dashboard actions.
    """
    keys = []
    pos = 0

    while pos < len(data):
        if in_paste:
            end = data.find(PASTE_END, pos)
            if end < 0:
                return keys, _partial_suffix(data[pos:], PASTE_END), True
            pos = end + len(PASTE_END)
            in_paste = False
            continue

        byte = data[pos]
        if byte != 0x1b:
            # Dashboard commands are ASCII. Ignore other UTF-8 bytes rather
            # than treating part of a multibyte character as a command.
            if byte < 0x80:
                keys.append(chr(byte))
            pos += 1
            continue

        if data.startswith(PASTE_START, pos):
            pos += len(PASTE_START)
            in_paste = True
            continue

        if pos + 1 >= len(data):
            break

        introducer = data[pos + 1]
        if introducer == ord('['):
            # CSI: arrows, focus reports, SGR mouse, and extended keys all end
            # with a final byte in the 0x40..0x7e range.
            end = pos + 2
            while end < len(data) and not 0x40 <= data[end] <= 0x7e:
                end += 1
            if end >= len(data):
                break
            pos = end + 1
        elif introducer == ord('O'):
            # SS3 cursor/function-key form, e.g. ESC O A.
            if pos + 2 >= len(data):
                break
            pos += 3
        elif introducer == ord(']'):
            # OSC replies end in BEL or ST (ESC backslash).
            end = pos + 2
            while end < len(data):
                if data[end] == 0x07:
                    end += 1
                    break
                if data[end:end + 2] == b'\033\\':
                    end += 2
                    break
                end += 1
            else:
                break
            pos = end
        else:
            # Discard an unrecognized ESC prefix but leave the following byte
            # available, preserving commands such as Alt+q as q.
            pos += 1

    return keys, data[pos:], in_paste


class RawTerminal:
    def __init__(self):
        self.fd = sys.stdin.fileno()
        self.old_settings = None
        self.input_buffer = b''
        self.in_paste = False

    def __enter__(self):
        if sys.stdin.isatty():
            import termios
            import tty
            self.old_settings = termios.tcgetattr(self.fd)
            tty.setcbreak(self.fd)
            sys.stdout.write(f'\033[?25l{MOUSE_INPUT_ON}')
            sys.stdout.flush()
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        if self.old_settings is not None:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
            sys.stdout.write(f'{MOUSE_INPUT_OFF}\033[?25h\033[?1049l')
            sys.stdout.flush()

    def get_chars(self):
        if not sys.stdin.isatty():
            return []

        chunks = []
        while True:
            readable, _, _ = select.select([self.fd], [], [], 0.0)
            if not readable:
                break
            chunk = os.read(self.fd, 4096)
            if not chunk:
                break
            chunks.append(chunk)

        if not chunks:
            return []

        data = self.input_buffer + b''.join(chunks)
        keys, self.input_buffer, self.in_paste = parse_terminal_input(
            data, self.in_paste)
        return keys

    def suspend(self):
        if self.old_settings is not None:
            import termios
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_settings)
            sys.stdout.write(f'{MOUSE_INPUT_OFF}\033[?25h\033[?1049l')
            sys.stdout.flush()

    def resume(self):
        if self.old_settings is not None:
            import tty
            tty.setcbreak(self.fd)
            sys.stdout.write(
                f'\033[?1049h\033[2J\033[H\033[?25l{MOUSE_INPUT_ON}')
            sys.stdout.flush()


# ── Actions: drive forceswap / unswap from the live table ─────────────

def sort_processes(processes, view_idx):
    key = VIEW_MODES[view_idx]['sort']
    return sorted(processes, key=lambda p: p.get(key, 0), reverse=True)


def resolve_selection(raw, shown):
    """Map a typed selection to PIDs against the currently shown rows.

    Accepts raw PIDs, comm substrings, and 'all' (= everything on screen).
    """
    raw = raw.strip()
    if not raw:
        return []
    pids = []
    seen = set()

    def add(pid):
        if pid > 0 and pid not in seen:
            seen.add(pid)
            pids.append(pid)

    for tok in re.split(r'[,\s]+', raw):
        if not tok:
            continue
        if tok.lower() == 'all':
            for p in shown:
                add(int(p['pid']))
        elif tok.isdigit():
            add(int(tok))
        else:
            for p in shown:
                if tok.lower() in p['comm'].lower():
                    add(int(p['pid']))
    return pids


def run_swap_action(op, processes, view_idx, proc_limit, term):
    """Suspend the TUI, run `sudo <op> <pids>`, then resume."""
    exe = os.path.join(os.path.dirname(os.path.abspath(__file__)), op)
    shown = sort_processes(processes, view_idx)[:proc_limit]

    term.suspend()
    try:
        verb = "Force-swap (evict)" if op == 'forceswap' else "Unswap (fault back)"
        print(f"\n{BOLD}{BCYAN}== {verb} =={RESET}")
        print(f"{DIM}Type PIDs and/or names from the table, or 'all'. "
              f"Empty to cancel.{RESET}")
        for p in shown[:proc_limit]:
            print(f"  {CYAN}{p['pid']:>8}{RESET}  {p['comm'][:24]:<24}"
                  f"  {DIM}rss {to_human(p['rss'])}  swap {to_human(p['swap'])}{RESET}")
        try:
            raw = input(f"\n{op} which? ")
        except (EOFError, KeyboardInterrupt):
            raw = ""

        pids = resolve_selection(raw, shown)
        if not pids:
            print("Cancelled.")
        else:
            print(f"{BOLD}-> sudo {op} {' '.join(str(p) for p in pids)}{RESET}")
            try:
                subprocess.run(["sudo", exe, "-y"] + [str(p) for p in pids])
            except Exception as e:
                print(f"[-] Failed to run {op}: {e}")

        try:
            input(f"\n{DIM}[Enter] return to vminfo{RESET} ")
        except (EOFError, KeyboardInterrupt):
            pass
    finally:
        term.resume()


def run_signal_action(processes, view_idx, proc_limit, term):
    """Send one explicitly chosen signal to selected caller-owned PIDs."""
    shown = sort_processes(processes, view_idx)[:proc_limit]
    term.suspend()
    try:
        print(f"\n{BOLD}{BRED}== Signal process =={RESET}")
        print(f"{DIM}Enter PID/name/all, then a signal (default TERM). Empty cancels.{RESET}")
        raw = input("signal which? ").strip()
        pids = resolve_selection(raw, shown)
        if not pids:
            print("Cancelled.")
            return
        sig_raw = input("signal [TERM]: ").strip().upper() or "TERM"
        if sig_raw.startswith("SIG"):
            sig_raw = sig_raw[3:]
        sig = getattr(signal, f"SIG{sig_raw}", None)
        if not isinstance(sig, signal.Signals):
            print(f"[-] Unknown signal: {sig_raw}")
            return
        print(f"[!] Sending SIG{sig_raw} to {len(pids)} PID(s): {' '.join(map(str, pids))}")
        if input("Confirm [y/N]: ").strip().casefold() not in {"y", "yes"}:
            print("Cancelled.")
            return
        result = subprocess.run(["sudo", "kill", f"-{sig.value}"] + [str(p) for p in pids],
                                text=True, capture_output=True)
        if result.returncode:
            print(result.stderr.strip() or f"[-] kill exited {result.returncode}")
        else:
            print(f"[+] SIG{sig_raw} sent to {len(pids)} PID(s).")
    except (EOFError, KeyboardInterrupt):
        print("Cancelled.")
    finally:
        try:
            input(f"\n{DIM}[Enter] return to vminfo{RESET} ")
        except (EOFError, KeyboardInterrupt):
            pass
        term.resume()


def run_zram_action(kind, term):
    """Run a concise, explicit ZRAM action through the installed helper."""
    term.suspend()
    try:
        print(f"\n{BOLD}{BMAGENTA}== ZRAM {kind} =={RESET}")
        if kind == "recompress":
            mode = (input("mode [tier1/tier2/tier3/all]: ").strip().casefold()
                    or "tier1")
            if mode not in {"tier1", "tier2", "tier3", "idle", "huge", "huge-idle", "all"}:
                print("[-] Unknown recompression mode.")
                return
            command = ["sudo", "/usr/local/bin/memory-tool-apply", "recompress", mode]
        else:
            mode = (input("mode [idle/huge/huge-idle]: ").strip().casefold()
                    or "idle")
            if mode not in {"idle", "huge", "huge-idle", "cold", "incompressible"}:
                print("[-] Unknown writeback mode.")
                return
            command = ["sudo", "/usr/local/bin/memory-tool-apply", "writeback", mode]
        print(f"[>] {' '.join(command)}")
        if input("Confirm [y/N]: ").strip().casefold() not in {"y", "yes"}:
            print("Cancelled.")
            return
        result = subprocess.run(command, text=True, capture_output=True)
        output = (result.stdout + result.stderr).strip()
        if output:
            print(output)
        if result.returncode == 0:
            print("[+] ZRAM action finished.")
        else:
            print(f"[-] ZRAM action exited {result.returncode}.")
    except (EOFError, KeyboardInterrupt):
        print("Cancelled.")
    finally:
        try:
            input(f"\n{DIM}[Enter] return to vminfo{RESET} ")
        except (EOFError, KeyboardInterrupt):
            pass
        term.resume()


def preferred_proc_limit():
    """Use the available vertical space instead of an arbitrary width gate."""
    _, height = get_term_size()
    return max(10, min(30, height - 30))


def filtered_processes(processes, mode):
    """Match avminfo's quick process filter: all, user-owned, or system."""
    if mode == 1:
        return [p for p in processes if p.get('owned')]
    if mode == 2:
        return [p for p in processes if not p.get('owned')]
    return processes


# ── Main ──────────────────────────────────────────────────────────────

def main():
    # Static / non-interactive mode
    if not sys.stdout.isatty() or '--static' in sys.argv or '-s' in sys.argv:
        mem = get_meminfo()
        psi = get_psi()
        zr = get_zram_stats()
        procs = get_enriched_processes(10)
        cpu_pct = 0.0
        temps = get_temps()
        la = get_loadavg()
        up = get_uptime()
        zones, _ = get_watermark_snapshot()
        print(draw_dashboard(mem, psi, zr, 0, False, {}, procs, 10,
                             cpu_pct, temps, la, up, zones, {}))
        return

    # Interactive live mode
    view_idx = 0
    paused = False
    proc_filter = 0
    proc_limit = preferred_proc_limit()
    auto_proc_limit = True
    tracker = DeltaTracker(alpha=0.3)

    # Initialise data BEFORE the loop
    mem = get_meminfo()
    psi = get_psi()
    zr = get_zram_stats()
    deltas = {}
    processes = get_enriched_processes(50)
    zones, vmstat = get_watermark_snapshot()
    vmstat_deltas = {}
    prev_cpu = get_cpu_times()
    cpu_pct = 0.0
    temps = get_temps()
    loadavg = get_loadavg()
    uptime_s = get_uptime()

    # Handle SIGWINCH for immediate resize response
    resized = [False]
    def on_resize(signum, frame):
        resized[0] = True
    try:
        signal.signal(signal.SIGWINCH, on_resize)
    except Exception:
        pass

    # Use alternate screen buffer to keep shell clean
    sys.stdout.write("\033[?1049h")  # enter alt screen
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()

    tick_count = 0

    with RawTerminal() as term:
        try:
            while True:
                # Handle input
                quit_requested = False
                for ch in term.get_chars():
                    if ch in ('q', 'Q'):
                        quit_requested = True
                        break
                    elif ch == '1':
                        view_idx = 0
                    elif ch == '2':
                        view_idx = 1
                    elif ch == '3':
                        view_idx = 2
                    elif ch == '4':
                        view_idx = 3
                    elif ch in ('+', '='):
                        auto_proc_limit = False
                        proc_limit = min(30, proc_limit + 5)
                    elif ch in ('-', '_'):
                        auto_proc_limit = False
                        proc_limit = max(3, proc_limit - 5)
                    elif ch in ('f', 'F'):
                        run_swap_action('forceswap', filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('u', 'U'):
                        run_swap_action('unswap', filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('v', 'V'):
                        proc_filter = (proc_filter + 1) % 3
                    elif ch in ('k', 'K'):
                        run_signal_action(filtered_processes(processes, proc_filter), view_idx, proc_limit, term)
                        processes = get_enriched_processes(50)
                    elif ch in ('r', 'R'):
                        run_zram_action('recompress', term)
                    elif ch in ('w', 'W'):
                        run_zram_action('writeback', term)
                    elif ch == ' ':
                        paused = not paused

                if quit_requested:
                    break

                if not paused:
                    if auto_proc_limit:
                        proc_limit = preferred_proc_limit()
                    mem = get_meminfo()
                    psi = get_psi()
                    zr = get_zram_stats()
                    loadavg = get_loadavg()
                    uptime_s = get_uptime()
                    zones, vmstat = get_watermark_snapshot()

                    # CPU %
                    cur_cpu = get_cpu_times()
                    cpu_pct = calc_cpu_pct(prev_cpu, cur_cpu) or 0.0
                    prev_cpu = cur_cpu

                    # Temps less frequently (every ~5s)
                    if tick_count % 10 == 0:
                        temps = get_temps()

                    # Processes (slightly less often to reduce load)
                    if tick_count % 2 == 0 or resized[0]:
                        processes = get_enriched_processes(50)

                    avail = mem.get('MemAvailable', 0)
                    total_swap = mem.get('SwapTotal', 0)
                    free_swap = mem.get('SwapFree', 0)
                    delta_values = {
                        'avail_ram': avail,
                        'used_swap': total_swap - free_swap,
                    }
                    delta_values.update(vmstat)
                    deltas = tracker.tick(delta_values)
                    vmstat_deltas = deltas

                    tick_count += 1

                resized[0] = False

                # Redraw
                sys.stdout.write("\033[H")
                output = draw_dashboard(mem, psi, zr, view_idx, paused, deltas,
                                        filtered_processes(processes, proc_filter), proc_limit, cpu_pct, temps,
                                        loadavg, uptime_s, zones, vmstat_deltas)
                sys.stdout.write(output)
                sys.stdout.write(f"\n{ERASE_BELOW}")
                sys.stdout.flush()

                time.sleep(0.5)
        except KeyboardInterrupt:
            pass


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        pass
    # Restore terminal on exit
    sys.stdout.write('\033[?1049l\033[?25h')
    sys.stdout.flush()
