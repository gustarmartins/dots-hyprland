#!/usr/bin/env python3
"""Explicit mpv-only binaural surround & optional Dolby HDMI passthrough control. Never changes EQ, gain or playback."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import socket
import stat
import struct
import subprocess
import sys
import tempfile
import time

CONFIG_HOME = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config')))
CONFIG = CONFIG_HOME / 'mpv/spatial.json'
PIPEWIRE_CONF = CONFIG_HOME / 'pipewire/mpv-spatial.conf'
HRIR_PATH = CONFIG_HOME / 'pipewire/hrir/spatial-atmos-7.1-48k.wav'
SOFA_CANDIDATES = (
    Path('/usr/share/libmysofa/MIT_KEMAR_normal_pinna.sofa'),
    Path('/usr/share/libmysofa/default.sofa'),
)
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR', '/run/user/' + str(os.getuid()))) / 'mpv-spatial'
ASOUND_ROOT = Path('/proc/asound')
UNIT = 'mpv-spatial.service'
TARGET = 'effect_input.spatial-surround'
DEVICE = 'pipewire/' + TARGET
DEFAULT_PROFILE = 'atmos-7.1'
DOLBY_CODEC_TOKENS = ('AC-3', 'E-AC-3', 'MLP', 'TRUEHD', 'DTS', 'DTS-HD')


def run(args, check=True):
    return subprocess.run(args, text=True, capture_output=True, check=check, timeout=12)


def sofa_path():
    for candidate in SOFA_CANDIDATES:
        if candidate.is_file():
            return candidate
    return None


def available_profiles():
    sofa = sofa_path()
    return [
        {
            'id': 'atmos-7.1',
            'label': 'Dolby Atmos 7.1 HRIR',
            'detail': '14-channel HeSuVi binaural convolution (48 kHz)',
            'available': HRIR_PATH.is_file(),
        },
        {
            'id': 'sofa-kemar',
            'label': 'PipeWire SOFA 3D (KEMAR)',
            'detail': 'Native libmysofa spherical HRTF spatializer',
            'available': sofa is not None,
        },
    ]


def selected_profile(settings):
    profile = settings.get('profile', DEFAULT_PROFILE)
    valid = {p['id'] for p in available_profiles()}
    return profile if profile in valid else DEFAULT_PROFILE


def passthrough_enabled(settings):
    return bool(settings.get('passthrough', False))


def hdmi_dolby_info(asound_root=None):
    """Inspect ALSA ELD files for connected HDMI/DP sinks advertising Dolby/DTS bitstreams."""
    root = asound_root or ASOUND_ROOT
    outputs = []
    dolby_codecs = []
    if root.is_dir():
        for eld in sorted(root.glob('card*/eld#*')):
            try:
                text = eld.read_text(errors='replace')
            except OSError:
                continue
            fields = {}
            for line in text.splitlines():
                if not line.strip():
                    continue
                parts = line.split(None, 1)
                if len(parts) == 2:
                    fields[parts[0].strip()] = parts[1].strip()
            if fields.get('monitor_present') != '1' or fields.get('eld_valid') != '1':
                continue
            name = fields.get('monitor_name') or eld.name
            conn = fields.get('connection_type') or 'HDMI'
            codecs = []
            max_channels = 2
            for key, val in sorted(fields.items()):
                if re.match(r'^sad\d+_coding_type$', key):
                    codec = re.sub(r'^\[[^\]]+\]\s*', '', val).strip()
                    if codec and codec not in codecs:
                        codecs.append(codec)
                elif re.match(r'^sad\d+_channels$', key):
                    try:
                        max_channels = max(max_channels, int(val.split()[0]))
                    except (ValueError, IndexError):
                        pass
            sink_dolby = [c for c in codecs if any(tok in c.upper() for tok in DOLBY_CODEC_TOKENS)]
            for c in sink_dolby:
                if c not in dolby_codecs:
                    dolby_codecs.append(c)
            outputs.append({
                'name': name,
                'connection': conn,
                'max_channels': max_channels,
                'codecs': codecs,
                'dolby': bool(sink_dolby),
            })
    has_dolby = bool(dolby_codecs)
    if has_dolby:
        dolby_names = ', '.join(o['name'] for o in outputs if o['dolby'])
        summary = f"Dolby HDMI AVR ready ({dolby_names}: {', '.join(dolby_codecs)})"
    elif outputs:
        names = ', '.join(f"{o['name']} ({o['max_channels']}ch LPCM)" for o in outputs)
        summary = f"No Dolby HDMI AVR — connected displays are LPCM only ({names})"
    else:
        summary = 'No HDMI/DP audio receiver detected — using headphone spatial'
    return {
        'hdmi_dolby': has_dolby,
        'hdmi_codecs': dolby_codecs,
        'hdmi_outputs': outputs,
        'hdmi_summary': summary,
    }


def render_pipewire_conf(profile):
    """Build PipeWire filter-chain config for the requested spatial engine."""
    header_common = f"""# Optional mpv surround, controlled by its own service.
# spatial-profile: {profile}
context.properties = {{
    log.level = 0
}}

context.spa-libs = {{
    audio.convert.* = audioconvert/libspa-audioconvert
    support.*       = support/libspa-support
}}

