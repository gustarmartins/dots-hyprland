def write_pipewire_conf(profile):
    content = render_pipewire_conf(profile)
    PIPEWIRE_CONF.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.mpv-spatial-conf-', dir=PIPEWIRE_CONF.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.replace(name, PIPEWIRE_CONF)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def ensure_pipewire_conf(profile):
    marker = f'# spatial-profile: {profile}'
    try:
        if PIPEWIRE_CONF.is_file() and marker in PIPEWIRE_CONF.read_text(errors='replace')[:256]:
            return False
    except OSError:
        pass
    write_pipewire_conf(profile)
    return True


def config():
    try:
        value = json.loads(CONFIG.read_text())
        if type(value.get('enabled')) is not bool or type(value.get('automatic')) is not bool:
            raise ValueError('Invalid spatial audio settings')
        return value
    except FileNotFoundError:
        return {'enabled': False, 'automatic': True}


def save(value):
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(prefix='.spatial-', dir=CONFIG.parent)
    try:
        with os.fdopen(fd, 'w') as f:
            json.dump(value, f, indent=2)
            f.write('\n')
            f.flush()
            os.fsync(f.fileno())
        os.replace(name, CONFIG)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def runtime():
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    info = RUNTIME.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
        raise RuntimeError('Spatial audio runtime directory is not private')
    return RUNTIME


def mpv_identity(pid):
    root = Path('/proc') / str(pid)
    try:
        if root.stat().st_uid != os.getuid() or Path(os.readlink(root / 'exe')).name != 'mpv':
            return None
        data = (root / 'stat').read_text()
        return data[data.rfind(')') + 2:].split()[19]
    except (OSError, IndexError):
        return None


class Client:
    def __init__(self, path, pid):
        self.path, self.pid, self.birth = str(path), pid, mpv_identity(pid)
        if self.birth is None:
            raise RuntimeError('Player identity changed')
        info = Path(path).lstat()
        if not stat.S_ISSOCK(info.st_mode) or info.st_uid != os.getuid():
            raise RuntimeError('Not an owner mpv socket')
        self.sock = socket.socket(socket.AF_UNIX)
        self.sock.settimeout(1.5)
        self.sock.connect(self.path)
        peer, uid, _ = struct.unpack('3i', self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
        if peer != pid or uid != os.getuid():
            self.sock.close()
            raise RuntimeError('Player socket identity mismatch')
        self.buffer, self.sequence = b'', 0

    def close(self):
        self.sock.close()

    def command(self, *args):
        if mpv_identity(self.pid) != self.birth:
            raise RuntimeError('Player lifetime changed')
        self.sequence += 1
        self.sock.sendall((json.dumps({'command': list(args), 'request_id': self.sequence}) + '\n').encode())
        deadline = time.monotonic() + 2
        while time.monotonic() < deadline:
            if b'\n' not in self.buffer:
                chunk = self.sock.recv(65536)
                if not chunk:
                    raise RuntimeError('Player disconnected')
                self.buffer += chunk
            while b'\n' in self.buffer:
                line, self.buffer = self.buffer.split(b'\n', 1)
                reply = json.loads(line)
                if reply.get('request_id') == self.sequence:
                    if reply.get('error') != 'success':
                        raise RuntimeError(reply.get('error', 'Player command failed'))
                    return reply.get('data')
        raise TimeoutError('Player reply timed out')

    def get(self, key, default=None):
        try:
            return self.command('get_property', key)
        except RuntimeError:
            return default


def clients():
    candidates = set()
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        pid = int(proc.name)
        if mpv_identity(pid) is None:
            continue
        try:
            args = (proc / 'cmdline').read_bytes().decode().split('\0')
            for index, arg in enumerate(args):
                if arg.startswith('--input-ipc-server='):
                    candidates.add((arg.split('=', 1)[1], pid))
                elif arg == '--input-ipc-server' and index + 1 < len(args):
                    candidates.add((args[index + 1], pid))
            own = RUNTIME / (str(pid) + '.sock')
            if own.exists():
                candidates.add((str(own), pid))
        except (OSError, UnicodeError):
            pass
    found = []
    for path, pid in sorted(candidates):
        try:
            found.append(Client(path, pid))
        except (OSError, RuntimeError, ValueError):
            pass
    return found


def sink_names():
    return {row['name'] for row in json.loads(run(['pactl', '-f', 'json', 'list', 'sinks']).stdout)}


def default_sink():
    return run(['pactl', 'get-default-sink']).stdout.strip()


def active():
    return run(['systemctl', '--user', 'is-active', UNIT], check=False).returncode == 0


def player_spatial_active(client):
    """True only when this mpv instance is unpaused, non-idle, and actively using spatial."""
    if client.get('pause', False) or client.get('idle-active', False):
        return False
    if client.get('audio-device') == DEVICE:
        return True
    state = client.get('user-data/mpv-spatial', {}) or {}
    return bool(state.get('active') and not state.get('passthrough'))


def any_active_spatial_player(exclude_pid=None):
    for client in clients():
        try:
            if exclude_pid is not None and client.pid == exclude_pid:
                continue
            if player_spatial_active(client):
                return True
        except (OSError, RuntimeError):
            pass
        finally:
            client.close()
    return False


def refresh_players(reason='refresh'):
    errors = []
    for client in clients():
        try:
            client.command('script-message-to', 'mpv_spatial', 'refresh', reason)
        except (OSError, RuntimeError) as e:
            errors.append(f'mpv {client.pid}: {e}')
        finally:
            client.close()
    return errors


def restore_players(only_idle=False, exclude_pid=None):
    errors = []
    for client in clients():
        try:
            if exclude_pid is not None and client.pid == exclude_pid:
                continue
            if only_idle and player_spatial_active(client):
                continue
            if client.get('audio-device') != DEVICE:
                continue
            client.command('script-message-to', 'mpv_spatial', 'refresh', 'release' if only_idle else 'disabled')
            deadline = time.monotonic() + 2
            while client.get('audio-device') == DEVICE and time.monotonic() < deadline:
                time.sleep(.04)
            if client.get('audio-device') == DEVICE:
                owned = client.get('user-data/mpv-spatial', {}) or {}
                previous = owned.get('previous_device', 'auto')
                if previous == DEVICE:
                    previous = 'auto'
                client.command('set_property', 'audio-device', previous)
                if owned.get('previous_channels') and client.get('options/audio-channels') == '7.1,5.1,stereo':
                    client.command('set_property', 'audio-channels', owned['previous_channels'])
            if client.get('audio-device') == DEVICE:
                raise RuntimeError('Spatial route did not release')
        except (OSError, RuntimeError) as e:
            errors.append(f'mpv {client.pid}: {e}')
        finally:
            client.close()
    return errors


def clear_sink_users(settings):
    """Only streams actually using our disappearing sink need a fallback."""
    sinks = json.loads(run(['pactl', '-f', 'json', 'list', 'sinks']).stdout)
    spatial = next((s for s in sinks if s['name'] == TARGET), None)
    if spatial is None:
        return
    names = {s['name'] for s in sinks if s['name'] != TARGET}
    fallback = settings.get('previous_default_sink')
    if fallback not in names:
        fallback = default_sink()
    if fallback not in names:
        fallback = 'easyeffects_sink' if 'easyeffects_sink' in names else next(iter(sorted(names)), None)
    if fallback is None:
        raise RuntimeError('No normal audio output is available')
    if default_sink() == TARGET:
        run(['pactl', 'set-default-sink', fallback])
    inputs = json.loads(run(['pactl', '-f', 'json', 'list', 'sink-inputs']).stdout)
    for stream in inputs:
        if stream['sink'] == spatial['index']:
            run(['pactl', 'move-sink-input', str(stream['index']), fallback])


def acquire_sink():
    """Start the virtual spatial sink on demand without altering desktop default sink."""
    settings = config()
    if not settings['enabled']:
        raise RuntimeError('Spatial audio is disabled')
    updated = dict(settings)
    if TARGET not in sink_names():
        try:
            ensure_pipewire_conf(selected_profile(settings))
        except RuntimeError:
            pass
        prev = default_sink()
        if prev and prev != TARGET:
            updated['previous_default_sink'] = prev
            save(updated)
        run(['systemctl', '--user', 'start', UNIT])
        deadline = time.monotonic() + 3
        while TARGET not in sink_names() and time.monotonic() < deadline:
            time.sleep(.05)
        if TARGET not in sink_names():
            run(['systemctl', '--user', 'stop', UNIT], check=False)
            raise RuntimeError('Spatial audio output did not become ready')
    if default_sink() == TARGET and updated.get('previous_default_sink'):
        run(['pactl', 'set-default-sink', updated['previous_default_sink']])


def release_sink(exclude_pid=None):
    """Tear down the virtual spatial sink once no unpaused mpv player needs it."""
    if any_active_spatial_player(exclude_pid=exclude_pid):
        return False
    settings = config()
    restore_players(only_idle=True, exclude_pid=exclude_pid)
    if active() or TARGET in sink_names():
        clear_sink_users(settings)
        run(['systemctl', '--user', 'stop', UNIT], check=False)
        deadline = time.monotonic() + 2
        while TARGET in sink_names() and time.monotonic() < deadline:
            time.sleep(.05)
    return True


def set_profile(profile_id):
    profiles = {p['id']: p for p in available_profiles()}
    if profile_id not in profiles:
        raise ValueError(f'Unknown spatial profile: {profile_id}')
    if not profiles[profile_id]['available']:
        raise RuntimeError(f"Spatial profile '{profile_id}' is unavailable on this machine")
    previous = config()
    updated = dict(previous, profile=profile_id)
    write_pipewire_conf(profile_id)
    save(updated)
    if active():
        was_playing = any_active_spatial_player()
        restore_players()
        clear_sink_users(updated)
        run(['systemctl', '--user', 'restart', UNIT])
        deadline = time.monotonic() + 3
        while TARGET not in sink_names() and time.monotonic() < deadline:
            time.sleep(.05)
        if default_sink() == TARGET and updated.get('previous_default_sink'):
            run(['pactl', 'set-default-sink', updated['previous_default_sink']])
        refresh_players('profile')
        if not was_playing and not any_active_spatial_player():
            release_sink()
    else:
        refresh_players('profile')


def set_passthrough(value):
    previous = config()
    save(dict(previous, passthrough=bool(value)))
    refresh_players('passthrough')


def set_enabled(value):
    previous = config()
    updated = dict(previous, enabled=value)
    if value:
        if TARGET not in sink_names():
            prev = default_sink()
            if prev and prev != TARGET:
                updated['previous_default_sink'] = prev
        save(updated)
        try:
            # On-demand lifecycle: never leave the virtual sink running at boot or while idle.
            run(['systemctl', '--user', 'disable', UNIT], check=False)
            refresh_players('enabled')
            if not any_active_spatial_player():
                release_sink()
        except Exception:
            save(previous)
            if not previous['enabled']:
                restore_players()
                clear_sink_users(updated)
                run(['systemctl', '--user', 'disable', '--now', UNIT], check=False)
            raise
    else:
        save(updated)
        errors = restore_players()
        clear_sink_users(updated)
        run(['systemctl', '--user', 'disable', '--now', UNIT], check=False)
        if errors:
            raise RuntimeError('; '.join(errors))


def status():
    settings = config()
    running = active()
    available = TARGET in sink_names()
    profiles = available_profiles()
    profile_id = selected_profile(settings)
    profile_entry = next((p for p in profiles if p['id'] == profile_id), profiles[0])
    passthrough = passthrough_enabled(settings)
    hdmi = hdmi_dolby_info()
    players = []
    for client in clients():
        try:
            state = client.get('user-data/mpv-spatial', {}) or {}
            paused = bool(client.get('pause', False) or client.get('idle-active', False))
            on_spatial = client.get('audio-device') == DEVICE
            on_passthrough = bool(state.get('passthrough')) and not paused
            players.append({
                'pid': client.pid,
                'spatial': on_spatial and not paused,
                'passthrough': on_passthrough,
                'paused': paused,
                'state': state,
            })
        finally:
            client.close()
    message = 'Off — normal stereo output'
    if settings['enabled']:
        if any(player['passthrough'] for player in players):
            message = 'True Dolby HDMI bitstream passthrough active in mpv'
        elif any(player['spatial'] for player in players) and running and available:
            message = f"Spatial active in mpv ({profile_entry['label']})"
        elif running or available:
            message = 'Spatial sink idle — releases automatically when paused'
        else:
            mode_msg = 'starts on multichannel mpv playback' if settings['automatic'] else 'press F8 in mpv'
            message = f"Ready ({profile_entry['label']}, on-demand) — {mode_msg}"
    return {
        'enabled': settings['enabled'],
        'automatic': settings['automatic'],
        'profile': profile_id,
        'profile_label': profile_entry['label'],
        'profiles': profiles,
        'passthrough': passthrough,
        'hdmi_dolby': hdmi['hdmi_dolby'],
        'hdmi_codecs': hdmi['hdmi_codecs'],
        'hdmi_outputs': hdmi['hdmi_outputs'],
        'hdmi_summary': hdmi['hdmi_summary'],
        'running': running,
        'available': available,
        'message': message,
        'players': players,
    }


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        'command',
        choices=['status', 'enable', 'disable', 'toggle', 'automatic', 'passthrough', 'profile', 'runtime', 'is-enabled', 'acquire', 'release'],
    )
    parser.add_argument('value', nargs='?')
    parser.add_argument('--exclude-pid', type=int, default=None)
    args = parser.parse_args()
    if args.command == 'runtime':
        print(runtime())
        return
    if args.command == 'is-enabled':
        raise SystemExit(0 if config()['enabled'] else 1)
    if args.command == 'status':
        print(json.dumps(status()))
        return
    with (runtime() / 'control.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.command == 'automatic':
            if args.value not in ('true', 'false'):
                parser.error('automatic requires true or false')
            save(dict(config(), automatic=args.value == 'true'))
            refresh_players('automatic')
        elif args.command == 'passthrough':
            if args.value not in ('true', 'false'):
                parser.error('passthrough requires true or false')
            set_passthrough(args.value == 'true')
        elif args.command == 'profile':
            if not args.value:
                parser.error('profile requires a profile id (atmos-7.1 or sofa-kemar)')
            set_profile(args.value)
        elif args.command == 'acquire':
            acquire_sink()
        elif args.command == 'release':
            release_sink(exclude_pid=args.exclude_pid)
        else:
            set_enabled(not config()['enabled'] if args.command == 'toggle' else args.command == 'enable')
    print(json.dumps(status()))


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        raise SystemExit(1)
