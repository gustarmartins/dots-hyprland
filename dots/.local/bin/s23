#!/bin/bash

DEVICE="192.168.0.170:6666"

echo "Connecting to S23 Ultra ($DEVICE)..."
adb connect $DEVICE

echo "Launching scrcpy in 720p High-Bitrate mode for Hyprland..."
scrcpy -s $DEVICE \
    --window-title="S23_Ultra" \
    --max-fps=120 \
    -m 1280 \
    -b 24M \
    -S \
    -w \
    --keyboard=uhid \
    --mouse=uhid \
    --audio-bit-rate=128K
