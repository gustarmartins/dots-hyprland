#!/usr/bin/env python3
"""Launch the Super+I task manager from either Hyprland or Quickshell."""
import json
import os
from pathlib import Path
import shlex
import sys


def launch(manager, terminal):
    if manager.strip() in ('vminfo', str(Path.home() / '.local/bin/vminfo'), '~/.local/bin/vminfo'):
        dashboard = str(Path.home() / '.local/bin/vminfo')
        argv = shlex.split(terminal)
        emulator = Path(argv[0]).name if argv else 'kitty'
        if emulator in ('gnome-terminal', 'kgx'):
            separator = '--'
        elif emulator == 'wezterm':
            separator = '--' if 'start' in argv else 'start --'
        else:
            separator = '-e'
        os.execl('/bin/bash', 'bash', '-c', (terminal or 'kitty -1') + ' ' + separator + ' "$1" --manager',
                 'ii-task-manager', dashboard)
    os.execl('/bin/bash', 'bash', '-c', manager)


if __name__ == '__main__':
    if len(sys.argv) == 3:
        launch(sys.argv[1], sys.argv[2])
    config_home = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    try:
        apps = json.loads((config_home / 'illogical-impulse/config.json').read_text())['apps']
    except (OSError, ValueError, KeyError):
        apps = {}
    launch(apps.get('taskManager') or 'vminfo', apps.get('terminal') or 'kitty -1')
