#!/usr/bin/env python3
"""Persist VRR policy and reconcile it with Hyprland without changing display modes."""
import argparse
import contextlib
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time

CONFIG = Path.home() / '.config/hypr'
STATE = CONFIG / 'vrr.json'
GENERATED = CONFIG / 'vrr-policies.lua'
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
MODES = {-1: 'Follow global', 0: 'Off', 1: 'Always', 2: 'Fullscreen', 3: 'Games & video'}


def run(args):
    result = subprocess.run(args, capture_output=True, text=True, timeout=5)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or f'{args[0]} failed')
    return result.stdout


def current():
    return json.loads(run(['hyprctl', '-j', 'monitors']))


def selector(monitor):
    # The canonical ARZOPA profile uses its connector (its EDID serial is noisy).
    if monitor.get('model') == 'ARZOPA' and monitor['name'] == 'HDMI-A-1':
        return monitor['name']
    return 'desc:' + monitor['description'] if monitor.get('description') else monitor['name']


def snapshot(monitor):
    p = dict(output=selector(monitor), mode=f'{monitor["width"]}x{monitor["height"]}@{monitor["refreshRate"]:.6f}',
             position=f'{monitor["x"]}x{monitor["y"]}', scale=monitor['scale'], transform=monitor['transform'],
             bitdepth=10 if '2101010' in monitor.get('currentFormat', '') else 8,
             cm=monitor.get('colorManagementPreset', 'srgb'), sdrbrightness=monitor.get('sdrBrightness', 1),
             sdrsaturation=monitor.get('sdrSaturation', 1))
    if monitor.get('model') == 'ARZOPA' and monitor['name'] == 'HDMI-A-1' and p['bitdepth'] == 8 and p['cm'] == 'srgb':
        p['supports_hdr'] = -1
        p['supports_wide_color'] = -1
    if monitor.get('mirrorOf') not in (None, '', 'none'):
        p['mirror'] = monitor['mirrorOf']
    return p


def settings():
    if STATE.exists():
        data = json.loads(STATE.read_text())
        if data.get('global') not in range(4) or not isinstance(data.get('monitors'), dict):
            raise ValueError('Invalid VRR settings')
        return data
    return {'global': 2, 'monitors': {}}


def lua(value):
    if isinstance(value, dict):
        return '{' + ','.join('[' + lua(k) + ']=' + lua(v) for k, v in value.items()) + '}'
    if isinstance(value, str):
        # JSON without ASCII escapes is also a Lua quoted string for display names.
        return json.dumps(value, ensure_ascii=False).replace('\\/', '/')
    if isinstance(value, bool):
        return str(value).lower()
    if value is None:
        return 'nil'
    return str(value)


def atomic(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as stream:
        tmp = Path(stream.name)
        stream.write(data)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)


def save(data):
    atomic(STATE, (json.dumps(data, indent=2, ensure_ascii=False) + '\n').encode())
    atomic(GENERATED, ('-- Generated by vrrctl. Use the VRR panel or vrrctl set.\nreturn ' + lua(data) + '\n').encode())


def gpu_state(monitors):
    result = {}
    try:
        cards = json.loads(run(['drm_info', '-j']))
        for card, data in cards.items():
            crtcs = {c['id']: c.get('properties', {}).get('VRR_ENABLED', {}).get('value') for c in data.get('crtcs', [])}
            connectors = {c['id']: c for c in data.get('connectors', [])}
            for m in monitors:
                path = Path('/sys/class/drm') / (Path(card).name + '-' + m['name']) / 'connector_id'
                if not path.exists():
                    continue
                connector = connectors.get(int(path.read_text()), {})
                crtc = connector.get('properties', {}).get('CRTC_ID', {}).get('value')
                value = crtcs.get(crtc)
                if value is not None:
                    result[m['name']] = bool(value)
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired):
        pass
    return result


def status():
    data = settings()
    monitors = current()
    gpu = gpu_state(monitors)
    live_global = json.loads(run(['hyprctl', '-j', 'getoption', 'misc:vrr']))['int']
    outputs = []
    for m in monitors:
        policy = data['monitors'].get(selector(m), {}).get('policy', 0 if m.get('model') == 'ARZOPA' else -1)
        effective = data['global'] if policy == -1 else policy
        outputs.append(dict(name=m['name'], description=m.get('description', m['name']),
                            label=(m.get('make', '') + ' ' + m.get('model', '')).strip() + ' · ' + m['name'],
                            selector=selector(m), policy=policy, effective=effective,
                            active=bool(m.get('vrr')), gpu=gpu.get(m['name']),
                            capable=m.get('hardwareDetails', {}).get('vrrCapable'),
                            hz=m['refreshRate'], width=m['width'], height=m['height'], focused=m.get('focused', False),
                            mismatch=effective == 0 and (bool(m.get('vrr')) or gpu.get(m['name']) is True)))
    return dict(globalPolicy=data['global'], liveGlobal=live_global, monitors=outputs)


def evaluate(code):
    output = run(['hyprctl', 'eval', code]).strip()
    if output != 'ok':
        raise RuntimeError(output or 'Hyprland rejected VRR update')


def apply(data, monitors):
    profiles = []
    for m in monitors:
        p = snapshot(m)
        p['vrr'] = data['monitors'].get(selector(m), {}).get('policy', 0 if m.get('model') == 'ARZOPA' else -1)
        profiles.append(p)
    # Hyprland 0.57's monitor-rule comparison omits VRR. A tiny temporary soft
    # property change forces the new policy into the active rule. Restore the
    # exact brightness before reporting success; never change timing or layout.
    try:
        for p in profiles:
            nudged = p | {'sdrbrightness': p['sdrbrightness'] + 0.00001}
            evaluate('hl.monitor(' + lua(nudged) + ')')
        time.sleep(.12)
    finally:
        for p in profiles:
            evaluate('hl.monitor(' + lua(p) + ')')
    time.sleep(.12)
    evaluate('hl.config({misc={vrr=' + str(data['global']) + '}})')
    # Update cached restore profiles without reapplying their timing or layout:
    # a Moonlight stream may currently use a different mode from the login file.
    modes = {p['output']: p['vrr'] for p in profiles}
    modes.update({m['name']: profiles[i]['vrr'] for i, m in enumerate(monitors)})
    evaluate('local modes=' + lua(modes) + '; local cached=package.loaded["monitors"]; '
             'if cached then for _,p in pairs(cached) do if type(p)=="table" and modes[p.output]~=nil '
             'then p.vrr=modes[p.output] end end end')


def set_policy(target, value):
    if value not in MODES or (target == 'global' and value == -1):
        raise ValueError('Choose a valid VRR mode')
    monitors = current()
    selected = None if target == 'global' else next((m for m in monitors if m['name'] == target), None)
    if target != 'global' and selected is None:
        raise ValueError('Display disconnected; no settings changed')
    before = {p: p.read_bytes() if p.exists() else None for p in (STATE, GENERATED)}
    previous = settings()
    data = json.loads(json.dumps(previous))
    if selected is None:
        data['global'] = value
    else:
        data['monitors'][selector(selected)] = {'policy': value, 'profile': snapshot(selected)}
    affected = ([selected] if selected is not None else
                [m for m in monitors if data['monitors'].get(selector(m), {}).get('policy',
                    0 if m.get('model') == 'ARZOPA' else -1) == -1])
    save(data)
    try:
        apply(data, affected)
    except Exception:
        for path, content in before.items():
            if content is None:
                path.unlink(missing_ok=True)
            else:
                atomic(path, content)
        with contextlib.suppress(Exception):
            apply(previous, affected)
        raise
    result = status()
    mismatches = [m['name'] for m in result['monitors'] if m['mismatch']]
    if mismatches:
        result['error'] = 'Requested Off, but VRR is still enabled on ' + ', '.join(mismatches)
    return result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('status')
    change = sub.add_parser('set')
    change.add_argument('target', help='global or a connected output such as DP-1')
    change.add_argument('mode', type=int, choices=MODES)
    args = parser.parse_args()
    if args.action == 'status':
        print(json.dumps(status(), ensure_ascii=False))
        return
    RUNTIME.mkdir(parents=True, exist_ok=True)
    with contextlib.ExitStack() as stack:
        for name in ('vrr-control.lock', 'refresh-displays.lock', 'sunshine-display.lock'):
            lock = stack.enter_context((RUNTIME / name).open('a'))
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                raise RuntimeError('A display change is already running; try again when it finishes')
        print(json.dumps(set_policy(args.target, args.mode), ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        print(json.dumps({'error': str(error)}))
        sys.exit(1)
