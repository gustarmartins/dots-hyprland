#!/usr/bin/env python3
"""One native EasyEffects instance for Hyprland and Quickshell."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import socket
import subprocess
import sys
import time

RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "easyeffects"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "easyeffects"
LOCK_HELD = False


def state_file():
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "easyeffects-qs-state.json"


def startup_locked():
    if LOCK_HELD:
        return False
    lock_path = RUNTIME / "easyeffects-qs.lock"
    if not lock_path.exists():
        return False
    try:
        with lock_path.open("rb") as lock:
            fcntl.flock(lock, fcntl.LOCK_SH | fcntl.LOCK_NB)
            fcntl.flock(lock, fcntl.LOCK_UN)
            return False
    except BlockingIOError:
        return True
    except OSError:
        return False


def exchange(command, reply=True):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(1)
        connection.connect(str(RUNTIME / "EasyEffectsServer"))
        connection.sendall((command + "\n").encode())
        connection.shutdown(socket.SHUT_WR)
        if not reply:
            return ""
        chunks = []
        while chunk := connection.recv(4096):
            chunks.append(chunk)
        return b"".join(chunks).decode().strip()


def state():
    result = {"available": shutil.which("easyeffects") is not None,
              "active": False, "preset": "", "bypassed": False,
              "known": True, "error": "",
              "presets": sorted(p.stem for p in (DATA / "output").glob("*.json"))}
    try:
        bypass = exchange("get_global_bypass")
        if bypass not in ("0", "1", "2"):
            raise ValueError("Invalid bypass response")
        result["bypassed"] = bypass == "1"
        result["preset"] = exchange("get_last_loaded_preset:output")
        result["active"] = True
    except (FileNotFoundError, ConnectionRefusedError):
        if startup_locked():
            result["known"] = False
    except (OSError, ValueError):
        result["known"] = False
        result["error"] = "EasyEffects is not responding; retrying status."
    return result


def confirmed_state():
    current = state()
    if not current["known"]:
        raise RuntimeError(current["error"])
    return current


def wait_for_tray():
    # Prefer a ready tray, but audio must still start if Quickshell is slow,
    # disabled, or restarting. Bound elapsed time as well as D-Bus calls.
    deadline = time.monotonic() + 15
    while (remaining := deadline - time.monotonic()) > 0:
        try:
            result = subprocess.run(
                ["busctl", "--user", "--timeout=1", "get-property", "org.kde.StatusNotifierWatcher",
                 "/StatusNotifierWatcher", "org.kde.StatusNotifierWatcher", "IsStatusNotifierHostRegistered"],
                capture_output=True, text=True, timeout=min(2, remaining))
        except FileNotFoundError:
            return False
        except subprocess.TimeoutExpired:
            continue
        if result.returncode == 0 and result.stdout.strip() == "b true":
            return True
        time.sleep(min(0.25, max(0, deadline - time.monotonic())))
    return False


def clear_persisted_bypass():
    rc = CONFIG / "db/easyeffectsrc"
    try:
        lines = rc.read_text().splitlines(keepends=True)
    except OSError:
        return
    section = ""
    kept = []
    changed = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped
        if section == "[EffectsPipelines]" and stripped.startswith("bypass="):
            if stripped != "bypass=false":
                changed = True
            continue
        kept.append(line)
    if changed:
        try:
            rc.write_text("".join(kept))
        except OSError:
            pass


def save_selected_preset(preset):
    path = state_file()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps({"preset": preset, "timestamp": time.time()}) + "\n")
    except OSError:
        pass


def load_preset(preset):
    exchange("load_preset:output:" + preset, reply=False)
    for _ in range(30):
        try:
            if exchange("get_last_loaded_preset:output") == preset:
                return
        except (TimeoutError, ConnectionResetError):
            # Rebuilding the effects pipeline can briefly occupy the UI thread.
            pass
        time.sleep(0.1)
    raise RuntimeError("EasyEffects did not confirm the selected preset.")


def restore_saved_preset(current):
    try:
        saved = json.loads(state_file().read_text())
        preset = saved.get("preset", "")
        timestamp = float(saved.get("timestamp", 0))
    except (OSError, ValueError, TypeError):
        return
    if not preset or preset not in current.get("presets", ()):
        return
    db_dir = CONFIG / "db"
    db_mtime = max((p.stat().st_mtime for p in db_dir.glob("*rc")), default=0) if db_dir.is_dir() else 0
    if timestamp > db_mtime:
        load_preset(preset)


def start():
    if confirmed_state()["active"]:
        return
    tray_ready = wait_for_tray()
    clear_persisted_bypass()
    log = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "easyeffects-qs.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    with log.open("ab") as output:
        if not tray_ready:
            output.write(b"System tray unavailable after startup grace period; starting audio processing.\n")
            output.flush()
        subprocess.Popen(["easyeffects", "--hide-window", "--service-mode"],
                         stdout=output, stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(80):
        current = state()
        if current["active"]:
            restore_saved_preset(current)
            if current.get("bypassed") or state().get("bypassed"):
                set_bypass(False)
            return
        time.sleep(0.1)
    raise RuntimeError(f"EasyEffects did not become ready. See {log}")


def set_bypass(bypassed):
    if not confirmed_state()["active"]:
        if bypassed:
            return
        start()
    exchange("global_bypass:" + ("1" if bypassed else "0"), reply=False)
    for _ in range(30):
        current = state()
        if current["known"] and current["active"] and current["bypassed"] == bypassed:
            return
        time.sleep(0.1)
    raise RuntimeError("EasyEffects did not confirm the processing state.")


def notify_shell():
    if not shutil.which("qs"):
        return
    try:
        subprocess.run(["qs", "-c", "ii", "ipc", "call", "easyeffects", "refresh"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except (OSError, subprocess.SubprocessError):
        pass


def notify_music_eq_manual(preset):
    """Receipt makes even re-selecting the same preset an explicit song override."""
    session_path=RUNTIME/'music-eq-session.json'
    try:
        session=json.loads(session_path.read_text())
    except (OSError, ValueError):
        return
    receipt=RUNTIME/'music-eq-manual.json'
    temp=receipt.with_suffix('.tmp')
    temp.write_text(json.dumps(dict(id=time.time_ns(),key=session.get('key'),preset=preset)))
    temp.chmod(0o600); temp.replace(receipt)
    # systemd addresses the unit's current main process, never a stale saved PID.
    subprocess.run(['systemctl','--user','kill','--kill-whom=main','--signal=SIGUSR1',
                    'music-eq.service'],capture_output=True,timeout=3)


def main():
    global LOCK_HELD
    action = sys.argv[1] if len(sys.argv) > 1 else "state"
    if action == "state":
        print(json.dumps(state()))
        return
    with (RUNTIME / "easyeffects-qs.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        LOCK_HELD = True
        try:
            if action in ("start", "show"):
                start()
                if action == "start" and confirmed_state().get("bypassed"):
                    set_bypass(False)
                if action == "show":
                    exchange("show_window", reply=False)
            elif action in ("effects-on", "effects-off", "effects-toggle"):
                # A manual processing toggle must not be immediately undone by automation.
                automatic = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "astra-profiled.service"])
                if automatic.returncode == 0:
                    subprocess.run(["systemctl", "--user", "stop", "astra-profiled.service"], check=True)
                # Read inside the action lock: the shell's cached status can be stale.
                current = confirmed_state()
                bypassed = current["active"] and not current["bypassed"] if action == "effects-toggle" else action == "effects-off"
                set_bypass(bypassed)
                print(json.dumps(state()))
            elif action == "stop":
                if state()["active"]:
                    exchange("quit_app", reply=False)
                    for _ in range(50):
                        if not state()["active"]:
                            break
                        time.sleep(0.1)
                    else:
                        raise RuntimeError("EasyEffects has not finished shutting down.")
            elif action == "preset" and len(sys.argv) == 3:
                preset = sys.argv[2]
                if preset not in state()["presets"]:
                    raise ValueError("Choose an installed output preset.")
                # A manual selection owns the profile until automatic mode is started again.
                automatic = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "astra-profiled.service"])
                if automatic.returncode == 0:
                    subprocess.run(["systemctl", "--user", "stop", "astra-profiled.service"], check=True)
                start()
                load_preset(preset)
                save_selected_preset(preset)
                notify_music_eq_manual(preset)
            else:
                raise ValueError("Usage: easyeffects-qs state|start|show|stop|effects-on|effects-off|effects-toggle|preset NAME")
        finally:
            LOCK_HELD = False
    if action in ("start", "stop"):
        notify_shell()


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
