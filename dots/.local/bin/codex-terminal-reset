#!/usr/bin/env python3
"""Reset reporting only on listed PTYs now owned by an idle foreground shell."""
import os
from pathlib import Path
import re
import sys

RESET = (b'\x1b[?9;1000;1001;1002;1003;1004;1005;1006;1015;1016l'
         b'\x1b[=0u\x1b[>4;0m')
SHELLS = {'zsh', 'bash', 'fish', 'sh', 'dash'}


def identity(pid):
    proc = Path('/proc') / str(pid)
    fields = (proc / 'stat').read_text().rsplit(')', 1)[1].split()
    return (fields[19], fields[2], fields[5],
            (proc / 'comm').read_text().strip(),
            os.readlink(proc / 'fd/1'))


def main():
    targets = {'/dev/' + tty for tty in sys.argv[1:]
               if re.fullmatch(r'pts/\d+', tty)}
    for proc in Path('/proc').iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            before = identity(proc.name)
            _, pgrp, foreground, name, tty = before
            if tty not in targets or name not in SHELLS or pgrp != foreground:
                continue
            fd = os.open(tty, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK | os.O_NOFOLLOW)
            try:
                # Recheck PID start time, foreground ownership and tty after open.
                if identity(proc.name) != before:
                    continue
                os.write(fd, RESET)
                print('Reset terminal reporting:', tty)
                targets.remove(tty)
            finally:
                os.close(fd)
        except (OSError, ValueError, IndexError):
            continue


if __name__ == '__main__':
    main()
