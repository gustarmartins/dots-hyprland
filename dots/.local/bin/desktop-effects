#!/usr/bin/env python3
"""Persistent desktop effects; validate compositor settings before applying."""
import argparse, fcntl, json, os, subprocess, sys, tempfile
from pathlib import Path
HOME=Path.home()
STATE=HOME/'.local/state/desktop-effects'
MODULE=HOME/'.config/hypr/custom/cinematic-effects.lua'
DEFAULT=dict(preset='cinematic',blur=True,passes=4,blur_size=8,live_blur=True,motion=True,samples=12,glow=True,glow_strength=20,shadow=True,rotate=True,border=2,rounding=18,gaps=6,tempo=100,travel=40,workspace_style='slidefade',window_style='popin',bounce=22,palette='aurora',aurora=False,stars=False,ambient_strength=35,ambient_speed=100,parallax=True)
PRESETS={
 'light':dict(blur=False,motion=False,glow=False,shadow=False,rotate=False,aurora=False,stars=False,parallax=False,tempo=75,travel=15,gaps=6),
 'balanced':dict(passes=2,live_blur=False,motion=False,rotate=False,glow_strength=10,aurora=False,stars=False,tempo=85,travel=25,gaps=8),
 'cinematic':{},
 'aurora':dict(aurora=True,stars=True,ambient_strength=48,passes=4,samples=12,glow_strength=28,travel=65,gaps=14,border=3,tempo=110,workspace_style='slidefadevert',bounce=20),
}
RANGES={'passes':(1,5),'blur_size':(2,16),'samples':(3,24),'glow_strength':(0,60),'border':(1,5),'rounding':(0,20),'gaps':(0,30),'tempo':(50,160),'travel':(0,100),'bounce':(16,32),'ambient_strength':(0,80),'ambient_speed':(40,200)}
CHOICES={'workspace_style':['slidefade','slidefadevert','slide','fade'],'window_style':['popin','slide','gnomed'],'palette':['aurora','sunset','ocean','emerald']}
PALETTES={'aurora':['b8a1ff','7bdfff','f4b8dc'],'sunset':['ffb86c','ff6b9d','c792ea'],'ocean':['59d8ff','6b8bff','a5f3fc'],'emerald':['65e6b4','c5f57c','60c9d9']}
def state():
 return DEFAULT | (json.loads((STATE/'state.json').read_text()) if (STATE/'state.json').exists() else {})
def validate(s):
 if set(s)-set(DEFAULT): raise ValueError('Unknown settings')
 for k,v in DEFAULT.items():
  if isinstance(v,bool) and type(s[k]) is not bool: raise ValueError(k+' must be boolean')
 for k,(lo,hi) in RANGES.items():
  if type(s[k]) is not int or not lo<=s[k]<=hi: raise ValueError(k+' out of range')
 for k,choices in CHOICES.items():
  if s[k] not in choices: raise ValueError('Invalid '+k)
 if s['preset'] not in [*PRESETS,'custom']: raise ValueError('Invalid preset')
 return s
def lua(v):
 if isinstance(v,bool):return str(v).lower()
 if isinstance(v,str):return json.dumps(v)
 if isinstance(v,dict):return '{'+','.join(k+'='+lua(x) for k,x in v.items())+'}'
 if isinstance(v,list):return '{'+','.join(map(lua,v))+'}'
 return str(v)
def render(s):
 colors=PALETTES[s['palette']]; accent=colors[0]
 cfg={'general':{'border_size':s['border'],'gaps_in':s['gaps']//2,'gaps_out':s['gaps'],'col':{'active_border':{'colors':['rgba('+c+'e6)' for c in colors],'angle':45},'inactive_border':'rgba('+accent+'44)'}},'decoration':{'rounding':s['rounding'],'blur':{'enabled':s['blur'],'size':s['blur_size'],'passes':s['passes'],'xray':not s['live_blur'],'new_optimizations':True,'noise':0.018,'contrast':0.95,'brightness':1,'vibrancy':0.35,'popups':s['blur'],'popups_ignorealpha':0.2},'motion_blur':{'enabled':s['motion'],'samples':s['samples']},'glow':{'enabled':s['glow'],'range':22,'render_power':3,'color':'rgba('+accent+f'{round(s["glow_strength"]*2.55):02x}'+')','color_inactive':'rgba('+accent+'08)'},'shadow':{'enabled':s['shadow'],'range':60,'render_power':3,'offset':[0,8],'color':'rgba(09061166)','color_inactive':'rgba(09061133)'}}}
 lines=['-- Generated by desktop-effects. Use Super+I > Desktop effects.','hl.config('+lua(cfg)+')']
 for name,data in {'riceLinear':{'type':'bezier','points':[[0,0],[1,1]]},'riceExit':{'type':'bezier','points':[[0.4,0],[0.82,0.2]]},'riceSoft':{'type':'bezier','points':[[0.2,0.8],[0.2,1]]},'riceOpen':{'type':'spring','mass':1,'stiffness':190,'dampening':s['bounce']},'riceMove':{'type':'spring','mass':1,'stiffness':250,'dampening':28},'riceSpace':{'type':'spring','mass':1,'stiffness':175,'dampening':s['bounce']+2}}.items(): lines.append('hl.curve('+lua(name)+','+lua(data)+')')
 def anim(leaf,speed,curve,style=None,spring=False):
  a=dict(leaf=leaf,enabled=True,speed=round(speed*s['tempo']/100,2));a['spring' if spring else 'bezier']=curve
  if style is not None:a['style']=style
  lines.append('hl.animation('+lua(a)+')')
 style=s['window_style'];anim('windowsIn',4.6,'riceOpen','popin 72%' if style=='popin' else style,True)
 anim('windowsOut',2.4,'riceExit','popin 88%' if style=='popin' else style)
 anim('windowsMove',3.6,'riceMove','slide',True)
 ws=s['workspace_style'];ws=ws if ws=='fade' else ws+' '+str(s['travel'])+'%'
 for leaf in ['workspaces','workspacesIn','workspacesOut']:anim(leaf,5.2,'riceSpace',ws,True)
 for leaf in ['layersIn','specialWorkspaceIn']:anim(leaf,4.2,'riceOpen','popin 88%' if leaf=='layersIn' else 'slidefadevert 35%',True)
 for leaf in ['layersOut','specialWorkspaceOut']:anim(leaf,2.2,'riceExit','popin 94%' if leaf=='layersOut' else 'slidefadevert 25%')
 for leaf in ['fadeIn','fadeLayersIn','fadePopupsIn','fadeShadow','fadeGlow','border']:anim(leaf,2.8,'riceSoft')
 for leaf in ['fadeOut','fadeLayersOut','fadePopupsOut']:anim(leaf,1.8,'riceExit')
 lines.append('hl.animation('+lua(dict(leaf='borderangle',enabled=s['rotate'],speed=80,bezier='riceLinear',style='loop'))+')')
 return '\n'.join(lines)+'\n'
def atomic(path,text):
 path.parent.mkdir(parents=True,exist_ok=True)
 fd,tmp=tempfile.mkstemp(dir=path.parent,prefix='.'+path.name)
 try:
  with os.fdopen(fd,'w') as f:f.write(text)
  os.replace(tmp,path)
 finally:
  if os.path.exists(tmp):os.unlink(tmp)
def apply(s):
 content=render(validate(s));candidate=STATE/'candidate.lua';atomic(candidate,content)
 result=subprocess.run(['Hyprland','--verify-config','-c',str(candidate)],capture_output=True,text=True)
 if result.returncode:raise RuntimeError(result.stdout+result.stderr)
 before=MODULE.read_text();atomic(MODULE,content)
 try:
  subprocess.run(['hyprctl','reload','config-only'],check=True,capture_output=True,text=True)
  errors=subprocess.check_output(['hyprctl','configerrors'],text=True).strip()
  if errors:raise RuntimeError(errors)
 except Exception:
  atomic(MODULE,before);subprocess.run(['hyprctl','reload','config-only'],capture_output=True);raise
 atomic(STATE/'state.json',json.dumps(s,indent=2)+'\n')
 return s
if __name__=='__main__':
 p=argparse.ArgumentParser();p.add_argument('action',choices=['status','preset','apply','validate']);p.add_argument('value',nargs='?');a=p.parse_args()
 STATE.mkdir(parents=True,exist_ok=True)
 try:
  with (STATE/'lock').open('w') as lock:
   fcntl.flock(lock,fcntl.LOCK_EX)
   if a.action=='status':s=state()
   elif a.action=='preset':
    if a.value not in PRESETS:raise ValueError('Unknown preset')
    s=apply(DEFAULT|PRESETS[a.value]|{'preset':a.value})
   else:
    s=validate(DEFAULT|json.loads(a.value));s=s if a.action=='validate' else apply(s|{'preset':'custom'})
   print(json.dumps(s))
 except Exception as e:print(str(e),file=sys.stderr);sys.exit(1)
