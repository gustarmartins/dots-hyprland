def rd(p):
    try:
        with open(p) as f:
            return f.read().strip()
    except Exception:
        return None


def human(n):
    try:
        n = float(n)
    except Exception:
        return str(n)
    neg = n < 0
    n = abs(n)
    for u in ["B", "K", "M", "G", "T"]:
        if n < 1024:
            s = f"{n:.0f}{u}" if u == "B" else f"{n:.1f}{u}"
            return ("-" + s) if neg else s
        n /= 1024
    return f"{n:.1f}P"


def selected(s):
    if not s:
        return "?"
    for tok in s.split():
        if tok.startswith("[") and tok.endswith("]"):
            return tok[1:-1]
    return s.split()[-1] if "#" not in s else s.split()[1]


def load_docs():
    docs = {}
    if not os.path.exists(DOCFILE):
        return docs
    lines = open(DOCFILE, errors="replace").read().splitlines()
    cur, buf, i = None, [], 0
    while i < len(lines):
        line = lines[i]
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if line.strip() and re.fullmatch(r"=+", nxt.strip() or "x") and \
           re.fullmatch(r"[A-Za-z0-9_\-]+", line.strip()):
            if cur:
                docs[cur] = "\n".join(buf).strip()
            cur, buf, i = line.strip(), [], i + 2
            continue
        if cur is not None:
            buf.append(line)
        i += 1
    if cur:
        docs[cur] = "\n".join(buf).strip()
    return docs


def summary(text, width=66):
    if not text:
        return ""
    t = " ".join(text.split())
    if ". " in t:
        t = t.split(". ")[0] + "."
    return t[:width - 1] + "…" if len(t) > width else t


def read_vm():
    d = {}
    for p in sorted(glob.glob(VM + "/*")):
        k = os.path.basename(p)
        if k in ("compact_memory", "drop_caches", "stat_refresh"):
            continue
        v = rd(p)
        if v is not None:
            d[k] = " ".join(v.split())
    return d


_KCONF = None
ZRAM_CAPS = ("CONFIG_ZRAM_MULTI_COMP", "CONFIG_ZRAM_WRITEBACK",
             "CONFIG_ZRAM_TRACK_ENTRY_ACTIME", "CONFIG_ZRAM_MEMORY_TRACKING")


def kconfig():
    global _KCONF
    if _KCONF is not None:
        return _KCONF
    data = None
    try:
        if os.path.exists("/proc/config.gz"):
            import gzip
            data = gzip.open("/proc/config.gz", "rt").read()
        else:
            data = open("/boot/config-" + os.uname().release).read()
    except Exception:
        data = None
    _KCONF = {}
    for k in ZRAM_CAPS:
        if data is None:
            _KCONF[k] = None
        else:
            _KCONF[k] = (k + "=y") in data or (k + "=m") in data
    return _KCONF


def zram_info():
    if not os.path.isdir(Z):
        return None
    z = {}
    z["primary"] = selected(rd(Z + "/comp_algorithm") or "")
    level_state = {}
    for state_line in (rd("/run/vmatlas-tier/levels") or "").splitlines():
        if "=" in state_line:
            key, value = state_line.split("=", 1)
            level_state[key] = value
    rec = rd(Z + "/recomp_algorithm") or ""
    z["recomp_raw"] = " ".join(rec.replace("\x00", " ").split()) if rec else ""
    
    tiers = []
    if rec:
        for line in rec.replace("\x00", "\n").splitlines():
            line = line.strip()
            if line.startswith("#"):
                prio_num = line.split(":")[0]
                sel = selected(line)
                priority = prio_num[1:]
                spec = level_state.get(f"tier{priority}")
                verified = bool(spec and spec.split(":", 1)[0] == sel)
                tiers.append(f"{spec} ({prio_num}, verified)" if verified else
                             f"{sel} ({prio_num}, level unverified)")
    z["recomp_tiers"] = tiers
    z["recomp"] = " → ".join(tiers) if tiers else (selected(rec) if rec and "#" in rec else None)
    z["disksize"] = int(rd(Z + "/disksize") or 0)
    ml = rd(Z + "/mem_limit")
    z["mem_limit"] = int(ml) if ml and ml.isdigit() else 0
    z["backing"] = rd(Z + "/backing_dev")
    mm = (rd(Z + "/mm_stat") or "").split()
    if len(mm) >= 8:
        z["orig"], z["compr"], z["used"] = int(mm[0]), int(mm[1]), int(mm[2])
        if not z["mem_limit"]:
            z["mem_limit"] = int(mm[3])
        z["used_max"] = int(mm[4])
        z["same"] = int(mm[5])
        z["huge"] = int(mm[7])
        z["huge_since"] = int(mm[8]) if len(mm) >= 9 else None
    bd = (rd(Z + "/bd_stat") or "").split()
    z["bd_pages"] = int(bd[0]) if bd else 0
    z["bd_reads"] = int(bd[1]) if len(bd) >= 2 else 0
    z["bd_writes"] = int(bd[2]) if len(bd) >= 3 else 0
    boot_writes = rd("/run/vmatlas-tier/writeback_pages")
    z["wb_boot_writes"] = max(z["bd_writes"], int(boot_writes)) if boot_writes and boot_writes.isdigit() else z["bd_writes"]
    z["wb_enable"] = rd(Z + "/writeback_limit_enable")
    wl = rd(Z + "/writeback_limit")
    z["wb_limit"] = int(wl) if wl and wl.isdigit() else 0
    z["compressed_wb"] = rd(Z + "/compressed_writeback")
    z["wb_batch"] = rd(Z + "/writeback_batch_size")
    z["caps"] = kconfig()
    return z


def profile_state():
    if not os.path.exists(STATE):
        return None
    d = {}
    for ln in open(STATE):
        if "=" in ln:
            k, v = ln.strip().split("=", 1)
            d[k] = v
    return d


def writeback_state(z):
    """Interpret limit=0 as the intentional lock used between guarded passes."""
    written = z.get("wb_boot_writes", z.get("bd_writes", 0))
    if z.get("wb_enable") != "1":
        return "unlimited"
    if written >= WB_BOOT_CAP_PAGES:
        return "cap-reached"
    if z.get("wb_limit", 0) > 0:
        return "pass-active"
    return "guarded"


def profile_catalog():
    """Read the one canonical profile catalog without requiring root."""
    try:
        result = subprocess.run([PROFILE_TOOL, "list", "--json"], text=True,
                                capture_output=True, check=True)
        return json.loads(result.stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        return {"profiles": [], "state": {"detected": None, "configured": None, "drift": []}}


def mode_name(vm=None):
    state = profile_catalog().get("state", {})
    detected = state.get("detected")
    if detected:
        return f"profile {detected}"
    configured = state.get("configured")
    if configured:
        return f"profile {configured} + {len(state.get('drift', []))} drift"
    return "manual sysctl pins"


def pins():
    out = []
    for f in sorted(glob.glob("/etc/sysctl.d/*.conf")):
        try:
            for ln in open(f):
                m = re.match(r"\s*vm\.([\w\-]+)\s*=\s*(.+)", ln)
                if m:
                    out.append((os.path.basename(f), m.group(1), m.group(2).strip()))
        except Exception:
            pass
    return out


def psi_mem():
    t = rd("/proc/pressure/memory") or ""
    m = re.search(r"some avg10=([\d.]+)", t)
    return m.group(1) if m else "?"


def swap_line():
    rows = []
    try:
        for ln in open("/proc/swaps").read().splitlines()[1:]:
            p = ln.split()
            if len(p) >= 5:
                name = os.path.basename(p[0])
                rows.append(f"{name} pri{p[4]} {human(int(p[2]) * 1024)}")
    except Exception:
        pass
    return "  +  ".join(rows) if rows else "(none)"


def ram_plus_on():
    try:
        for ln in open("/proc/swaps").read().splitlines()[1:]:
            if ln.split() and ln.split()[0] == RAM_PLUS:
                return True
    except Exception:
        pass
    return False


def meminfo():
    d = {}
    for ln in open("/proc/meminfo"):
        k, _, v = ln.partition(":")
        d[k] = int(v.split()[0]) * 1024
    return d


def hdr(t):
    print(f"{c.cy}─ {c.B}{t}{c.R}{c.cy} {'─' * max(2, 58 - len(t))}{c.R}")


def status():
    mi = meminfo()
    avail = mi.get("MemAvailable", 0)
    free = mi.get("MemFree", 0)
    hdr("vmatlas · VM & swap snapshot")
    print(f"  {c.B}RAM{c.R}   {human(mi.get('MemTotal',0))} total · {human(free)} free · "
          f"{c.gr}{human(avail)} avail{c.R}   PSI mem some10={psi_mem()}")
    print(f"  {c.B}swap{c.R}  {swap_line()}")

    vm = read_vm()
    rp = f"{c.gr}ON · 4 GiB NVMe swap{c.R}" if ram_plus_on() else f"{c.D}off{c.R}"
    print(f"  {c.B}mode{c.R}  {mode_name(vm)} · RAM Plus {rp}")

    z = zram_info()
    if z:
        print()
        hdr("zram0")
        rec = f" → recomp {z['recomp']} (idle pages)" if z.get("recomp") else ""
        print(f"  {c.B}compress{c.R}  {c.gr}{z['primary']}{c.R}{rec}")
        size = f"{human(z['disksize'])} disksize"
        if z["mem_limit"]:
            size += f" · mem_limit {human(z['mem_limit'])}"
        print(f"  {c.B}size{c.R}      {size}")
        if "orig" in z and z["compr"]:
            ratio = z["orig"] / z["compr"] if z["compr"] else 0
            print(f"  {c.B}stored{c.R}    {human(z['orig'])} → {human(z['compr'])} "
                  f"in RAM  ({c.cy}{ratio:.2f}x{c.R}, uses {human(z['used'])})")
        bk = z.get("backing")
        if bk and bk != "none":
            wb_state = writeback_state(z)
            if wb_state == "cap-reached":
                health = f"{c.yl}4 GiB boot cap reached ({human(z['bd_writes']*4096)} written){c.R}"
            elif wb_state == "pass-active":
                health = f"{c.gr}guarded pass: {human(z['wb_limit']*4096)} left{c.R}"
            elif wb_state == "guarded":
                remaining = max(0, WB_BOOT_CAP_PAGES - z.get("bd_writes", 0))
                health = f"{c.gr}locked between passes · {human(remaining*4096)} boot quota{c.R}"
            else:
                health = f"{c.rd}UNSAFE: write budget unlimited{c.R}"
            extra = ""
            if z.get("compressed_wb") is not None:
                extra = f" · compressed_wb={z.get('compressed_wb')}"
            print(f"  {c.B}writeback{c.R} {bk} · {human(z['bd_pages']*4096)} on backing · {health}{extra}")
            if "loop" in bk:
                print(f"  {c.D}            (loop file on fs — deadlock-prone under pressure){c.R}")

    docs = load_docs()
    tuned = []
    for k, v in vm.items():
        dft = DEFAULTS.get(k)
        if dft is None or v == dft:
            continue
        if k == "dirty_ratio" and vm.get("dirty_bytes", "0") != "0":
            continue
        if k == "dirty_background_ratio" and vm.get("dirty_background_bytes", "0") != "0":
            continue
        tuned.append((k, v, dft))
    if tuned:
        print()
        hdr(f"tuned away from kernel default ({len(tuned)})")
        for k, v, dft in tuned:
            print(f"  {c.yl}{k:<29}{c.R}{c.B}{v:<14}{c.R}{c.D}(default {dft}){c.R}")

    print()
    print(f"{c.D}  vmatlas all | zram | explain <knob> | pins | profiles | guide{c.R}")


def show_all():
    vm = read_vm()
    docs = load_docs()
    hdr(f"all vm.* knobs ({len(vm)})")
    for k in sorted(vm):
        v = vm[k]
        dft = DEFAULTS.get(k)
        mark = " " if dft is None or v == dft else f"{c.yl}•{c.R}"
        print(f" {mark}{c.B}{k:<30}{c.R}{v:<16}{c.D}{summary(docs.get(k,''))}{c.R}")
    print(f"\n{c.D}  {c.yl}•{c.D} = differs from kernel default · vmatlas explain <knob> for full docs{c.R}")


def explain(knob):
    knob = knob.replace("vm.", "")
    vm = read_vm()
    docs = load_docs()
    hdr(f"explain {knob}")
    if knob in vm:
        dft = DEFAULTS.get(knob, "?")
        print(f"  {c.B}current{c.R} {c.gr}{vm[knob]}{c.R}    {c.B}default{c.R} {dft}\n")
    if knob in docs:
        for ln in docs[knob].splitlines():
            print("  " + ln)
    else:
        print(f"  {c.D}(no kernel.org doc for this knob){c.R}")


def show_pins():
    hdr("sysctl.d pins (survive reboot)")
    ps = pins()
    if not ps:
        print("  (none)")
    for f, k, v in ps:
        ext = "" if f == "99-vmscope.conf" else f"  {c.rd}⚠ external — invisible to vmscope{c.R}"
        print(f"  {c.B}vm.{k:<26}{c.R}= {v:<12}{c.D}{f}{c.R}{ext}")
    print(f"\n{c.D}  vmscope owns 99-vmscope.conf (pin/unpin). External pins cause phantom"
          f"\n  'drift' the profile widget can't fix — see: vmatlas guide{c.R}")


def show_profiles():
    data = profile_catalog()
    state = data.get("state", {})
    hdr("canonical VM profiles (/etc/vmatlas/profiles.d)")
    for profile in data.get("profiles", []):
        name = profile["name"]
        marker = f" {c.gr}← live match{c.R}" if name == state.get("detected") else ""
        kind = profile.get("kind", "persistent")
        swap = profile.get("swap", "keep")
        print(f"  {c.B}{name:<28}{c.R}{c.cy}{kind:<11}{c.R} {swap}{marker}")
        knobs = profile.get("vm", {})
        line = " ".join(f"{key}={value}" for key, value in knobs.items())
        ttl = profile.get("mglru_min_ttl_ms")
        if ttl:
            line += f" mglru_ttl={ttl}"
        print(f"  {c.D}    {line}{c.R}")
        print(f"  {c.D}    {profile.get('description', '')}{c.R}")
    if state.get("configured") and state.get("drift"):
        print(f"\n  {c.yl}configured {state['configured']} has {len(state['drift'])} live drifted values; run `vmatlas profile detect` for them.{c.R}")
    print(f"\n{c.D}  apply: vmatlas profile apply <name>"
          f"\n  create: vmatlas profile create <name> --from-live"
          f"\n  inspect: vmatlas profile show <name> | detect{c.R}")

    print()
    hdr("zram boot profiles (/usr/local/bin/zram-profile-stage)")
    for name, (algo, wb, size, limit) in ZRAM_PROFILES.items():
        wb_text = f"{c.cy}raw-writeback{c.R}" if wb == "raw" else "no-writeback"
        print(f"  {c.B}{name:<12}{c.R}{algo:<24} {wb_text}  disksize={size} mem_limit={limit}")
    print(f"\n{c.D}  stage only: sudo zram-profile-stage <name>   (effective next boot)"
          f"\n  no live zram reset, no swapoff; see: vmatlas guide → 'Stage zram boot profile'{c.R}")


def guide():
    if os.path.exists(GUIDE):
        sys.stdout.write(open(GUIDE).read())
    else:
        print("guide not found at", GUIDE)


def helpme():
    print(f"""{c.B}vmatlas{c.R} — Linux VM/zram/swap reader  ({c.D}read-only except explicit `profile apply/create`{c.R})
  {c.cy}vmatlas{c.R}              snapshot: RAM, swap, zram, profile, tuned knobs
  {c.cy}vmatlas all{c.R}          every vm.* knob + one-line kernel doc
  {c.cy}vmatlas zram{c.R}         zram deep-dive only
  {c.cy}vmatlas tiers{c.R}        primary → verified zstd recompression → NVMe chain
  {c.cy}vmatlas explain <k>{c.R}  full kernel.org doc for one knob + current/default
  {c.cy}vmatlas pins{c.R}         what's pinned in /etc/sysctl.d (+ flags externals)
  {c.cy}vmatlas profiles{c.R}     every canonical VM profile and live match
  {c.cy}vmatlas profile ...{c.R}  list/show/detect/create/apply canonical profiles
  {c.cy}vmatlas guide{c.R}        how to change zram / make profiles / safety
  {c.cy}vmatlas json{c.R}         machine-readable dump""")


def as_json():
    import json
    z = zram_info() or {}
    if z and z.get("compr"):
        z["ratio"] = round(z["orig"] / z["compr"], 3)
    print(json.dumps({"vm": read_vm(), "zram": z, "profile": profile_catalog().get("state"),
                      "pins": pins()}, indent=2))


def profile_command(args):
    sub = args[0] if args else "list"
    if sub in {"list", "detect", "show"}:
        command = [PROFILE_TOOL, sub, *args[1:]]
    elif sub == "apply" and len(args) == 2:
        command = ["sudo", "-n", PROFILE_TOOL, "apply", args[1]]
    elif sub == "create" and len(args) == 3 and args[2] == "--from-live":
        command = ["sudo", "-n", PROFILE_TOOL, "create", args[1], "--from-live"]
    else:
        print("usage: vmatlas profile {list|detect|show NAME|apply NAME|create NAME --from-live}", file=sys.stderr)
        return
    result = subprocess.run(command, text=True, capture_output=True)
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)


def zram_view():
    z = zram_info()
    if not z:
        print("no zram0")
        return
    hdr("zram0")
    rec = f" → recomp {z['recomp']} (multi-tier)" if z.get("recomp") else ""
    print(f"  {c.B}primary algo{c.R}   {c.gr}{z['primary']}{c.R}{rec}")
    print(f"  {c.B}disksize{c.R}       {human(z['disksize'])}")
    print(f"  {c.B}mem_limit{c.R}      {human(z['mem_limit']) if z['mem_limit'] else 'none'}")
    if z.get("recomp_raw"):
        print(f"  {c.B}recomp algo{c.R}    {c.D}{z['recomp_raw']}{c.R}")
    if "orig" in z:
        raw_ratio = z["orig"] / z["compr"] if z["compr"] else 0
        phys_ratio = z["orig"] / z["used"] if z["used"] else 0
        overhead = z["used"] - z["compr"] if z["used"] >= z["compr"] else 0
        print(f"  {c.B}stored{c.R}         {human(z['orig'])} orig → {human(z['compr'])} compressed "
              f"({c.cy}{phys_ratio:.2f}x phys{c.R}, {raw_ratio:.2f}x raw)")
        print(f"  {c.B}RAM used{c.R}       {human(z['used'])} (overhead {human(overhead)}) · peak {human(z.get('used_max',0))}")
        print(f"  {c.B}incompr/dedup{c.R}  {human(z.get('huge',0)*4096)} raw in {z.get('huge',0)} huge "
              f"· {human(z.get('same',0)*4096)} in {z.get('same',0)} same-pages")
    bk = z.get("backing")
    print(f"  {c.B}backing_dev{c.R}    {bk}")
    if bk and bk != "none":
        wb_state = writeback_state(z)
        if wb_state == "cap-reached":
            budget = f"4 GiB boot cap reached ({human(z.get('wb_boot_writes',0)*4096)} written)"
        elif wb_state == "pass-active":
            budget = f"guarded pass active, {human(z.get('wb_limit',0)*4096)} left"
        elif wb_state == "guarded":
            remaining = max(0, WB_BOOT_CAP_PAGES - z.get("wb_boot_writes", 0))
            budget = f"locked, {human(remaining*4096)} boot quota remains"
        else:
            budget = "UNSAFE unlimited"
        print(f"  {c.B}writeback{c.R}      {human(z['bd_pages']*4096)} on backing · "
              f"{budget}")
        print(f"  {c.B}wb traffic{c.R}     reads {z.get('bd_reads',0)} · session/boot writes "
              f"{z.get('bd_writes',0)}/{z.get('wb_boot_writes',0)} {c.D}(4K pages){c.R}")
        if z.get("compressed_wb") is not None:
            print(f"  {c.B}compressed_wb{c.R}  {z.get('compressed_wb')} · batch={z.get('wb_batch')}")
        if wb_state == "cap-reached":
            print(f"  {c.yl}  Boot quota complete: new pages remain compressed in RAM;"
                  f" the existing backing pages remain readable.{c.R}")
        elif wb_state == "guarded":
            print(f"  {c.gr}  limit=0 is the intentional lock between 256 MiB guarded passes.{c.R}")
        elif wb_state == "unlimited":
            print(f"  {c.rd}  ⚠ writeback enforcement is disabled; a caller can write without a cap.{c.R}")
    print(f"\n{c.D}  eviction chain + verdicts: vmatlas tiers · change settings: vmatlas guide{c.R}")


def tiers_view():
    z = zram_info()
    if not z:
        print("no zram0")
        return
    caps = z.get("caps", {})

    def cap(flag):
        v = caps.get(flag)
        return f"{c.gr}✓{c.R}" if v else (f"{c.rd}✗{c.R}" if v is False else f"{c.yl}?{c.R}")

    raw_ratio = z["orig"] / z["compr"] if z.get("compr") else 0
    phys_ratio = z["orig"] / z["used"] if z.get("used") else 0
    huge_b = z.get("huge", 0) * 4096
    same_b = z.get("same", 0) * 4096
    bd_b = z.get("bd_pages", 0) * 4096
    armed = bool(z.get("recomp_tiers")) and caps.get("CONFIG_ZRAM_MULTI_COMP")
    wb_on = z.get("backing") and z.get("backing") != "none"
    demote_ran = z.get("bd_writes", 0) > 0
    wb_state = writeback_state(z)

    hdr("zram tiered eviction - five-stage zram/writeback chain")
    print(f"  {c.B}[ Active RAM ]{c.R}")
    print(f"  {c.D}     │  memory pressure / inactive anonymous pages selected for swap{c.R}")
    print(f"  {c.D}     ▼{c.R}")

    # Tier 0 (Primary)
    if z["primary"] == "lz4":
        t0 = f"{c.gr}optimal swap-out latency ✓{c.R}"
        t0_note = "lowest CPU latency on the immediate swap-out path"
    elif z["primary"] == "zstd":
        t0 = f"{c.yl}dense primary{c.R}"
        t0_note = "higher CPU cost during active reclaim"
    else:
        t0 = f"{c.yl}primary = {z['primary']}{c.R}"
        t0_note = "custom primary algorithm"
    print(f"  {c.B}[ Tier 0 · Primary {z['primary']} ]{c.R}   {t0}  {c.D}{t0_note}{c.R}")
    if z.get("compr"):
        print(f"      logical: {c.cy}{human(z['orig'])}{c.R} → compressed: {c.cy}{human(z['compr'])}{c.R} in RAM")
        print(f"      density: {c.cy}{phys_ratio:.2f}x physical{c.R} ({raw_ratio:.2f}x raw) · uses {human(z['used'])} physical RAM")
    print(f"  {c.D}     │  pages prove cold (~30 min idle){c.R}")
    print(f"  {c.D}     ▼{c.R}")

    # Tier 1 (Priority 1)
    p1_armed = any("#1, verified" in t for t in z.get("recomp_tiers", []))
    t1_status = f"{c.gr}level verified ✓{c.R}" if p1_armed else f"{c.rd}level unverified{c.R}"
    print(f"  {c.B}[ Tier 1 · ZSTD Level 3 (Priority 1) ]{c.R}   {t1_status}  {c.D}fast idle recompression (~30m idle){c.R}")
    print(f"      purpose: quickly regain zstd compression density with minimal CPU overhead")
    print(f"  {c.D}     │  pages remain colder (~3 hours idle){c.R}")
    print(f"  {c.D}     ▼{c.R}")

    # Tier 2 (Priority 2)
    p2_armed = any("#2, verified" in t for t in z.get("recomp_tiers", []))
    t2_status = f"{c.gr}level verified ✓{c.R}" if p2_armed else f"{c.rd}level unverified{c.R}"
    print(f"  {c.B}[ Tier 2 · ZSTD Level 9 (Priority 2) ]{c.R}   {t2_status}  {c.D}selective deep compression (~3h idle){c.R}")
    print(f"      purpose: denser compression for sustained cold pages during low CPU load")
    print(f"  {c.D}     │  pages remain ancient (~12 hours idle) and CPU strictly idle{c.R}")
    print(f"  {c.D}     ▼{c.R}")

    # Tier 3 (Priority 3)
    p3_armed = any("#3, verified" in t for t in z.get("recomp_tiers", []))
    t3_status = f"{c.gr}level verified ✓{c.R}" if p3_armed else f"{c.rd}level unverified{c.R}"
    print(f"  {c.B}[ Tier 3 · ZSTD Level 15 (Priority 3) ]{c.R}  {t3_status}  {c.D}archival cold tier (~12h idle){c.R}")
    print(f"      purpose: maximum density archival; background waits for idle CPU, manual runs warn and proceed")
    print(f"  {c.D}     │  resident limit pressure / incompressible pages / cold writeback{c.R}")
    print(f"  {c.D}     ▼{c.R}")

    # Tier 4 (NVMe Writeback)
    if not wb_on:
        print(f"  {c.B}[ Tier 4 · NVMe writeback ]{c.R}   {c.rd}no backing_dev — disabled{c.R}")
    else:
        v = f"{c.gr}active ✓{c.R}" if demote_ran else f"{c.yl}configured, nothing evicted yet{c.R}"
        print(f"  {c.B}[ Tier 4 · NVMe writeback ]{c.R}   {z['backing']}  {v}")
        print(f"      {c.cy}{human(bd_b)}{c.R} on SSD ({z.get('bd_pages',0)} pages) · "
              f"reads {z.get('bd_reads',0)} · writes {z.get('bd_writes',0)}")
        if wb_state == "cap-reached":
            print(f"      {c.yl}4 GiB boot quota reached after {human(z.get('wb_boot_writes',0)*4096)} writes;"
                  f" new pages stay in zram{c.R}")
        elif wb_state == "guarded":
            remaining = max(0, WB_BOOT_CAP_PAGES - z.get("wb_boot_writes", 0))
            print(f"      {c.gr}locked between guarded passes · {human(remaining*4096)} boot quota remains{c.R}")
            print(f"      policy: max 256 MiB/pass, threshold > 70-85% resident limit, wear-capped")
        elif wb_state == "pass-active":
            print(f"      {c.gr}guarded pass active · {human(z.get('wb_limit',0)*4096)} allowance remains{c.R}")
        else:
            print(f"      {c.rd}⚠ writeback enforcement disabled: budget is unlimited{c.R}")
        print(f"      compressed_wb={z.get('compressed_wb')} batch={z.get('wb_batch')}")

    print()
    print(f"  {c.B}kernel features{c.R}  "
          f"MULTI_COMP {cap('CONFIG_ZRAM_MULTI_COMP')}  "
          f"WRITEBACK {cap('CONFIG_ZRAM_WRITEBACK')}  "
          f"ACTIME {cap('CONFIG_ZRAM_TRACK_ENTRY_ACTIME')}  "
          f"MEM_TRACK {cap('CONFIG_ZRAM_MEMORY_TRACKING')}")
    print(f"  {c.D}adaptive management handled by zram-writeback.service / timer.{c.R}")
    print(f"\n{c.D}  verify passes: vmatlas guide · live monitoring: vmscope{c.R}")


def main():
    a = sys.argv[1:] or ["status"]
    cmd = a[0]
    if cmd in ("status", "snapshot"):
        status()
    elif cmd == "all":
        show_all()
    elif cmd == "zram":
        zram_view()
    elif cmd in ("tiers", "tier"):
        tiers_view()
    elif cmd == "explain" and len(a) > 1:
        explain(a[1])
    elif cmd == "pins":
        show_pins()
    elif cmd == "profiles":
        show_profiles()
    elif cmd == "profile":
        profile_command(a[1:])
    elif cmd == "guide":
        guide()
    elif cmd == "json":
        as_json()
    elif cmd in ("help", "-h", "--help"):
        helpme()
    else:
        helpme()


if __name__ == "__main__":
    main()
