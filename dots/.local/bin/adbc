#!/usr/bin/env python3
"""Probe selected Android devices or run a bounded manual operation; no subnet scans."""
import os
from pathlib import Path
import sys

args = sys.argv[1:]
body = []
if "--" in args:
    split = args.index("--")
    args, body = args[:split], args[split + 1:]
tool = str(Path(__file__).resolve().with_name("android-adb-on-demand"))
if not args or args in (["list"], ["-l"], ["status"]):
    os.execv(tool, [tool, "list"])
if args in (["help"], ["--help"], ["-h"]):
    print("adbc DEVICE[,DEVICE] [-- COMMAND ARGS...] | adbc all | adbc --endpoint HOST:PORT\n"
          "No arguments lists saved endpoints without network traffic.\n"
          "Without a command this is a connectivity probe; its private connection is retired.\n"
          "For duration controls use android-adb-on-demand run --max-seconds N.")
    raise SystemExit(0)
forward = [tool, "run" if body else "connect", "--now"]
if args[0] == "--endpoint":
    forward += args
else:
    for value in args:
        for name in value.split(","):
            forward += ["--all"] if name == "all" else ["--device", name]
if body:
    forward += ["--", *body]
os.execv(tool, forward)
