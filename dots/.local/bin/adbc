#!/usr/bin/env python3
"""Connect explicitly selected saved Android devices once; no subnet scans."""
import os
from pathlib import Path
import sys

args = sys.argv[1:]
tool = str(Path(__file__).resolve().with_name("android-adb-on-demand"))
if not args or args in (["list"], ["-l"], ["status"]):
    os.execv(tool, [tool, "list"])
if args in (["help"], ["--help"], ["-h"]):
    print("adbc DEVICE[,DEVICE] | adbc all | adbc --endpoint HOST:PORT\n"
          "No arguments lists saved endpoints without network traffic.\n"
          "Named connections run once; no discovery, retries or server restart.")
    raise SystemExit(0)
forward = [tool, "connect", "--now"]
if args[0] == "--endpoint":
    forward += args
else:
    for value in args:
        for name in value.split(","):
            forward += ["--all"] if name == "all" else ["--device", name]
os.execv(tool, forward)
