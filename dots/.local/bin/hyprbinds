#!/usr/bin/env python3
"""
hyprbinds - Real-time Hyprland keybind search & inspector for Lua and Conf configurations.
"""

import sys
import os
import re
import json
import shutil
import argparse
import subprocess
from collections import Counter
from pathlib import Path

try:
    import readline  # noqa: F401
except ImportError:
    pass

# --- ANSI Color Helpers ---
USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def col(text, code):
    if not USE_COLOR:
        return str(text)
    return f"\033[{code}m{text}\033[0m"

def bold(text): return col(text, "1")
def dim(text): return col(text, "2")
def green(text): return col(text, "32")
def bold_green(text): return col(text, "1;32")
def cyan(text): return col(text, "36")
def bold_cyan(text): return col(text, "1;36")
def yellow(text): return col(text, "33")
def bold_yellow(text): return col(text, "1;33")
def magenta(text): return col(text, "35")
def bold_magenta(text): return col(text, "1;35")
def blue(text): return col(text, "34")
def bold_blue(text): return col(text, "1;34")
def red(text): return col(text, "31")
def bold_red(text): return col(text, "1;31")

MOD_MAP = {
    'super': 'SUPER', 'win': 'SUPER', 'mod4': 'SUPER', 'mod': 'SUPER', 'logo': 'SUPER',
    'ctrl': 'CTRL', 'control': 'CTRL', 'mod3': 'CTRL',
    'alt': 'ALT', 'mod1': 'ALT', 'opt': 'ALT', 'option': 'ALT',
    'shift': 'SHIFT',
}

MOD_ORDER = {'SUPER': 1, 'CTRL': 2, 'ALT': 3, 'SHIFT': 4}

KEY_MAP = {
    '/': 'Slash', 'slash': 'Slash',
    '\\': 'Backslash', 'backslash': 'Backslash',
    '.': 'Period', 'period': 'Period', 'dot': 'Period',
    ',': 'Comma', 'comma': 'Comma',
    ';': 'Semicolon', 'semicolon': 'Semicolon',
    "'": 'Apostrophe', '"': 'Apostrophe', 'apostrophe': 'Apostrophe', 'quote': 'Apostrophe',
    '-': 'Minus', 'minus': 'Minus',
    '=': 'Equal', 'equal': 'Equal', '+': 'Equal', 'plus': 'Equal',
    '[': 'BracketLeft', 'bracketleft': 'BracketLeft',
    ']': 'BracketRight', 'bracketright': 'BracketRight',
    'space': 'Space', 'spacebar': 'Space',
    'tab': 'Tab',
    'return': 'Return', 'enter': 'Return',
    'super_l': 'Super_L', 'super_r': 'Super_R',
    'backspace': 'Backspace',
    'escape': 'Escape', 'esc': 'Escape',
    'delete': 'Delete', 'del': 'Delete',
    'left': 'Left', 'right': 'Right', 'up': 'Up', 'down': 'Down',
    'pageup': 'Page_Up', 'page_up': 'Page_Up', 'pgup': 'Page_Up',
    'pagedown': 'Page_Down', 'page_down': 'Page_Down', 'pgdn': 'Page_Down',
    'print': 'Print', 'prtsc': 'Print', 'printscreen': 'Print',
    'home': 'Home', 'end': 'End', 'insert': 'Insert', 'ins': 'Insert',
    'grave': 'Grave', 'tilde': 'Tilde', 'backtick': 'Grave',
    'caps': 'Caps_Lock', 'capslock': 'Caps_Lock', 'caps_lock': 'Caps_Lock',
    'mouse_up': 'Mouse_up', 'mouse_down': 'Mouse_down',
    'mouse_left': 'Mouse_left', 'mouse_right': 'Mouse_right',
}

PUNCT_MAP = {
    ',': 'Comma', '.': 'Period', '/': 'Slash', '\\': 'Backslash', ';': 'Semicolon',
    "'": 'Apostrophe', '"': 'Apostrophe', '-': 'Minus', '=': 'Equal', '+': 'Equal',
    '[': 'BracketLeft', ']': 'BracketRight', '`': 'Grave', '~': 'Tilde',
}

FUNCTION_KEY_RE = re.compile(r'^f([1-9]|1[0-9]|2[0-4])$', re.IGNORECASE)
KEYPAD_KEY_RE = re.compile(r'^kp_[a-z0-9_]+$', re.IGNORECASE)

def is_known_key_token(token: str, known_keys=None) -> bool:
    if not token:
        return False
    t = token.strip()
    t_low = t.lower()
    if t_low in KEY_MAP or t in PUNCT_MAP:
        return True
    if len(t) == 1 and t.isalnum():
        return True
    if FUNCTION_KEY_RE.match(t_low) or KEYPAD_KEY_RE.match(t_low):
        return True
    if t_low.startswith(('code:', 'mouse:', 'xf86', 'switch:')):
        return True
    if known_keys and normalize_key(t).casefold() in known_keys:
        return True
    return False

def normalize_key(k: str) -> str:
    if not k:
        return ""
    k_strip = k.strip()
    k_low = k_strip.lower()
    if k_low in KEY_MAP:
        return KEY_MAP[k_low]
    if k_strip in PUNCT_MAP:
        return PUNCT_MAP[k_strip]
    if k_low.startswith('code:'):
        return 'code:' + k_strip[5:]
    if k_low.startswith('mouse:'):
        return 'mouse:' + k_strip[6:]
    if k_low.startswith('xf86'):
        return k_strip
    if len(k_strip) == 1 and k_strip.isalpha():
        return k_strip.upper()
    return k_strip.capitalize()

def parse_combo_string(combo_str: str):
    """
    Parses a combo string like 'SUPER + SHIFT + D' or 'Ctrl+Super, Slash' into (mods_set, key_str).
    """
    parts = [p.strip() for p in re.split(r'[\s+]+', combo_str) if p.strip()]
    mods = set()
    key = None
    for p in parts:
        p_low = p.lower()
        if p_low in MOD_MAP:
            mods.add(MOD_MAP[p_low])
        else:
            key = normalize_key(p)
    return mods, key

def format_combo(mods: set, key: str) -> str:
    sorted_mods = sorted(list(mods), key=lambda m: MOD_ORDER.get(m, 99))
    if key:
        return " + ".join(sorted_mods + [key])
    return " + ".join(sorted_mods)

def parse_user_query(q: str, known_keys=None):
    """
    Classifies a user query into one of:
    - ('empty', set(), None, [], raw)
    - ('combo', mods_set, key_str, [], raw)      e.g. 'super + r', 'ctrl+shift+esc', 'super,,'
    - ('key', set(), key_str, [], raw)           e.g. 'r', '"r"', 'space', 'f1', 'print', '/'
    - ('mods', mods_set, None, [], raw)          e.g. 'super', 'super + shift'
    - ('mod_text', mods_set, None, terms, raw)   e.g. 'super terminal', 'super + reload'
    - ('text', set(), None, terms, raw)          e.g. 'terminal', 'task manager', 'left sidebar'
    """
    q = q.strip()
    if len(q) >= 2 and q[0] == q[-1] and q[0] in ('"', "'"):
        q = q[1:-1].strip()
    if not q:
        return 'empty', set(), None, [], q

    # Special handling if entire query is single punctuation
    if q in PUNCT_MAP:
        return 'key', set(), PUNCT_MAP[q], [], q

    cleaned = q
    trailing_key = None
    if q.endswith(',,') or q.endswith('+,') or q.endswith(' ,') or q.endswith('-,') or q.endswith('/,'):
        trailing_key = 'Comma'
        cleaned = q[:-1]
    elif q.endswith('++') or q.endswith(',+') or q.endswith(' +'):
        trailing_key = 'Equal'
        cleaned = q[:-1]
    elif q.endswith('--') or q.endswith(',-') or q.endswith(' -'):
        trailing_key = 'Minus'
        cleaned = q[:-1]

    parts = [p for p in re.split(r'[,+\s]+', cleaned) if p]
    mods = set()
    non_mods = []
    for p in parts:
        p_low = p.lower()
        if p_low in MOD_MAP:
            mods.add(MOD_MAP[p_low])
        else:
            non_mods.append(p)

    if mods and not non_mods and trailing_key is None:
        return 'mods', mods, None, [], q

    if mods:
        if trailing_key is not None and not non_mods:
            return 'combo', mods, trailing_key, [], q
        if trailing_key is None and len(non_mods) == 1 and is_known_key_token(non_mods[0], known_keys):
            return 'combo', mods, normalize_key(non_mods[0]), [], q
        return 'mod_text', mods, None, non_mods, q

    if trailing_key is not None and not non_mods:
        return 'key', set(), trailing_key, [], q
    if trailing_key is None and len(non_mods) == 1 and is_known_key_token(non_mods[0], known_keys):
        return 'key', set(), normalize_key(non_mods[0]), [], q

    text_terms = [t for t in re.split(r'\s+', q) if t]
    return 'text', set(), None, text_terms, q

def tokenize_user_query(q: str, known_keys=None):
    """Backward-compatible wrapper returning (mods_set, key_str_or_None, raw_q)."""
    _, mods, key, _, raw = parse_user_query(q, known_keys=known_keys)
    return mods, key, raw

def get_lua_extractor_script():
    return """
HOME = os.getenv("HOME")
local config = arg[1]
package.path = config .. "/?.lua;" .. config .. "/?/init.lua;" .. package.path

local binds = {}
local unbinds = {}
local current_submap = ""

local function create_proxy(name)
    local t = {}
    setmetatable(t, {
        __index = function(_, k)
            return function(arg)
                local arg_str = ""
                if type(arg) == "table" then
                    local parts = {}
                    for k2, v2 in pairs(arg) do
                        table.insert(parts, tostring(k2) .. "=" .. tostring(v2))
                    end
                    arg_str = "{" .. table.concat(parts, ", ") .. "}"
                elseif arg ~= nil then
                    arg_str = tostring(arg)
                end
                return name .. "." .. k .. "(" .. arg_str .. ")"
            end
        end,
        __call = function(_, arg)
            local arg_str = ""
            if type(arg) == "table" then
                local parts = {}
                for k2, v2 in pairs(arg) do
                    table.insert(parts, tostring(k2) .. "=" .. tostring(v2))
                end
                arg_str = "{" .. table.concat(parts, ", ") .. "}"
            elseif arg ~= nil then
                arg_str = tostring(arg)
            end
            return name .. "(" .. arg_str .. ")"
        end
    })
    return t
end

hl = {
    dsp = setmetatable({}, {
        __index = function(_, k)
            return create_proxy("dsp." .. k)
        end
    }),
    bind = function(key, action, opts)
        local info = debug.getinfo(2, "Sl")
        local is_fn = (type(action) == "function")
        local act_str = is_fn and "<custom lua function>" or tostring(action or "")
        table.insert(binds, {
            key = key,
            action = act_str,
            is_function = is_fn,
            file = info.source:gsub("^@", ""),
            line = info.currentline or 0,
            submap = current_submap,
            options = opts or {}
        })
    end,
    unbind = function(key)
        local info = debug.getinfo(2, "Sl")
        table.insert(unbinds, {
            key = key,
            file = info.source:gsub("^@", ""),
            line = info.currentline or 0
        })
    end,
    define_submap = function(name, fn)
        local prev = current_submap
        current_submap = name
        if type(fn) == "function" then
            pcall(fn)
        end
        current_submap = prev
    end,
    env = function(k, v) end,
    on = function() end,
    window_rule = function() end,
    exec_cmd = function() end,
    get_windows = function() return {} end,
    get_layers = function() return {} end,
    get_config = function() return 1.0 end,
    config = function() end,
    notification = { create = function() end },
    dispatch = function() end,
    get_active_monitor = function() return {} end,
    get_active_window = function() return {} end,
    get_active_workspace = function() return {id=1} end,
    get_active_special_workspace = function() return {} end,
    get_current_submap = function() return current_submap end,
}

function is_file_exists(f)
    local file = io.open(f, "r")
    if file then file:close(); return true end
    return false
end

function workspace_in_group(i) return i end

-- Inspect registration only, without launching commands from configuration.
os.execute = function() return nil end
io.popen = function() return nil end
for i = 2, #arg do
    local ok, err = pcall(dofile, arg[i])
    if not ok then io.stderr:write(tostring(err), "\\n") end
end

-- JSON Output
local function escape_json(s)
    if not s then return "" end
    s = s:gsub('\\\\', '\\\\\\\\'):gsub('"', '\\\\"'):gsub('\\n', '\\\\n'):gsub('\\r', '\\\\r'):gsub('\\t', '\\\\t')
    return s
end

local json_binds = {}
for _, b in ipairs(binds) do
    local opt_desc = (b.options and b.options.description) or ""
    local opt_locked = (b.options and b.options.locked) and true or false
    local opt_repeat = (b.options and b.options.repeating) and true or false
    local opt_non_consuming = (b.options and b.options.non_consuming) and true or false
    table.insert(json_binds, string.format('{"key":"%s","action":"%s","is_function":%s,"file":"%s","line":%d,"submap":"%s","description":"%s","locked":%s,"repeating":%s,"non_consuming":%s}',
        escape_json(b.key), escape_json(b.action), tostring(b.is_function), escape_json(b.file), b.line, escape_json(b.submap), escape_json(opt_desc), tostring(opt_locked), tostring(opt_repeat), tostring(opt_non_consuming)))
end

local json_unbinds = {}
for _, u in ipairs(unbinds) do
    table.insert(json_unbinds, string.format('{"key":"%s","file":"%s","line":%d}', escape_json(u.key), escape_json(u.file), u.line))
end

print("{" .. '"binds":[' .. table.concat(json_binds, ",") .. '],' .. '"unbinds":[' .. table.concat(json_unbinds, ",") .. ']}')
"""

def _strip_lua_strings_and_comments(line: str) -> str:
    out = []
    i = 0
    n = len(line)
    quote = None
    while i < n:
        ch = line[i]
        if quote:
            if ch == '\\' and i + 1 < n:
                i += 2
                continue
            if ch == quote:
                quote = None
        else:
            if ch == '-' and i + 1 < n and line[i + 1] == '-':
                break
            if ch in ('"', "'"):
                quote = ch
            else:
                out.append(ch)
        i += 1
    return ''.join(out)

def extract_function_body(filepath: str, start_line: int, max_lines: int = 15) -> str:
    """Extracts the Lua hl.bind(...) call/function snippet without leaking into following statements."""
    try:
        with open(filepath, 'r', encoding='utf-8', errors='ignore') as f:
            lines = f.readlines()
        if start_line < 1 or start_line > len(lines):
            return ""
        snippet_lines = []
        parens = 0
        seen_paren = False
        for idx in range(start_line - 1, min(start_line - 1 + max_lines, len(lines))):
            line = lines[idx]
            snippet_lines.append(line.rstrip())
            code = _strip_lua_strings_and_comments(line)
            if '(' in code:
                seen_paren = True
            parens += code.count('(') - code.count(')')
            if seen_paren and parens <= 0:
                break
        return "\n".join(snippet_lines)
    except Exception:
        return ""

def load_lua_binds(hypr_dir):
    """Runs Lua evaluator to extract all binds dynamically defined in Lua configs."""
    root = Path(hypr_dir)
    primary = [root / scope / name for name in ('variables.lua', 'keybinds.lua')
               for scope in ('hyprland', 'custom')]
    extras = sorted(p for p in root.rglob('*keybinds.lua') if p not in primary and '.conf-old' not in p.parts)
    files = [p for p in primary + extras if p.is_file()]
    if not files:
        return [], []
    try:
        res = subprocess.run(['lua', '-', str(root), *map(str, files)], input=get_lua_extractor_script(),
                             capture_output=True, text=True, timeout=5)
        if res.stderr.strip():
            print(f'hyprbinds: Lua source: {res.stderr.strip()}', file=sys.stderr)
        if res.returncode == 0 and res.stdout.strip():
            for line in res.stdout.splitlines():
                if line.startswith('{"binds":'):
                    data = json.loads(line)
                    return data.get("binds", []), data.get("unbinds", [])
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(f'hyprbinds: could not read Lua bindings: {error}', file=sys.stderr)
    return [], []

def scan_conf_binds(hypr_dir: str):
    """Scans .conf files for any bind/unbind directives."""
    conf_binds = []
    conf_unbinds = []
    bind_pattern = re.compile(r'^\s*(bind[elmd]?|unbind)\s*=\s*(.*?)(?:#(.*))?$', re.IGNORECASE)
    
    for conf_file in Path(hypr_dir).rglob("*.conf"):
        if ".conf-old" in conf_file.parts:
            continue
        try:
            with open(conf_file, 'r', encoding='utf-8', errors='ignore') as f:
                for line_num, line in enumerate(f, start=1):
                    line_clean = line.strip()
                    if not line_clean or line_clean.startswith('#'):
                        continue
                    m = bind_pattern.match(line)
                    if m:
                        directive = m.group(1).lower()
                        rest = m.group(2).strip()
                        comment = (m.group(3) or "").strip()
                        
                        parts = [p.strip() for p in rest.split(',')]
                        if len(parts) >= 2:
                            mods_raw = parts[0]
                            key_raw = parts[1]
                            combo = f"{mods_raw} + {key_raw}" if mods_raw else key_raw
                            action = ", ".join(parts[2:]) if len(parts) > 2 else ""
                            
                            if directive == 'unbind':
                                conf_unbinds.append({
                                    "key": combo,
                                    "file": str(conf_file),
                                    "line": line_num,
                                })
                            else:
                                conf_binds.append({
                                    "key": combo,
                                    "action": action,
                                    "is_function": False,
                                    "file": str(conf_file),
                                    "line": line_num,
                                    "submap": "",
                                    "description": comment,
                                    "locked": 'l' in directive,
                                    "repeating": 'e' in directive,
                                    "non_consuming": False,
                                    "directive": directive
                                })
        except Exception:
            continue
            
    return conf_binds, conf_unbinds

class KeybindEntry:
    def __init__(self, raw_data, source_type="lua"):
        self.raw_key = raw_data.get("key", "")
        self.action = raw_data.get("action", "")
        self.is_function = raw_data.get("is_function", False)
        self.file = raw_data.get("file", "")
        self.line = raw_data.get("line", 0)
        self.submap = raw_data.get("submap", "")
        self.description = raw_data.get("description", "")
        self.locked = raw_data.get("locked", False)
        self.repeating = raw_data.get("repeating", False)
        self.non_consuming = raw_data.get("non_consuming", False)
        self.source_type = source_type
        self.is_override = False
        self.is_unbound = False
        self.is_custom = "custom" in self.file.lower()
        self.function_code = ""

        self.mods, self.key = parse_combo_string(self.raw_key)
        self.combo_formatted = format_combo(self.mods, self.key)

        # Prettify file path
        home = os.path.expanduser("~")
        if self.file.startswith(home):
            self.display_file = "~" + self.file[len(home):]
        else:
            self.display_file = self.file

        # Clean up description
        if self.description:
            self.description = re.sub(r'^\s*\[hidden\]\s*', '', self.description).strip()

def collect_all_binds(include_conf=True):
    hypr_dir = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "hypr"
    lua_binds_raw, lua_unbinds_raw = load_lua_binds(hypr_dir)
    conf_binds_raw, conf_unbinds_raw = scan_conf_binds(hypr_dir) if include_conf else ([], [])

    all_entries = []
    
    # Process unbinds
    unbound_combos = set()
    for u in lua_unbinds_raw + conf_unbinds_raw:
        umods, ukey = parse_combo_string(u.get("key", ""))
        unbound_combos.add((frozenset(umods), ukey))

    # Process lua entries
    seen_combos = {}
    for b in lua_binds_raw:
        entry = KeybindEntry(b, source_type="lua")
        combo_key = (frozenset(entry.mods), entry.key, entry.submap)
        
        # Check if overridden
        if combo_key in seen_combos:
            seen_combos[combo_key].is_override = True
        
        if combo_key[:2] in unbound_combos and not entry.is_custom:
            entry.is_unbound = True
            
        if entry.is_function and entry.file:
            entry.function_code = extract_function_body(entry.file, entry.line)
            
        seen_combos[combo_key] = entry
        all_entries.append(entry)

    # Process conf entries
    if include_conf:
        for b in conf_binds_raw:
            entry = KeybindEntry(b, source_type="conf")
            combo_key = (frozenset(entry.mods), entry.key, entry.submap)
            if combo_key[:2] in unbound_combos and not entry.is_custom:
                entry.is_unbound = True
            all_entries.append(entry)

    if include_conf:
        add_live_bindings(all_entries)
    return all_entries


def add_live_bindings(entries):
    """Supplement source locations with binds registered by plugins and other config files."""
    try:
        result = subprocess.run(['hyprctl', '-j', 'binds'], capture_output=True, text=True, timeout=2)
        if result.returncode:
            return
        live = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return
    if not isinstance(live, list):
        return

    def signature(entry):
        key = (entry.key or '').casefold()
        # Hyprland includes the key's own modifier bit when exporting Super_L/R.
        mods = entry.mods - {'SUPER'} if key in ('super_l', 'super_r') else entry.mods
        return frozenset(mods), key, entry.submap, entry.description

    configured = Counter(signature(e) for e in entries if not e.is_unbound)
    modifiers = {1: 'SHIFT', 2: 'CAPS', 4: 'CTRL', 8: 'ALT', 16: 'MOD2', 32: 'MOD3', 64: 'SUPER', 128: 'MOD5'}
    for row in live:
        key = row.get('key') or ('code:' + str(row['keycode']) if row.get('keycode') else '')
        if not key:
            continue
        action = row.get('dispatcher', '')
        arg = row.get('arg', '')
        if arg and not (arg.isdigit() and (action.startswith('HL.Dispatcher(') or action.startswith('function:'))):
            action += ' ' + arg
        item = KeybindEntry({'key': key, 'description': row.get('description', ''), 'action': action,
                             'submap': row.get('submap', ''), 'locked': row.get('locked', False),
                             'repeating': row.get('repeat', False)}, source_type='live')
        item.mods = {mod for bit, mod in modifiers.items() if row.get('modmask', 0) & bit}
        item.key = normalize_key(key)
        item.combo_formatted = format_combo(item.mods, item.key)
        sig = signature(item)
        if configured[sig]:
            configured[sig] -= 1
        else:
            entries.append(item)

def _decamel(text: str) -> str:
    return re.sub(r'([a-z0-9])([A-Z])', r'\1 \2', text)

def _word_tokens(text: str):
    return re.findall(r'[a-z0-9]+', _decamel(text).casefold())

def _contains_token_sequence(tokens, seq) -> bool:
    if not seq or len(seq) > len(tokens):
        return False
    end = len(tokens) - len(seq) + 1
    for i in range(end):
        if tokens[i:i + len(seq)] == seq:
            return True
    return False

def _field_match_level(raw_field: str, words, phrase: str):
    """
    Returns match quality tier (0 best .. 3 loosest) or None if no match:
      0: exact phrase token sequence (or single-word exact token)
      1: all query words match full tokens
      2: all query words match token prefixes
      3: substring match (for words >= 3 chars; shorter words still require token prefix)
    """
    if not raw_field or not words:
        return None
    field_low = raw_field.casefold()
    tokens = _word_tokens(raw_field)
    phrase_tokens = _word_tokens(phrase)

    if phrase_tokens and _contains_token_sequence(tokens, phrase_tokens):
        return 0

    word_toks_list = [_word_tokens(w) for w in words]

    if all((all(wt in tokens for wt in wt_list) if wt_list else w in field_low)
           for w, wt_list in zip(words, word_toks_list)):
        return 1

    if all((all(any(t.startswith(wt) for t in tokens) for wt in wt_list) if wt_list else w in field_low)
           for w, wt_list in zip(words, word_toks_list)):
        return 2

    def _loose_match(w, wt_list):
        if len(w) >= 3:
            return w in field_low
        if wt_list:
            return all(any(t.startswith(wt) for t in tokens) for wt in wt_list)
        return w in field_low

    if all(_loose_match(w, wt_list) for w, wt_list in zip(words, word_toks_list)):
        return 3

    return None

def _score_text_match(e: KeybindEntry, words, phrase: str):
    """
    Ranks text matches by field relevance and match tightness.
    Never matches generic directory paths like '~/.config/hypr/.../keybinds.lua'
    unless the user explicitly searches a path/filename.
    """
    if not words:
        return None

    desc_level = _field_match_level(e.description, words, phrase)
    if desc_level is not None:
        return (0, desc_level)

    action_text = "" if e.is_function else e.action
    act_levels = [lvl for lvl in (
        _field_match_level(action_text, words, phrase),
        _field_match_level(e.submap, words, phrase),
    ) if lvl is not None]
    if words == ['custom'] and e.is_custom:
        act_levels.append(0)
    if act_levels:
        return (1, min(act_levels))

    combo_level = _field_match_level(e.combo_formatted, words, phrase)
    if combo_level is not None and (combo_level <= 2 or all(len(w) >= 3 for w in words)):
        return (2, combo_level)

    combined = " ".join(p for p in (e.description, action_text, e.submap, e.combo_formatted) if p)
    comb_level = _field_match_level(combined, words, phrase)
    if comb_level is not None:
        return (3, comb_level)

    code_level = _field_match_level(e.function_code, words, phrase)
    if code_level is not None:
        return (4, code_level)

    if any('/' in w or w.endswith(('.lua', '.conf')) for w in words):
        path_low = e.display_file.casefold()
        if all(w in path_low for w in words):
            return (5, 0)

    return None

def _mod_sort_key(mods: set):
    return tuple(sorted(MOD_ORDER.get(m, 99) for m in mods))

def _key_sort_key(key: str):
    k = key or ""
    if len(k) == 1 and k.isalpha():
        return (0, 0, k.casefold())
    if len(k) == 1 and k.isdigit():
        return (1, int(k), k)
    m = FUNCTION_KEY_RE.match(k)
    if m:
        return (2, int(m.group(1)), k.casefold())
    if k.lower().startswith('code:'):
        num = int(k[5:]) if k[5:].isdigit() else 9999
        return (4, num, k.casefold())
    if k.lower().startswith('mouse'):
        return (5, 0, k.casefold())
    return (3, 0, k.casefold())

def search_binds(entries, query: str):
    known_keys = {e.key.casefold() for e in entries if e.key}
    mode, mods_q, key_q, text_terms, _ = parse_user_query(query, known_keys=known_keys)

    exact_matches = []
    superset_matches = []
    key_matches = []
    scored_text = []

    if mode == 'combo':
        key_q_cf = key_q.casefold()
        for e in entries:
            if e.key and e.key.casefold() == key_q_cf:
                if mods_q == e.mods:
                    exact_matches.append(e)
                elif mods_q.issubset(e.mods):
                    superset_matches.append(e)
                else:
                    key_matches.append(e)
    elif mode == 'key':
        key_q_cf = key_q.casefold()
        for e in entries:
            if e.key and e.key.casefold() == key_q_cf:
                if not e.mods:
                    exact_matches.append(e)
                else:
                    key_matches.append(e)
    elif mode == 'mods':
        for e in entries:
            if mods_q == e.mods:
                exact_matches.append(e)
            elif mods_q.issubset(e.mods):
                superset_matches.append(e)
    elif mode in ('text', 'mod_text'):
        words = [w.casefold() for w in text_terms]
        phrase = " ".join(words)
        for e in entries:
            if mode == 'mod_text' and not mods_q.issubset(e.mods):
                continue
            score = _score_text_match(e, words, phrase)
            if score is not None:
                scored_text.append((score, e))

    def combo_sort_key(e: KeybindEntry):
        src_rank = 0 if e.source_type == "lua" else (1 if e.source_type == "conf" else 2)
        return (
            1 if e.is_unbound else 0,
            1 if e.submap else 0,
            len(e.mods),
            _mod_sort_key(e.mods),
            0 if e.is_custom else 1,
            _key_sort_key(e.key or ""),
            src_rank,
            e.display_file,
            e.line,
        )

    def text_sort_key(item):
        score, e = item
        src_rank = 0 if e.source_type == "lua" else (1 if e.source_type == "conf" else 2)
        return (
            1 if e.is_unbound else 0,
            score[0],
            score[1],
            1 if e.submap else 0,
            len(e.mods),
            _mod_sort_key(e.mods),
            0 if e.is_custom else 1,
            _key_sort_key(e.key or ""),
            src_rank,
            e.display_file,
            e.line,
        )

    exact_matches.sort(key=combo_sort_key)
    superset_matches.sort(key=combo_sort_key)
    key_matches.sort(key=combo_sort_key)
    scored_text.sort(key=text_sort_key)
    text_matches = [e for _, e in scored_text]

    return exact_matches, superset_matches, key_matches, text_matches, (mods_q, key_q)

def render_entry(e: KeybindEntry, highlight_exact=False):
    status_tags = []
    if e.is_custom:
        status_tags.append(bold_green("[CUSTOM]"))
    if e.is_unbound:
        status_tags.append(red("[UNBOUND/OVERRIDDEN]"))
    elif e.is_override:
        status_tags.append(yellow("[OVERRIDDEN]"))
    if e.submap:
        status_tags.append(magenta(f"[Submap: {e.submap}]"))
    if e.locked:
        status_tags.append(dim("[locked]"))
    if e.repeating:
        status_tags.append(dim("[repeating]"))

    tag_str = (" " + " ".join(status_tags)) if status_tags else ""
    
    combo_disp = bold_green(e.combo_formatted) if highlight_exact else bold_cyan(e.combo_formatted)
    loc_disp = dim(f"{e.display_file}:{e.line}" if e.file else "Hyprland (live)")
    
    print(f"  • {combo_disp}{tag_str}  {loc_disp}")
    
    if e.description:
        print(f"    {bold('Description:')} {e.description}")
    
    if e.is_function:
        print(f"    {bold('Action:')}      {cyan('[Custom Lua Function]')}")
        if e.function_code:
            code_lines = e.function_code.strip().split('\n')
            preview = code_lines[:6]
            print(dim("    ┌─ (Function Preview)"))
            for cl in preview:
                print(dim(f"    │  {cl}"))
            if len(code_lines) > 6:
                print(dim("    │  ..."))
            print(dim("    └─"))
    elif e.action:
        act = e.action
        if act.startswith("dsp.exec_cmd("):
            cmd = act[13:-1]
            print(f"    {bold('Command:')}     {cyan(cmd)}")
        elif act.startswith("dsp.global("):
            target = act[11:-1]
            print(f"    {bold('Quickshell:')}  {bold_magenta(target)}")
        elif act.startswith("dsp."):
            print(f"    {bold('Action:')}      {cyan(act)}")
        else:
            print(f"    {bold('Action:')}      {cyan(act)}")
    print()

def display_results(query: str, exact, superset, key_m, text_m, parsed_tuple):
    mods_q, key_q = parsed_tuple
    is_key_or_combo = bool(mods_q or key_q)
    norm_query_str = format_combo(mods_q, key_q) if is_key_or_combo else query
    show_norm = is_key_or_combo and not (mods_q and not key_q and text_m) and norm_query_str != query

    print()
    print(bold("🔍 Search results for: ") + bold_yellow(f"'{query}'") + (dim(f" (normalized: {norm_query_str})") if show_norm else ""))
    print(dim("─" * 65))

    if not (exact or superset or key_m or text_m):
        print(bold_red(f"  ✖ No keybinds found matching '{query}'"))
        if mods_q and key_q:
            print(dim(f"    • Combo: {norm_query_str} is currently unassigned in ~/.config/hypr"))
        elif key_q:
            print(dim(f"    • Key: {key_q} is currently unassigned in ~/.config/hypr"))
        elif mods_q:
            print(dim(f"    • Modifier: {norm_query_str} has no matching bindings in ~/.config/hypr"))
        print()
        return

    if mods_q and key_q and not exact:
        print(yellow(f"  ℹ {norm_query_str} is currently unassigned."))
        print()

    if exact:
        print(bold_green(f"  ✔ EXACT MATCH ({len(exact)}):"))
        for e in exact:
            render_entry(e, highlight_exact=True)

    if superset:
        print(bold_cyan(f"  ✦ COMBINATIONS CONTAINING {norm_query_str} ({len(superset)}):"))
        for e in superset:
            render_entry(e, highlight_exact=False)

    show_key_m = bool(key_m) and ((not mods_q and bool(key_q)) or not exact)
    if show_key_m:
        if exact or superset:
            header = f"  ◆ OTHER KEYBINDS ON KEY [{key_q}] ({len(key_m)}):"
        else:
            header = f"  ◆ ALL KEYBINDS ON KEY [{key_q}] ({len(key_m)}):"
        print(bold_yellow(header))
        for e in key_m:
            render_entry(e, highlight_exact=False)

    if text_m:
        if mods_q:
            header = f"  ✦ {format_combo(mods_q, '')} MATCHES BY DESCRIPTION / ACTION ({len(text_m)}):"
        else:
            header = f"  ✦ MATCHES BY DESCRIPTION / ACTION ({len(text_m)}):"
        print(bold_cyan(header))
        for e in text_m:
            render_entry(e, highlight_exact=False)

def run_interactive(entries):
    print(bold_cyan("Hyprland Keybind Inspector (Interactive Mode)"))
    print(dim("Type a key combo (e.g. 'super,shift,d', 'super,a', 'a', 'terminal') or 'exit'/'q' to quit.\n"))
    while True:
        try:
            q = input(bold("hyprbinds > ")).strip()
            if not q:
                continue
            if q.lower() in ('q', 'quit', 'exit'):
                break
            exact, superset, key_m, text_m, parsed = search_binds(entries, q)
            display_results(q, exact, superset, key_m, text_m, parsed)
        except (KeyboardInterrupt, EOFError):
            print("\nExiting.")
            break

def main():
    parser = argparse.ArgumentParser(
        description="Real-time Hyprland Keybind Search & Inspector across ~/.config/hypr",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  hyprbinds super,shift,d       Search for Super+Shift+D
  hyprbinds super,a             Search for Super+A
  hyprbinds a                   Search all bindings using key 'A'
  hyprbinds "ctrl + alt + del"  Search multi-modifier combos
  hyprbinds super,,             Search Super + Comma
  hyprbinds terminal            Search binds by description or action
  hyprbinds --lua-only          Only search Lua keybinds (keybinds.lua)
  hyprbinds --all               List all registered keybinds
  hyprbinds                     Start interactive search mode
"""
    )
    parser.add_argument("query", nargs="*", help="Key combination or search term (e.g. 'super,shift,d', 'a', 'super,a')")
    parser.add_argument("-a", "--all", action="store_true", help="List all configured keybindings")
    parser.add_argument("-L", "--lua-only", action="store_true", help="Only inspect Lua config files (keybinds.lua)")
    parser.add_argument("-j", "--json", action="store_true", help="Output results in JSON format")
    parser.add_argument("-i", "--interactive", action="store_true", help="Start interactive search mode")
    parser.add_argument("--no-color", action="store_true", help="Disable colored output")

    args = parser.parse_args()

    global USE_COLOR
    if args.no_color:
        USE_COLOR = False

    include_conf = not args.lua_only
    entries = collect_all_binds(include_conf=include_conf)

    if args.all:
        if args.json:
            print(json.dumps([{
                "combo": e.combo_formatted,
                "mods": list(e.mods),
                "key": e.key,
                "description": e.description,
                "action": e.action,
                "file": e.file,
                "line": e.line,
                "submap": e.submap,
                "unbound": e.is_unbound,
                "override": e.is_override,
                "custom": e.is_custom
            } for e in entries], indent=2))
        else:
            print(bold_cyan(f"All Configured Hyprland Keybinds ({len(entries)} total):"))
            print(dim("─" * 65))
            for e in entries:
                render_entry(e)
        return

    if not args.query or args.interactive:
        run_interactive(entries)
        return

    query_str = " ".join(args.query)
    exact, superset, key_m, text_m, parsed = search_binds(entries, query_str)

    if args.json:
        mods_q, key_q = parsed
        if mods_q and key_q and exact:
            results = exact + superset
        else:
            results = exact + superset + key_m + text_m
        print(json.dumps([{
            "combo": e.combo_formatted,
            "mods": list(e.mods),
            "key": e.key,
            "description": e.description,
            "action": e.action,
            "file": e.file,
            "line": e.line,
            "submap": e.submap,
            "unbound": e.is_unbound,
            "override": e.is_override,
            "custom": e.is_custom
        } for e in results], indent=2))
    else:
        display_results(query_str, exact, superset, key_m, text_m, parsed)

if __name__ == "__main__":
    main()
