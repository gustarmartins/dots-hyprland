#!/usr/bin/env python3
"""Saved Android endpoints and explicit one-shot connections; no discovery loop."""
import argparse
import ipaddress
import json
import os
from pathlib import Path
import re
import subprocess
import sys

DEVICES = {
    "fe": ("SM-S711B", {"fe", "s23fe", "r11s"}),
    "ultra": ("SM-S918B", {"ultra", "s23", "s23u", "s23ultra", "dm3q"}),
    "munch": ("22021211RG", {"munch", "poco", "pocof4", "f4"}),
}


def valid_endpoint(value):
    if value.startswith("["):
        match = re.fullmatch(r"\[([0-9a-fA-F:]+)\]:([0-9]{1,5})", value)
        if not match:
            return False
        try:
            ipaddress.IPv6Address(match[1])
        except ValueError:
            return False
    else:
        match = re.fullmatch(r"([A-Za-z0-9][A-Za-z0-9_.-]*):([0-9]{1,5})", value)
        if not match:
            return False
    return 1 <= int(match[2]) <= 65535


def saved_endpoints():
    config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    known = Path(os.environ.get("ADB_KNOWN_ENDPOINTS_FILE", config / "adb-wifi-connect/endpoints"))
    records = []
    if known.is_file():
        for line in known.read_text().splitlines():
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            values = line.split("|")
            if len(values) >= 2 and valid_endpoint(values[0]):
                key = next((key for key, (model, _) in DEVICES.items() if model == values[1]), values[1])
                records.append({"endpoint": values[0], "device": key, "model": values[1]})
    return records


def aliases():
    return {alias: key for key, (_, values) in DEVICES.items() for alias in values}


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv and argv[0] in {"ls", "scan", "c", "w"}:
        argv[0] = {"ls": "list", "scan": "list", "c": "connect", "w": "watch"}[argv[0]]
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", nargs="?", default="status", choices=("status", "list", "connect", "watch"))
    parser.add_argument("--now", action="store_true", help="Perform this explicit connection request now, once")
    parser.add_argument("--endpoint", action="append", default=[])
    parser.add_argument("--device", action="append", default=[])
    parser.add_argument("--all", action="store_true", help="Explicitly select all saved endpoints")
    parser.add_argument("--timeout", type=float, default=5.0)
    args = parser.parse_args(argv)
    if args.command == "watch":
        parser.error("Unattended ADB watching is disabled. Use connect --now for a current request.")
    if not 0 < args.timeout <= 30:
        parser.error("timeout must be greater than zero and at most 30 seconds")
    if any(not valid_endpoint(value) for value in args.endpoint):
        parser.error("Use an explicit hostname:port, IPv4:port or [IPv6]:port endpoint")
    records = saved_endpoints()
    if args.command in ("status", "list"):
        print(json.dumps({"policy": "on-demand", "network_requests": 0, "saved_endpoints": records}, indent=2))
        return 0
    if not args.now:
        parser.error("connect requires --now; no connection or device query has been made")
    names = aliases()
    wanted = set()
    for value in args.device:
        if value.lower() not in names:
            parser.error(f"Unknown device alias: {value}; use --endpoint for a specific address")
        wanted.add(names[value.lower()])
    selected = list(args.endpoint)
    selected.extend(row["endpoint"] for row in records if args.all or row["device"] in wanted)
    selected = list(dict.fromkeys(selected))
    if not selected:
        parser.error("Select a saved --device, --endpoint, or --all; automatic network scans are disabled")
    adb = os.environ.get("ANDROID_ADB_BINARY", "adb")
    failed = False
    for endpoint in selected:
        try:
            result = subprocess.run([adb, "connect", endpoint], capture_output=True, text=True, timeout=args.timeout,
                                    env={**os.environ, "ADB_MDNS_AUTO_CONNECT": "0"})
            message = result.stdout.strip()
            accepted = result.returncode == 0 and message in (f"connected to {endpoint}", f"already connected to {endpoint}")
            print(json.dumps({"endpoint": endpoint, "transport_connected": accepted, "returncode": result.returncode,
                              "message": message, "stderr": result.stderr.strip(), "device_identity_verified": False}))
            failed |= not accepted
        except subprocess.TimeoutExpired:
            print(json.dumps({"endpoint": endpoint, "transport_connected": False, "timeout": True}))
            failed = True
        except OSError as error:
            print(str(error), file=sys.stderr)
            return 1
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
