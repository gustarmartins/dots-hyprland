import QtQuick
import Quickshell
import qs
import qs.services
import qs.modules.common
import qs.modules.common.functions
import qs.modules.common.widgets

QuickToggleModel {
    name: Translation.tr("Audio input")
    available: !!(Audio.source?.ready && Audio.source?.audio)
    statusText: !available ? Translation.tr("Unavailable") : toggled ? Translation.tr("Enabled") : Translation.tr("Muted")
    toggled: available && !Audio.source?.audio?.muted
    icon: Audio.source?.audio?.muted ? "mic_off" : "mic"
    mainAction: () => {
        Audio.toggleMicMute()
    }
    hasMenu: true

    tooltipText: Translation.tr("Audio input | Right-click for volume mixer & device selector")
}
