 #include <qobject.h>
+#include <qpointer.h>
 #include <qqmllist.h>
 #include <qtmetamacros.h>
 #include <qtypes.h>
@@ -356,12 +357,14 @@ PwNodeIface* PwNodeIface::instance(PwNode* node) {
